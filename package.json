{
  "name": "o-nioaquense",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de noticias hiperlocal de Nioaque (MS) - O Nioaquense",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "astro": "astro",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "seed:generate": "node scripts/generate-seed.mjs",
    "placeholders": "node scripts/generate-placeholders.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^4.4.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "astro": "^5.18.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true,
    "sharp@0.34.5": true,
    "workerd@1.20260114.0": true,
    "workerd@1.20261019.1": true
  }
}
