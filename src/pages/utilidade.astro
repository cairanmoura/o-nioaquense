---
import MainLayout from '../layouts/MainLayout.astro';
import AutoridadesLista from '../components/AutoridadesLista.astro';
---

<MainLayout title="Guia de Utilidade Pública" description="Autoridades, secretarias, Judiciário, Ministério Público e serviços de saúde de Nioaque (MS), com contato e endereço.">
  <div class="mx-auto w-full max-w-4xl px-4 pb-16 sm:px-6">
    <header class="mt-8 mb-6 border-b-2 border-nioaque-green pb-6">
      <h1 class="font-editorial text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">Guia de Utilidade Pública</h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-soft">Autoridades, secretarias, Justiça, Ministério Público e serviços de saúde de Nioaque (MS): quem procurar, onde fica e como falar.</p>
    </header>
    <section class="mb-8 flex flex-col gap-3 rounded-[4px] border border-pedra bg-branco p-4 sm:flex-row sm:items-center sm:justify-between" aria-label="Sessões da Câmara">
      <div>
        <h2 class="font-editorial text-lg font-extrabold text-ink">Sessões da Câmara Municipal</h2>
        <p class="mt-0.5 text-sm text-ink-soft">Toda terça, às 19h, ao vivo no canal oficial. Reveja qualquer sessão e baixe a ata em PDF.</p>
      </div>
      <a href="/camara/sessoes" class="inline-flex min-h-[44px] shrink-0 items-center justify-center rounded-[4px] bg-nioaque-green px-5 text-sm font-bold text-white hover:bg-nioaque-green-dark">Assistir às sessões</a>
    </section>
    <AutoridadesLista />
  </div>
</MainLayout>
