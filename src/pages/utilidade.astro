---
import MainLayout from '../layouts/MainLayout.astro';
import AutoridadesLista from '../components/AutoridadesLista.astro';
---

<MainLayout title="Guia de Utilidade Pública" description="Autoridades, secretarias, Judiciário, Ministério Público e serviços de saúde de Nioaque (MS), com contato e endereço.">
  <div class="mx-auto w-full max-w-4xl px-4 pb-16 sm:px-6">
    <header class="mt-8 mb-6 border-b-2 border-nioaque-green pb-6">
      <h1 class="font-editorial text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">Guia de Utilidade Pública</h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-soft">Autoridades, secretarias, Justiça, Ministério Público e serviços de saúde de Nioaque (MS): quem procurar, onde fica e como falar.</p>
    </header>
    <AutoridadesLista />
  </div>
</MainLayout>
