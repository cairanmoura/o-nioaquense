---

<MainLayout title="Autoridades Públicas de Nioaque" description="Prefeito, Vice-Prefeito, Secretários Municipais, Vereadores da Câmara e Comandos Locais de Nioaque (MS).">
  <header class="mt-8 mb-10 border-b-2 border-nioaque-green pb-6">
    <h1 class="font-editorial text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
      Autoridades Públicas
    </h1>
    <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-lg">
      Poderes e órgãos do município de Nioaque (MS): contato, cargos e
      endereços institucionais para o cidadão.
    </p>
  </header>

  {[
    {
      title: 'Poder Executivo',
      subtitle: 'Prefeito, Vice-Prefeito e Secretários Municipais de Nioaque',
      items: executivo,
      id: 'executivo',
    },
    {
      title: 'Poder Legislativo',
      subtitle: 'Mesa Diretora e Vereadores da Câmara Municipal de Nioaque',
      items: legislativo,
      id: 'legislativo',
    },
    {
      title: 'Comandos e Órgãos Locais',
      subtitle: '9º GAC, Polícia Militar, Polícia Civil e Bombeiros',
      items: locais,
      id: 'orgaos-locais',
    },
  ].map((sec) => (
    <section class="mt-16" data-reveal id={sec.id}>
      <div class="flex items-baseline gap-3 border-b-2 border-nioaque-green pb-3">
        <h2 class="font-editorial text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
          {sec.title}
        </h2>
        <p class="text-sm font-medium text-ink-muted">{sec.subtitle}</p>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sec.items.map((item) => (
          <article class="border border-line bg-nioaque-white p-5 sm:p-6">
            <div class="flex items-start gap-4">
              {item.photo_url ? (
                <img
                  src={item.photo_url}
                  alt=""
                  width="72"
                  height="72"
                  class="shrink-0 h-18 w-18 rounded-sm object-cover"
                />
              ) : (
                <span class="flex h-18 w-18 shrink-0 items-center justify-center rounded-sm bg-nioaque-green-50 text-nioaque-green font-editorial text-xl font-semibold">
                  {item.name.charAt(0)}
                </span>
              )}
              <div class="min-w-0 flex-1">
                <h3 class="font-editorial text-lg font-semibold text-ink leading-snug">
                  {item.name}
                </h3>
                <p class="mt-1 text-xs font-semibold text-nioaque-green">{item.role}</p>
                {item.party && (
                  <p class="mt-1 text-xs text-ink-muted">{item.party}</p>
                )}
                {item.contact && (
                  <p class="mt-3 text-sm leading-relaxed text-ink-soft break-all">
                    {item.contact}
                  </p>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</MainLayout>
