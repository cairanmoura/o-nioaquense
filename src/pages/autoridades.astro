---
import MainLayout from '../layouts/MainLayout.astro';
import AutoridadesLista from '../components/AutoridadesLista.astro';
---

<MainLayout title="Autoridades Públicas de Nioaque" description="Prefeito, vice, secretários, vereadores, Judiciário, Ministério Público e órgãos de saúde de Nioaque (MS): cargos, contatos e endereços.">
  <div class="mx-auto w-full max-w-4xl px-4 pb-16 sm:px-6">
    <header class="mt-8 mb-6 border-b-2 border-nioaque-green pb-6">
      <h1 class="font-editorial text-3xl font-semibold tracking-tight text-ink sm:text-5xl">Autoridades Públicas</h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-soft">Quem responde pelos poderes e órgãos de Nioaque, com cargo, contato e endereço. Dados de fontes oficiais.</p>
    </header>
    <AutoridadesLista />
  </div>
</MainLayout>
