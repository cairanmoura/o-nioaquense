---
import ArticleCard from '../components/ArticleCard.astro';
import AdMosaic from '../components/AdMosaic.astro';
// import ColumnistShowcase from '../components/ColumnistShowcase.astro'; // desativado temporariamente (sem colunistas)
import GoogleAdSlot from '../components/GoogleAdSlot.astro';
import LocalAdBanner from '../components/LocalAdBanner.astro';
import LocalDailyDeal from '../components/LocalDailyDeal.astro';
import LotteryResults from '../components/LotteryResults.astro';
import MainLayout from '../layouts/MainLayout.astro';
import MostRead from '../components/MostRead.astro';
import RadarOficialBlock from '../components/RadarOficialBlock.astro';
import AdStrip from '../components/AdStrip.astro';
import AgroBand from '../components/AgroBand.astro';
import ArticlePills from '../components/ArticlePills.astro';
import SponsorCarousel from '../components/SponsorCarousel.astro';

import { getHomeFeed, getRegiaoArticles, getLotteryResults, getMarketQuotes } from '../lib/content';
import { SCOPE_LABEL } from '../lib/types';
import { formatRelative } from '../lib/format';
import { isPhotoCover } from '../lib/rss';
import type { ArticleScope, Profile, Article } from '../lib/types';

/**
 * Home do O Nioaquense.
 *
 * Estilo: editorial do Nexo Jornal (hierarquia serifada, "Direto ao ponto",
 * colunas de texto) com o dinamismo de cores do BHAZ (pílulas de categoria,
 * faixa de breaking, vitrine do comércio local).
 */

const feed = await getHomeFeed(Astro.locals);
const [lotteries, quotes] = await Promise.all([
  getLotteryResults(Astro.locals),
  getMarketQuotes(Astro.locals),
]);

const profilesById = new Map<string, Profile>(feed.profiles.map((profile) => [profile.id, profile]));
const authorOf = (id: string) => profilesById.get(id) ?? null;

const scopeParam = Astro.url.searchParams.get('escopo') as ArticleScope | null;
const validScopes: ArticleScope[] = ['nioaque', 'regiao', 'ms', 'brasil', 'coluna', 'radar_oficial'];
const activeScope = scopeParam && validScopes.includes(scopeParam) ? scopeParam : null;

/* Materias da Regiao (quando a aba Regiao esta ativa) */
let regiaoArticles: Article[] = [];
if (activeScope === null || activeScope === 'regiao') {
  regiaoArticles = await getRegiaoArticles(Astro.locals);
}

/* Data real da edicao: informacao de credibilidade, nao enfeite. */
const agora = new Date();
// Nioaque/MS vive em America/Campo_Grande (UTC-4). Sem isso, o site "amanhece"
// adiantado no fim da noite e publica a data de amanha.
const hoje = new Intl.DateTimeFormat('pt-BR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'America/Campo_Grande',
}).format(agora);
const dataHoje = hoje.charAt(0).toUpperCase() + hoje.slice(1);
const horaAgora = new Intl.DateTimeFormat('pt-BR', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'America/Campo_Grande',
}).format(agora);

/* --- Manchete principal: prioriza Nioaque --- */
const featuredNioaque = feed.featured.find((article) => article.scope === 'nioaque');
const lead =
  activeScope === null
    ? (featuredNioaque ?? feed.featured[0] ?? feed.articles[0] ?? null)
    : activeScope === 'regiao'
      ? (regiaoArticles[0] ?? null)
      : (feed.byScope[activeScope][0] ?? feed.articles[0] ?? null);

/* --- Submanchetes --- */
const nioaquePool = feed.byScope.nioaque.filter((article) => article.id !== lead?.id);
const subLeads = (
  activeScope && activeScope !== 'nioaque' && activeScope !== 'regiao'
    ? feed.byScope[activeScope].filter((article) => article.id !== lead?.id)
    : activeScope === 'regiao'
      ? regiaoArticles.filter((article) => article.id !== lead?.id)
      : nioaquePool
).slice(0, 2);

const secondary = feed.articles.filter((article) => article.id !== lead?.id);
const usedIds = new Set([lead?.id, ...subLeads.map((a) => a.id)]);
const plantao = [...secondary.filter((a) => !usedIds.has(a.id)), ...secondary.filter((a) => usedIds.has(a.id))].slice(0, 5);
const breaking = feed.breaking.slice(0, 3);
const nioaqueGrid = nioaquePool.filter((article) => !subLeads.some((item) => item.id === article.id)).slice(0, 4);
const ms = feed.byScope.ms.slice(0, 6);
// A capa da lateral e' a materia mais recente. Para a foto nao se repetir no
// meio da pagina, a editoria Brasil comeca na seguinte.
const sidebarTopId = secondary[0]?.id;
const brasil = feed.byScope.brasil.filter((article) => article.id !== sidebarTopId).slice(0, 3);
---

<MainLayout description="Notícias hiperlocais de Nioaque (MS): o que acontece na cidade, no Sul de Mato Grosso do Sul e no Brasil.">
  {
    breaking.length > 0 && (
      <div class="border-b border-nioaque-red/20 bg-nioaque-red-50">
        <div class="container-editorial flex items-center gap-3 py-2.5">
          <span class="pill-scope shrink-0 bg-nioaque-red text-white">Última hora</span>
          <div class="no-scrollbar flex min-w-0 items-center gap-6 overflow-x-auto whitespace-nowrap text-sm font-medium text-ink">
            {breaking.map((article) => (
              <a href={`/noticia/${article.slug}`} class="link-underline transition-colors hover:text-nioaque-red">
                {article.title}
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }

  <div class="container-editorial pt-4 sm:pt-6">
    <div class="flex flex-wrap items-end justify-between gap-2 border-b-2 border-nioaque-green pb-2">
      <div class="min-w-0">
        <h1 class="text-lg font-extrabold leading-tight tracking-tight text-ink sm:text-3xl">
          {activeScope ? SCOPE_LABEL[activeScope] : 'O que acontece em Nioaque'}
        </h1>
        <p class="mt-0.5 text-xs font-medium text-ink-muted sm:text-sm">{dataHoje} &middot; Nioaque, MS</p>
      </div>
      <p class="hidden pb-1 text-xs font-medium text-ink-muted sm:block">
        {feed.source === 'mock' ? 'Conteúdo de demonstração' : `Atualizado às ${horaAgora}`}
      </p>
    </div>

    {/* Categorias: uma unica linha rolavel no mobile. Ativo = verde/branco; inativo = branco/escuro. */}
    <nav class="no-scrollbar -mx-4 mt-3 flex flex-nowrap gap-2 overflow-x-auto whitespace-nowrap px-4 pb-1 sm:mx-0 sm:px-0" aria-label="Editorias">
      {
        ['nioaque', 'regiao', 'ms', 'brasil', 'coluna'].map((scope) => {
          const isActive = (activeScope ?? 'nioaque') === scope;
          return (
            <a
              href={`/editoria/${scope}`}
              class:list={[
                'inline-flex shrink-0 items-center whitespace-nowrap rounded-[4px] border px-3 py-1.5 text-xs font-semibold transition-colors',
                isActive
                  ? 'border-[#008026] bg-[#008026] text-white'
                  : 'border-slate-300 bg-white text-[#1E293B] hover:border-[#008026]',
              ]}
            >
              {SCOPE_LABEL[scope as ArticleScope]}
            </a>
          );
        })
      }
    </nav>

    {/* Primeira dobra: Bento 50% / 25% / 25% (desktop). Mobile: manchete + foto primeiro. */}
    <div class="grid gap-5 pt-4 sm:pt-5 lg:grid-cols-[2fr_1fr_1fr] lg:items-start">
      <section aria-label="Manchete principal" class="min-w-0">
        {
          lead && (
            <div class="rounded-[4px] border-2 border-[#00661E] bg-white p-3 shadow-sm sm:p-4">
              <div class="mb-3">
                <ArticlePills article={lead} showEditor />
              </div>
              <ArticleCard article={lead} author={authorOf(lead.author_id)} variant="lead" showEditor />
            </div>
          )
        }
        {/* Publicidade mobile: abaixo da 1a manchete */}
        <div class="mt-5 lg:hidden">
          <AdStrip ad={feed.ads.header_billboard} />
        </div>
      </section>

      <section aria-label="Sub-manchetes" class="grid min-w-0 gap-5 sm:grid-cols-2 lg:grid-cols-1">
        {
          subLeads.map((article) => (
            <ArticleCard article={article} author={authorOf(article.author_id)} variant="standard" class="border border-slate-200 shadow-sm" />
          ))
        }
      </section>

      <aside aria-label="Plantão" class="min-w-0 overflow-hidden rounded-[4px] border border-slate-200 bg-white shadow-sm">
        <header class="flex items-center gap-2 bg-[#00661E] px-4 py-3">
          <span class="h-2 w-2 rounded-[4px] bg-nioaque-red" aria-hidden="true"></span>
          <h2 class="text-base font-extrabold text-white">Plantão</h2>
        </header>
        <ul class="divide-y divide-slate-200">
          {
            plantao.map((article) => (
              <li>
                <a href={`/noticia/${article.slug}`} class="group flex items-start gap-3 p-3">
                  <span class="min-w-0 flex-1">
                    <span class="block text-[11px] font-bold uppercase tracking-wider text-nioaque-green">
                      {article.category_label ?? SCOPE_LABEL[article.scope]} · {formatRelative(article.published_at)}
                    </span>
                    <span class="mt-1 block text-sm font-bold leading-snug text-ink group-hover:text-nioaque-green line-clamp-3">
                      {article.title}
                    </span>
                  </span>
                  <img
                    src={isPhotoCover(article.cover_image_url) ? article.cover_image_url! : '/artes-nioarquense/arte-cultura-9gac.svg'}
                    alt=""
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    onerror="this.src='/artes-nioarquense/arte-cultura-9gac.svg'; this.onerror=null;"
                    class="h-16 w-16 shrink-0 rounded-[4px] bg-nioaque-green-50 object-cover"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>

  {/* Cotacao Agro: faixa de ponta a ponta */}
  <div class="mt-8 sm:mt-10">
    <AgroBand quotes={quotes} />
  </div>

  <div class="container-editorial pb-10 pt-8 sm:pt-10">
    {/* Mais lidas ladeada por banners horizontais curtos */}
    <div class="grid items-start gap-5 lg:grid-cols-[1fr_1.4fr_1fr]">
      <AdStrip ad={feed.ads.home_middle} class="order-2 lg:order-1" />
      <MostRead articles={feed.articles} authors={profilesById} limit={5} class="order-1 lg:order-2" />
      <AdStrip ad={feed.ads.sidebar} class="order-3" />
    </div>

    {/* Loterias compactas (1/3) + mosaico de anunciantes (2/3) */}
    <div class="mt-10 grid items-start gap-6 lg:grid-cols-[1fr_2fr]" data-reveal>
      <LotteryResults results={lotteries} />
      <AdMosaic ads={feed.ads} slots={['home_middle', 'sidebar']} label="Publicidade local" />
    </div>

    {/* Colunistas em destaque — desativado temporariamente (sem colunistas) */}

    {/* Nioaque */}
    {
      nioaqueGrid.length > 0 && (
        <section class="mt-16 sm:mt-20" aria-labelledby="sec-nioaque" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-green pb-3">
            <h2 id="sec-nioaque" class="font-editorial text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
              Nioaque
            </h2>
            <a
              href="/editoria/nioaque"
              class="ml-auto text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red"
            >
              Ver tudo
            </a>
          </div>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {nioaqueGrid.map((article) => (
              <ArticleCard
                article={article}
                author={authorOf(article.author_id)}
                variant="standard"
              />
            ))}
          </div>
        </section>
      )
    }

    {/* Regiao */}
    {
      (activeScope === null || activeScope === 'regiao') && regiaoArticles.length > 0 && (
        <section class="mt-16 sm:mt-20" aria-labelledby="sec-regiao" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-green pb-3">
            <h2 id="sec-regiao" class="font-editorial text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
              Regiao
            </h2>
            <a
              href="/editoria/regiao"
              class="ml-auto text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red"
            >
              Ver tudo
            </a>
          </div>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {regiaoArticles.slice(0, 8).map((article) => (
              <ArticleCard
                article={article}
                author={authorOf(article.author_id)}
                variant="standard"
              />
            ))}
          </div>
        </section>
      )
    }

    {/* Radar Oficial */}
    <div class="mt-16 sm:mt-20" data-reveal>
      <RadarOficialBlock articles={feed.byScope.radar_oficial} />
    </div>

    {/* Mato Grosso do Sul */}
    {
      ms.length > 0 && (
        <section class="mt-16 sm:mt-20" aria-labelledby="sec-ms" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-green pb-3">
            <h2 id="sec-ms" class="font-editorial text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
              Mato Grosso do Sul
            </h2>
            <a
              href="/editoria/ms"
              class="ml-auto text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red"
            >
              Ver tudo
            </a>
          </div>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {ms.map((article) => (
              <ArticleCard
                article={article}
                author={authorOf(article.author_id)}
                variant="standard"
              />
            ))}
          </div>
        </section>
      )
    }

    {/* Vitrine do comercio local: so existe quando ha anuncio no ar */}
    {
      (feed.ads.daily_deal || feed.ads.sidebar) && (
        <section id="comercio" class="mt-16 scroll-mt-28 sm:mt-20" aria-labelledby="sec-comercio" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-red pb-3">
            <h2 id="sec-comercio" class="font-editorial text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
              Destaque do Comércio de Nioaque
            </h2>
            <a
              href="/anuncie"
              class="ml-auto shrink-0 text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red"
            >
              Anuncie aqui
            </a>
          </div>

          {feed.ads.daily_deal ? (
            <div class="grid gap-6 pt-6 sm:pt-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
              <LocalDailyDeal ad={feed.ads.daily_deal} />

              <div class="flex flex-col gap-6">
                <LocalAdBanner ad={feed.ads.sidebar} label="Destaque local" />
                <GoogleAdSlot format="horizontal" label="Publicidade" />
              </div>
            </div>
          ) : (
            <div class="pt-6 sm:pt-8">
              <LocalAdBanner ad={feed.ads.sidebar} label="Destaque local" />
            </div>
          )}
        </section>
      )
    }

    {/* Brasil */}
    {
      brasil.length > 0 && (
        <section class="mt-16 sm:mt-20" aria-labelledby="sec-brasil" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-green pb-3">
            <h2 id="sec-brasil" class="font-editorial text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
              Brasil
            </h2>
            <a
              href="/editoria/brasil"
              class="ml-auto text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red"
            >
              Ver tudo
            </a>
          </div>
          <p class="mt-3 text-xs font-medium text-ink-muted">
            Conteúdo da Agência Brasil, com link para a matéria original.
          </p>
          <div class="mt-6 grid gap-6 pt-2 sm:grid-cols-2 sm:pt-4 lg:grid-cols-3">
            {brasil.map((article) => (
              <ArticleCard article={article} author={authorOf(article.author_id)} variant="standard" />
            ))}
          </div>
        </section>
      )
    }

    {/* Envio de pistas */}
    <section id="pistas" class="mt-16 scroll-mt-28 sm:mt-20" aria-labelledby="sec-pistas" data-reveal>
      <div class="grid gap-8 rounded-[4px] bg-nioaque-white p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-12">
        <div>
          <h2 id="sec-pistas" class="text-headline font-semibold leading-tight text-ink">
            Alguma coisa aconteceu na sua rua?
          </h2>
          <p class="mt-4 text-base leading-relaxed text-ink-soft">
            Mande a dica. A redação apura, confere com os órgãos públicos e publica. Seu nome só
            aparece se você quiser.
          </p>
          <ul class="mt-6 space-y-2.5 text-base text-ink-soft">
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-green" aria-hidden="true" />
              Buracos, coleta de lixo, iluminação, transporte
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-green" aria-hidden="true" />
              Escolas, saúde, eventos da cidade
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-green" aria-hidden="true" />
              Comércio, agricultura e produções locais
            </li>
          </ul>

          <a
            href="/mande-sua-noticia"
            class="mt-7 inline-flex items-center gap-2 rounded-[4px] bg-nioaque-red px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-nioaque-red-dark"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
            Mande sua notícia
          </a>
        </div>

        <div class="rounded-[4px] bg-editorial p-5 sm:p-6">
          <p class="text-xs font-semibold text-nioaque-red">Boca no Trombone</p>
          <p class="mt-2 font-editorial text-xl font-semibold leading-snug text-ink">
            O canal direto entre o morador de Nioaque e a redação.
          </p>
          <p class="mt-3 text-base leading-relaxed text-ink-soft">
            Nome opcional, WhatsApp, bairro, relato e até cinco fotos. A pauta chega na nossa mesa
            em segundos — e a apuração começa na hora.
          </p>

          <ul class="mt-5 space-y-2.5 text-base text-ink-soft">
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-red" aria-hidden="true" />
              Formulário curtinho, feito para o celular
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-red" aria-hidden="true" />
              Fotos comprimidas antes de subir
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-red" aria-hidden="true" />
              Ou chame a redação no WhatsApp
            </li>
          </ul>

          <a
            href="/mande-sua-noticia"
            class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red"
          >
            Abrir o canal
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </div>

  <SponsorCarousel />
</MainLayout>
