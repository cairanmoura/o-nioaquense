---
import ArticleCard from '../components/ArticleCard.astro';
import AdMosaic from '../components/AdMosaic.astro';
// import ColumnistShowcase from '../components/ColumnistShowcase.astro'; // desativado temporariamente (sem colunistas)
import GoogleAdSlot from '../components/GoogleAdSlot.astro';
import LocalAdBanner from '../components/LocalAdBanner.astro';
import LocalDailyDeal from '../components/LocalDailyDeal.astro';
import LotteryResults from '../components/LotteryResults.astro';
import MainLayout from '../layouts/MainLayout.astro';
import MostRead from '../components/MostRead.astro';
import RadarOficialBlock from '../components/RadarOficialBlock.astro';
import AdStrip from '../components/AdStrip.astro';
import AgroBand from '../components/AgroBand.astro';
import ArticlePills from '../components/ArticlePills.astro';
import ColunasCarousel from '../components/ColunasCarousel.astro';
import { getXPosts } from '../lib/colunas';
import { WHATSAPP_ATIVO } from '../lib/site';

import { getHomeFeed, getRegiaoArticles, getLotteryResults, getMarketQuotes } from '../lib/content';
import { SCOPE_LABEL } from '../lib/types';
import { formatRelative } from '../lib/format';
import { pickLead } from '../lib/cover';
import { isPhotoCover } from '../lib/rss';
const hasPhoto = (a: Article) => isPhotoCover(a.cover_image_url);
const photoFirst = (list: Article[]) => [...list.filter(hasPhoto), ...list.filter((a) => !hasPhoto(a))];
import type { ArticleScope, Profile, Article } from '../lib/types';

/**
 * Home do O Nioaquense.
 *
 * Estilo: editorial do Nexo Jornal (hierarquia serifada, "Direto ao ponto",
 * colunas de texto) com o dinamismo de cores do BHAZ (pílulas de categoria,
 * faixa de breaking, vitrine do comércio local).
 */

const feed = await getHomeFeed(Astro.locals);
const [lotteries, quotes] = await Promise.all([
  getLotteryResults(Astro.locals),
  getMarketQuotes(Astro.locals),
]);

const whatsapp = (import.meta.env.PUBLIC_REDACAO_WHATSAPP as string | undefined) || '5567999990000';
const colunasPosts = await getXPosts(Astro.locals, { limit: 12 });
const profilesById = new Map<string, Profile>(feed.profiles.map((profile) => [profile.id, profile]));
const authorOf = (id: string) => profilesById.get(id) ?? null;

const scopeParam = Astro.url.searchParams.get('escopo') as ArticleScope | null;
const validScopes: ArticleScope[] = ['nioaque', 'regiao', 'ms', 'brasil', 'mundo', 'coluna', 'radar_oficial'];
const activeScope = scopeParam && validScopes.includes(scopeParam) ? scopeParam : null;

/* Materias da Regiao (quando a aba Regiao esta ativa) */
let regiaoArticles: Article[] = [];
if (activeScope === null || activeScope === 'regiao') {
  regiaoArticles = await getRegiaoArticles(Astro.locals);
}

/* Data real da edicao: informacao de credibilidade, nao enfeite. */
const agora = new Date();
// Nioaque/MS vive em America/Campo_Grande (UTC-4). Sem isso, o site "amanhece"
// adiantado no fim da noite e publica a data de amanha.
const hoje = new Intl.DateTimeFormat('pt-BR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'America/Campo_Grande',
}).format(agora);
const dataHoje = hoje.charAt(0).toUpperCase() + hoje.slice(1);
const horaAgora = new Intl.DateTimeFormat('pt-BR', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'America/Campo_Grande',
}).format(agora);

/* --- Manchete principal: prioriza Nioaque --- */
// Capa: pin manual valido (Urgente/Destaque com validade) ou rotacao automatica (prioriza Nioaque)
const leadPool =
  activeScope === null
    ? feed.articles
    : activeScope === 'regiao'
      ? regiaoArticles
      : feed.byScope[activeScope];
const lead = pickLead(leadPool) ?? feed.articles[0] ?? null;

/* --- Submanchetes --- */
const nioaquePool = photoFirst(feed.byScope.nioaque).filter((article) => article.id !== lead?.id);
const subLeads = (
  activeScope && activeScope !== 'nioaque' && activeScope !== 'regiao'
    ? feed.byScope[activeScope].filter((article) => article.id !== lead?.id)
    : activeScope === 'regiao'
      ? regiaoArticles.filter((article) => article.id !== lead?.id)
      : nioaquePool
).slice(0, 2);

// Coluna do meio: prioriza Nioaque; se faltar, completa com as melhores materias recentes (nunca fica vazia)
if (subLeads.length < 2) {
  const extra = photoFirst(
    feed.articles.filter((a) => a.id !== lead?.id && !subLeads.some((s) => s.id === a.id) && a.scope !== 'coluna' && a.scope !== 'radar_oficial'),
  ).slice(0, 2 - subLeads.length);
  subLeads.push(...extra);
}

const secondary = feed.articles.filter((article) => article.id !== lead?.id);
const usedIds = new Set([lead?.id, ...subLeads.map((a) => a.id)]);
const plantao = photoFirst(secondary.filter((a) => !usedIds.has(a.id))).slice(0, 5);
const breaking = feed.breaking.slice(0, 3);
const nioaqueGrid = nioaquePool.filter((article) => !subLeads.some((item) => item.id === article.id)).slice(0, 4);
const ms = feed.byScope.ms.slice(0, 6);
// A capa da lateral e' a materia mais recente. Para a foto nao se repetir no
// meio da pagina, a editoria Brasil comeca na seguinte.
const sidebarTopId = secondary[0]?.id;
const brasil = feed.byScope.brasil.filter((article) => article.id !== sidebarTopId).slice(0, 3);
const mundo = feed.byScope.mundo.slice(0, 3);
const transparencia = feed.articles.filter((a) => a.category_label === 'Transparência').slice(0, 3);
---

<MainLayout description="Notícias hiperlocais de Nioaque (MS): o que acontece na cidade, no Sul de Mato Grosso do Sul e no Brasil.">
  {
    breaking.length > 0 && (
      <div class="border-b border-nioaque-red/20 bg-nioaque-red-50">
        <div class="container-editorial flex items-center gap-3 py-2.5">
          <span class="pill-scope shrink-0 bg-nioaque-red text-white">Última hora</span>
          <div class="no-scrollbar flex min-w-0 items-center gap-6 overflow-x-auto whitespace-nowrap text-sm font-medium text-ink">
            {breaking.map((article) => (
              <a href={`/noticia/${article.slug}`} class="link-underline transition-colors hover:text-nioaque-red-dark">
                {article.title}
              </a>
            ))}
          </div>
        </div>
      </div>
    )
  }

  <div class="container-editorial pt-4 sm:pt-6">
    <h1 class="sr-only">{activeScope ? SCOPE_LABEL[activeScope] : 'O Nioaquense, notícias de Nioaque (MS)'}</h1>

    {/* Categorias: uma unica linha rolavel no mobile. Ativo = verde/branco; inativo = branco/escuro. */}
    <nav class="no-scrollbar -mx-4 mt-3 flex flex-nowrap gap-2 overflow-x-auto whitespace-nowrap px-4 pb-1 sm:mx-0 sm:px-0" aria-label="Editorias">
      {
        ['nioaque', 'regiao', 'ms', 'brasil', 'mundo'].map((scope) => {
          const isActive = (activeScope ?? 'nioaque') === scope;
          return (
            <a
              href={`/materias?local=${scope}`}
              class:list={[
                'inline-flex min-h-10 shrink-0 items-center whitespace-nowrap rounded-[4px] border px-4 text-[13px] font-medium transition-colors',
                isActive
                  ? 'border-nioaque-green bg-nioaque-green font-semibold text-white'
                  : 'border-pedra bg-branco text-ink hover:border-nioaque-green',
              ]}
            >
              {SCOPE_LABEL[scope as ArticleScope]}
            </a>
          );
        })
      }
    </nav>

    {/* Filete A1 "Degraus" (sistema de design): logo abaixo das pilulas de editoria */}
    <div class="filete-degraus mt-3" aria-hidden="true">
      <svg width="64" height="14" viewBox="0 0 64 14" class="shrink-0">
        <rect x="0" y="0" width="64" height="4" fill="#166A34" />
        <rect x="8" y="5" width="48" height="4" fill="#fff" stroke="#BDB6A3" />
        <rect x="16" y="10" width="32" height="4" fill="#D92323" />
      </svg>
      <div class="ln"><i></i><i></i></div>
    </div>

    {/* Primeira dobra: Bento 50% / 25% / 25% (desktop). Mobile: manchete + foto primeiro. */}
    <div class="grid gap-5 pt-4 sm:pt-5 lg:grid-cols-[2fr_1fr_1fr] lg:items-start">
      <section aria-label="Manchete principal" class="min-w-0">
        {
          lead && (
            <div class="border-t-[3px] border-nioaque-green pt-3">
              <div class="mb-3">
                <ArticlePills article={lead} showEditor />
              </div>
              <ArticleCard article={lead} author={authorOf(lead.author_id)} variant="lead" showEditor showSummary summaryClass="hidden lg:block" />
            </div>
          )
        }
        {/* Publicidade mobile: abaixo da 1a manchete */}
        {feed.ads.header_billboard && (<div class="mt-5 lg:hidden"><AdStrip ad={feed.ads.header_billboard} /></div>)}
      </section>

      <section aria-label="Sub-manchetes" class="grid min-w-0 gap-5 sm:grid-cols-2 lg:grid-cols-1">
        {
          subLeads.map((article) => (
            <ArticleCard article={article} author={authorOf(article.author_id)} variant="standard" class="border border-pedra" />
          ))
        }
      </section>

      <div class="min-w-0 space-y-5">
      <aside aria-label="Plantão" class="overflow-hidden rounded-[4px] border border-pedra bg-branco">
        <header class="flex items-center gap-2 bg-nioaque-green px-4 py-3">
          <span class="h-2 w-2 rounded-full bg-nioaque-red" aria-hidden="true"></span>
          <h2 class="font-serif text-[17px] font-bold leading-5 text-white">Plantão</h2>
        </header>
        <ul class="divide-y divide-pedra">
          {
            plantao.map((article) => (
              <li>
                <a href={`/noticia/${article.slug}`} class="group flex items-start gap-3 p-3">
                  <span class="min-w-0 flex-1">
                    <span class="block text-[11px] font-bold uppercase tracking-wider text-nioaque-green">
                      {article.category_label ?? SCOPE_LABEL[article.scope]} · {formatRelative(article.published_at)}
                    </span>
                    <span class="mt-1 block text-sm font-bold leading-snug text-ink group-hover:text-nioaque-green line-clamp-3">
                      {article.title}
                    </span>
                  </span>
                  <img
                    src={isPhotoCover(article.cover_image_url) ? article.cover_image_url! : 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 9%22%3E%3Crect width=%2216%22 height=%229%22 fill=%22%2300661E%22/%3E%3C/svg%3E'}
                    alt=""
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 9%22%3E%3Crect width=%2216%22 height=%229%22 fill=%22%2300661E%22/%3E%3C/svg%3E'; this.onerror=null;"
                    class="h-16 w-16 shrink-0 rounded-[4px] bg-nioaque-green-50 object-cover"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
      <LotteryResults results={lotteries} />
      </div>
    </div>
  </div>

  {colunasPosts.length > 0 && (
    <div class="w-full bg-black">
      <div class="container-editorial py-8 sm:py-10">
        <ColunasCarousel posts={colunasPosts} />
      </div>
    </div>
  )}

  <div class="container-editorial pb-2 pt-8 sm:pt-10">

    {/* Nioaque */}
    {
      nioaqueGrid.length > 0 && (
        <section class="mt-16 sm:mt-20" aria-labelledby="sec-nioaque" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-green pb-3">
            <h2 id="sec-nioaque" class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-[30px] sm:leading-[34px]">
              Nioaque
            </h2>
            <a
              href="/materias?local=nioaque"
              class="ml-auto text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red-dark"
            >
              Ver tudo
            </a>
          </div>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {nioaqueGrid.map((article) => (
              <ArticleCard
                article={article}
                author={authorOf(article.author_id)}
                variant="standard"
              />
            ))}
          </div>
        </section>
      )
    }

    {/* Regiao */}
    {
      (activeScope === null || activeScope === 'regiao') && regiaoArticles.length > 0 && (
        <section class="-mx-4 mt-16 bg-branco px-4 py-8 sm:-mx-6 sm:mt-20 sm:px-6 lg:-mx-8 lg:px-8" aria-labelledby="sec-regiao" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-green pb-3">
            <h2 id="sec-regiao" class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-[30px] sm:leading-[34px]">
              Região
            </h2>
            <a
              href="/materias?local=regiao"
              class="ml-auto text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red-dark"
            >
              Ver tudo
            </a>
          </div>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {regiaoArticles.slice(0, 8).map((article) => (
              <ArticleCard
                article={article}
                author={authorOf(article.author_id)}
                variant="standard"
              />
            ))}
          </div>
        </section>
      )
    }

    {/* Mato Grosso do Sul */}
    {
      ms.length > 0 && (
        <section class="mt-16 sm:mt-20" aria-labelledby="sec-ms" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-green pb-3">
            <h2 id="sec-ms" class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-[30px] sm:leading-[34px]">
              Mato Grosso do Sul
            </h2>
            <a
              href="/materias?local=ms"
              class="ml-auto text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red-dark"
            >
              Ver tudo
            </a>
          </div>
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {ms.map((article) => (
              <ArticleCard
                article={article}
                author={authorOf(article.author_id)}
                variant="standard"
              />
            ))}
          </div>
        </section>
      )
    }

    {/* Brasil */}
    {
      brasil.length > 0 && (
        <section class="mt-16 sm:mt-20" aria-labelledby="sec-brasil" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-green pb-3">
            <h2 id="sec-brasil" class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-[30px] sm:leading-[34px]">
              Brasil
            </h2>
            <a
              href="/materias?local=brasil"
              class="ml-auto text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red-dark"
            >
              Ver tudo
            </a>
          </div>
          <div class="mt-6 grid gap-6 pt-2 sm:grid-cols-2 sm:pt-4 lg:grid-cols-3">
            {brasil.map((article) => (
              <ArticleCard article={article} author={authorOf(article.author_id)} variant="standard" />
            ))}
          </div>
        </section>
      )
    }

    {/* Mundo */}
    {
      mundo.length > 0 && (
        <section class="mt-16 sm:mt-20" aria-labelledby="sec-mundo" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-green pb-3">
            <h2 id="sec-mundo" class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-[30px] sm:leading-[34px]">
              Mundo
            </h2>
            <a
              href="/materias?local=mundo"
              class="ml-auto text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red-dark"
            >
              Ver tudo
            </a>
          </div>
          <div class="mt-6 grid gap-6 pt-2 sm:grid-cols-2 sm:pt-4 lg:grid-cols-3">
            {mundo.map((article) => (
              <ArticleCard article={article} author={authorOf(article.author_id)} variant="standard" />
            ))}
          </div>
        </section>
      )
    }

    {/* Transparencia e fiscalizacao: tema de importancia editorial do jornal */}
    {
      transparencia.length > 0 && (
        <section class="mt-16 sm:mt-20" aria-labelledby="sec-transparencia" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-red pb-3">
            <h2 id="sec-transparencia" class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-[30px] sm:leading-[34px]">
              Transparência e Fiscalização
            </h2>
            <a
              href="/materias?tema=transparencia"
              class="ml-auto text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red-dark"
            >
              Ver tudo
            </a>
          </div>
          <p class="mt-3 text-xs font-medium text-ink-muted">Contas públicas, licitações e controle: para onde vai o dinheiro do cidadão.</p>
          <div class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {transparencia.map((article) => (
              <ArticleCard article={article} author={authorOf(article.author_id)} variant="standard" />
            ))}
          </div>
        </section>
      )
    }

  </div>

  {/* Mais lidas (e anuncios do meio), logo abaixo de Transparencia e Fiscalizacao */}
  <div class="w-full border-b border-pedra bg-branco">
    <div class="container-editorial py-8 sm:py-10">
      <div class={feed.ads.home_middle || feed.ads.sidebar ? 'grid items-start gap-5 lg:grid-cols-[1fr_1.4fr_1fr]' : 'mx-auto max-w-3xl'}>
        {feed.ads.home_middle && <AdStrip ad={feed.ads.home_middle} class="order-2 lg:order-1" />}
        <MostRead articles={feed.articles} authors={profilesById} limit={5} class="order-1 lg:order-2" />
        {feed.ads.sidebar && <AdStrip ad={feed.ads.sidebar} class="order-3" />}
      </div>
    </div>
  </div>

  {/* Cotacao Agro: faixa de ponta a ponta */}
  <AgroBand quotes={quotes} />

  <div class="container-editorial pb-10 pt-0">

    {/* Radar Oficial */}
    <div class="mt-16 sm:mt-20" data-reveal>
      <RadarOficialBlock articles={feed.byScope.radar_oficial} />
    </div>

    {/* Envio de pistas */}
    <section id="pistas" class="mt-16 scroll-mt-28 sm:mt-20" aria-labelledby="sec-pistas" data-reveal>
      <div class="grid gap-8 rounded-[4px] bg-nioaque-white p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-12">
        <div>
          <h2 id="sec-pistas" class="text-headline font-semibold leading-tight text-ink">
            Alguma coisa aconteceu na sua rua?
          </h2>
          <p class="mt-4 text-base leading-relaxed text-ink-soft">
            Mande a dica. A redação apura, confere com os órgãos públicos e publica. Seu nome só
            aparece se você quiser.
          </p>
          <ul class="mt-6 space-y-2.5 text-base text-ink-soft">
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-green" aria-hidden="true" />
              Buracos, coleta de lixo, iluminação, transporte
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-green" aria-hidden="true" />
              Escolas, saúde, eventos da cidade
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-green" aria-hidden="true" />
              Comércio, agricultura e produções locais
            </li>
          </ul>

          <a
            href="/mande-sua-noticia"
            class="mt-7 inline-flex items-center gap-2 rounded-[4px] bg-nioaque-red px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-nioaque-red-dark"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
            Mande sua notícia
          </a>
        </div>

        <div class="relative overflow-hidden rounded-[4px] bg-verde-mata p-5 text-white sm:p-7">
          <svg class="pointer-events-none absolute -bottom-3 -right-3 h-[150px] w-[230px] opacity-[0.08]" viewBox="0 0 230 150" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 62h34l86-42v110l-86-42H20z"/><path d="M54 62v38M64 100l8 30h18l-8-30"/><path d="M158 48c14 10 14 44 0 54M176 36c24 18 24 60 0 78M194 24c32 26 32 76 0 102"/></svg>
          <div class="relative">
          <p class="font-serif text-[30px] font-bold leading-[34px]">Boca no Trombone</p>
          <p class="mt-2 font-serif text-xl font-bold leading-snug text-white">
            Sua denúncia muda a cidade.
          </p>
          <p class="mt-3 text-base leading-relaxed text-verde-texto-suave">
            Buraco que ninguém conserta, escola sem merenda, posto sem médico: o problema só chega ao poder público quando alguém conta. Falar é o primeiro passo para resolver, e a redação cobra a resposta e acompanha até o fim.
          </p>

          <ul class="mt-5 space-y-2.5 text-base text-verde-texto-suave">
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-red-light" aria-hidden="true" />
              Conte em poucas linhas, direto do celular
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-red-light" aria-hidden="true" />
              Envie até cinco fotos e o bairro: ajuda a apurar mais rápido
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-red-light" aria-hidden="true" />
              Seu nome só aparece se você quiser
            </li>
          </ul>

          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
            <a
              href="/mande-sua-noticia"
              class="inline-flex min-h-12 items-center gap-2 rounded-[4px] bg-nioaque-red px-6 text-[15px] font-semibold text-white transition-colors hover:bg-nioaque-red-dark"
            >
              Enviar denúncia
              <span aria-hidden="true">→</span>
            </a>
            {WHATSAPP_ATIVO && (
            <a
              href={`https://wa.me/${whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-semibold text-white underline underline-offset-2"
            >
              Ou chame a redação no WhatsApp
            </a>
            )}
          </div>
          </div>
        </div>
      </div>
    </section>
    {/* Vitrine do comercio local: so existe quando ha anuncio no ar */}
    {
      (feed.ads.daily_deal || feed.ads.sidebar) && (
        <section id="comercio" class="mt-16 scroll-mt-28 sm:mt-20" aria-labelledby="sec-comercio" data-reveal>
          <div class="flex items-baseline gap-3 border-b-2 border-nioaque-red pb-3">
            <h2 id="sec-comercio" class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-[30px] sm:leading-[34px]">
              Destaque do Comércio de Nioaque
            </h2>
            <a
              href="/anuncie"
              class="ml-auto shrink-0 text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red-dark"
            >
              Anuncie aqui
            </a>
          </div>

          {feed.ads.daily_deal ? (
            <div class="grid gap-6 pt-6 sm:pt-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
              <LocalDailyDeal ad={feed.ads.daily_deal} />

              <div class="flex flex-col gap-6">
                <LocalAdBanner ad={feed.ads.sidebar} label="Destaque local" />
                <GoogleAdSlot format="horizontal" label="Publicidade" />
              </div>
            </div>
          ) : (
            <div class="pt-6 sm:pt-8">
              <LocalAdBanner ad={feed.ads.sidebar} label="Destaque local" />
            </div>
          )}
        </section>
      )
    }

  </div>

</MainLayout>
