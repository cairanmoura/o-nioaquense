---
import ArticleCard from '../components/ArticleCard.astro';
import MainLayout from '../layouts/MainLayout.astro';
import RadarOficialBlock from '../components/RadarOficialBlock.astro';
import { getHomeFeed } from '../lib/content';

/**
 * /radar-oficial
 * -----------------------------------------------------------------------------
 * Pagina da editoria especial "Radar Oficial": Prefeitura, Camara, Concursos e
 * Diario Oficial traduzidos em linguagem simples.
 */

const feed = await getHomeFeed(Astro.locals);
const radar = feed.byScope.radar_oficial;

const GROUPS = [
  {
    key: 'Prefeitura',
    hint: 'O que a Prefeitura esta fazendo na cidade',
    icon: 'M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6',
  },
  {
    key: 'Câmara',
    hint: 'Decisoes e projetos da Casa',
    icon: 'M3 9h18M5 9v11M9 9v11M15 9v11M19 9v11M2 20h20M12 3l9 5H3l9-5Z',
  },
  {
    key: 'Concursos',
    hint: 'Vagas, seletivas e nomeacoes',
    icon: 'M4 5h16v14H4zM8 9h8M8 13h5',
  },
  {
    key: 'Diário Oficial',
    hint: 'Publicacoes e avisos do dia',
    icon: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h6M9 17h6',
  },
];

const byCategory = new Map<string, typeof radar>();
for (const article of radar) {
  const key = article.category_label ?? 'Prefeitura';
  byCategory.set(key, [...(byCategory.get(key) ?? []), article]);
}
---

<MainLayout
  title="Radar Oficial"
  description="Prefeitura, Câmara, Concursos e Diário Oficial de Nioaque explicados de forma simples: o que mudou, o que abre e até quando."
>
  <div class="container-editorial py-8 sm:py-10">
    <header class="border-b-2 border-nioaque-green pb-5">
      <p class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-green">
        Serviço público
      </p>
      <h1 class="mt-1 text-headline font-semibold leading-tight text-ink">Radar Oficial</h1>
      <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-soft">
        O que a Prefeitura, a Câmara, os concursos e o Diário Oficial resolveram — traduzido em uma
        frase por assunto, com o link do documento oficial quando existe.
      </p>
    </header>

    {/* Grupos */}
    <section class="mt-8 grid gap-6 sm:grid-cols-2" aria-label="Assuntos do Radar Oficial">
      {
        GROUPS.map((group) => {
          const items = byCategory.get(group.key) ?? [];

          return (
            <div class="rounded-2xl border border-line bg-nioaque-white p-5">
              <div class="flex items-start gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-nioaque-green-50 text-nioaque-green">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={group.icon} />
                  </svg>
                </span>
                <div class="min-w-0">
                  <h2 class="font-editorial text-lg font-semibold leading-tight text-ink">
                    {group.key}
                  </h2>
                  <p class="mt-0.5 text-xs leading-relaxed text-ink-muted">{group.hint}</p>
                </div>
              </div>

              {items.length === 0 ? (
                <p class="mt-4 border-t border-line pt-4 text-xs text-ink-muted">
                  Nada publicado neste assunto ainda.
                </p>
              ) : (
                <ul class="mt-4 space-y-3 border-t border-line pt-4">
                  {items.map((article) => (
                    <li>
                      <a
                        href={`/noticia/${article.slug}`}
                        class="group block font-editorial text-[0.9375rem] font-semibold leading-snug text-ink transition-colors hover:text-nioaque-green"
                      >
                        {article.title}
                      </a>
                      {article.summary_bullets[0] && (
                        <p class="mt-1 text-xs leading-relaxed text-ink-muted">
                          {article.summary_bullets[0]}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          );
        })
      }
    </section>

    {/* Todos os textos do Radar */}
    <section class="mt-12" aria-labelledby="todos-radar">
      <h2
        id="todos-radar"
        class="border-b-2 border-nioaque-green pb-3 font-editorial text-2xl font-semibold tracking-tight text-ink"
      >
        Todas as publicações
      </h2>

      {
        radar.length === 0 ? (
          <p class="mt-6 rounded-2xl border border-dashed border-line-strong bg-nioaque-white p-8 text-center text-sm text-ink-soft">
            Nenhuma publicação no Radar Oficial ainda.
          </p>
        ) : (
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {radar.map((article) => (
              <ArticleCard article={article} variant="standard" />
            ))}
          </div>
        )
      }
    </section>

    {/* Bloco visual do Radar */}
    <div class="mt-12">
      <RadarOficialBlock articles={radar} />
    </div>
  </div>
</MainLayout>
