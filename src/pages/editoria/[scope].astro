---
import ArticleCard from '../../components/ArticleCard.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { getHomeFeed, getRegiaoArticles } from '../../lib/content';
import { pickLead } from '../../lib/cover';
import { CATEGORIES, norm } from '../../lib/categories';
import { SCOPE_BADGE_CLASS, SCOPE_LABEL } from '../../lib/types';
import type { ArticleScope } from '../../lib/types';

/**
 * /editoria/[scope]
 * -----------------------------------------------------------------------------
 * Rota dinamica das editorias. `radar_oficial` tem pagina propria
 * (/radar-oficial) e por isso e' redirecionada.
 */

const { scope = 'nioaque' } = Astro.params;

/* Tudo foi centralizado em /materias (filtros de local e tema). Links antigos redirecionam. */
const LEGACY_THEME: Record<string, string> = { 'politica-poder': 'politica', 'agro-campo': 'agro', 'policia-justica': 'policia' };
if (['nioaque', 'regiao', 'ms', 'brasil', 'mundo'].includes(scope)) {
  return Astro.redirect(`/materias?local=${scope}`, 301);
}
const themeSlug = LEGACY_THEME[scope] ?? scope;
if (CATEGORIES.some((c) => c.slug === themeSlug)) {
  return Astro.redirect(`/materias?tema=${themeSlug}`, 301);
}

const EDITORIAS: Record<string, { label: string; description: string; color: string }> = {
  nioaque: {
    label: 'Nioaque',
    description:
      'A cidade em primeiro plano: obras, servicos, escolas, saude,trade e o que esta mudando no municipio.',
    color: 'bg-nioaque-green',
  },
  ms: {
    label: 'Mato Grosso do Sul',
    description:
      'As decisoes do Estado que chegam primeiro a Nioaque: infraestrutura, saude, educacao e economia.',
    color: 'bg-ink',
  },
  brasil: {
    label: 'Brasil',
    description:
      'O pais em titulos que interessam quem vive no interior: politica, economia, clima e direitos.',
    color: 'bg-ink',
  },
  regiao: {
    label: 'Região',
    description: 'Jardim, Bonito, Anastácio, Aquidauana, Sidrolândia e a BR-060: o que acontece ao redor de Nioaque.',
    color: 'bg-nioaque-green',
  },
  coluna: {
    label: 'Colunas',
    description:
      'Opinao assinada. Cada coluna tem autor, nome e historico de textos.',
    color: 'bg-nioaque-red',
  },
  radar_oficial: {
    label: 'Radar Oficial',
    description: 'Prefeitura, Camara, Concursos e Diario Oficial explicados em linguagem simples.',
    color: 'bg-nioaque-red',
  },
};

/** Seções temáticas do menu "Seções": filtram pela editoria (category_label). */
/* Editorias tematicas: uma pagina para cada categoria oficial (lib/categories) +
 * os atalhos antigos do menu (politica-poder, agro-campo, policia-justica). */
const THEMES: Record<string, { label: string; match: string[]; description: string }> = {
  ...Object.fromEntries(
    CATEGORIES.filter((c) => !['geral'].includes(c.slug)).map((c) => [
      c.slug,
      { label: c.label, match: [norm(c.label), ...c.synonyms.map((x) => norm(x))].map((x) => x), description: c.description },
    ]),
  ),
  'politica-poder': { label: 'Política & Poder', match: ['politica', 'camara', 'prefeitura', 'governo'], description: 'Prefeitura, Câmara, Governo e decisões que afetam a cidade.' },
  'agro-campo': { label: 'Agro & Campo', match: ['agro', 'agricultura', 'pecuaria'], description: 'Pecuária, lavoura, preços e a vida no campo.' },
  'policia-justica': { label: 'Polícia & Justiça', match: ['policia', 'justica', 'seguranca'], description: 'Segurança pública, ocorrências e decisões da Justiça.' },
};
const theme = THEMES[scope];
const editoria = theme
  ? { label: theme.label, description: theme.description, color: 'bg-nioaque-green' }
  : EDITORIAS[scope];

if (!editoria) {
  return Astro.redirect('/');
}

if (scope === 'radar_oficial') {
  return Astro.redirect('/radar-oficial');
}

const feed = await getHomeFeed(Astro.locals);
const articles = theme
  ? feed.articles.filter((a) => theme.match.some((m) => norm(a.category_label) === m))
  : scope === 'regiao'
    ? await getRegiaoArticles(Astro.locals)
    : (feed.byScope[scope as ArticleScope] ?? []);
const profilesById = new Map(feed.profiles.map((profile) => [profile.id, profile]));

const featured = pickLead(articles) ?? articles[0];
const rest = articles.filter((article) => article.id !== featured?.id);
---

<MainLayout title={editoria.label} description={editoria.description}>
  <div class="container-editorial py-8 sm:py-10">
    <header class="border-b-2 border-nioaque-green pb-5">
      <p class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red-dark">
        Editoria
      </p>
      <h1 class="mt-1 text-headline font-semibold leading-tight text-ink">{editoria.label}</h1>
      <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-soft">
        {editoria.description}
      </p>
      <p class="mt-3 text-xs font-semibold uppercase tracking-[0.1em] text-ink-muted">
        {articles.length} {articles.length === 1 ? 'matéria' : 'matérias'}
      </p>
    </header>

    {/* Navegacao entre editorias */}
    <nav class="mt-6 flex flex-wrap gap-2 sm:gap-3" aria-label="Trocar de editoria">
      {[
        'nioaque',
        'ms',
        'brasil',
        'coluna',
        'radar_oficial',
      ].map((editoriaScope) => {
        const isActive = scope === editoriaScope;
        const href =
          editoriaScope === 'radar_oficial' ? '/radar-oficial' : `/editoria/${editoriaScope}`;
        return (
          <a
            href={href}
            class={`px-3 py-1.5 text-xs font-semibold rounded-[4px] transition-colors ${
              isActive
                ? SCOPE_BADGE_CLASS[editoriaScope as ArticleScope]
                : 'bg-nioaque-white border border-line text-ink-soft hover:bg-nioaque-green-50 hover:text-nioaque-green-dark'
            }`}
          >
            {SCOPE_LABEL[editoriaScope as ArticleScope]}
          </a>
        );
      })}
    </nav>

    {
      articles.length === 0 ? (
        <p class="mt-10 rounded-[4px] border border-dashed border-line-strong bg-nioaque-white p-10 text-center text-sm text-ink-soft">
          Nenhuma matéria publicada nesta editoria ainda.
        </p>
      ) : (
        <>
          {featured && (
            <div class="mt-8 grid gap-8 border-b border-line pb-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
              <ArticleCard
                article={featured}
                author={profilesById.get(featured.author_id) ?? null}
                variant="lead"
              />

              <div class="divide-y divide-line">
                {rest.slice(0, 5).map((article) => (
                  <ArticleCard
                    article={article}
                    author={profilesById.get(article.author_id) ?? null}
                    variant="compact"
                  />
                ))}
              </div>
            </div>
          )}

          {rest.length > 5 && (
            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {rest.slice(5).map((article) => (
                <ArticleCard
                  article={article}
                  author={profilesById.get(article.author_id) ?? null}
                  variant="standard"
                />
              ))}
            </div>
          )}
        </>
      )
    }

    <p class="mt-12">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.12em] text-nioaque-green transition-colors hover:text-nioaque-red-dark"
      >
        <span aria-hidden="true">←</span>
        Voltar para a capa
      </a>
    </p>
  </div>
</MainLayout>
