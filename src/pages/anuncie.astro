---
import MainLayout from '../layouts/MainLayout.astro';

/**
 * /anuncie - Pagina comercial do portal O Nioaquense.
 * Apresenta formatos de mídia, vantagens e canal direto de contratacao.
 */

const formats = [
  {
    name: 'Topo do Portal',
    description:
      'Leaderboard fixo no cabeçalho de todas as páginas. Máxima visibilidade para a sua marca no primeiro contato do leitor com o portal.',
    size: '728 × 90 px',
    position: 'Header (todas as páginas)',
  },
  {
    name: 'Meio de Página',
    description:
      'Retângulo médio inserido no corpo das notícias, entre parágrafos de leitura. Ideal para campanhas de conscientização e promoções sazonais.',
    size: '300 × 250 px',
    position: 'Dentro das matérias',
  },
  {
    name: 'Rodapé',
    description:
      'Banner de fechamento nas páginas de leitura e editoriais. Último impacto antes o leitor sair da página.',
    size: '300 × 250 px',
    position: 'Rodapé dos artigos',
  },
  {
    name: 'Vitrine do Comércio',
    description:
      'Destaque do Comércio de Nioaque na home, com logo, nome da empresa e chamada para ação direcionada ao site ou à rede social do anunciante.',
    size: '300 × 600 px',
    position: 'Home (seção de comércio)',
  },
  {
    name: 'Informe Publicitário',
    description:
      'Reportagem publicitária assinada pela redação, com texto, fotos e divulgação nas redes sociais do portal. Conteúdo nativo de confiança.',
    size: 'Editorial completo',
    position: 'Página própria + redes',
  },
];

const advantages = [
  'Alcance hiperlocal: sua mensagem chega diretamente aos moradores de Nioaque e região.',
  'Audiência qualificada: leitores que buscam notícias da cidade, serviços públicos e comércio local.',
  'Preços acessíveis para pequenos e médios negócios de Nioaque.',
  'Métricas transparentes: cliques e impressões de cada campanha.',
  'Atendimento direto com a redação, sem intermediários.',
];
---

<MainLayout title="Anuncie no O Nioaquense" description="Anuncie sua empresa no portal de notícias de Nioaque (MS). Formatos: Topo, Meio de Página, Rodapé, Vitrine do Comércio e Informe Publicitário.">
  <div class="container-editorial pb-16">
    <div class="mx-auto max-w-4xl">
      <header class="mb-10 mt-8 border-b-[3px] border-nioaque-green pb-6">
        <h1 class="font-serif text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">Anuncie no O Nioaquense</h1>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          Leve sua marca para quem mais importa: os moradores de Nioaque (MS). O portal hiperlocal que cobre o que
          acontece na cidade, no Sul de Mato Grosso do Sul e no Brasil.
        </p>
      </header>

      {/* Formatos de mídia */}
      <section id="formatos" aria-labelledby="t-formatos">
        <h2 id="t-formatos" class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-[30px] sm:leading-[34px]">Formatos de mídia</h2>
        <p class="mt-2 text-sm text-ink-muted">Escolha o espaço que melhor combina com o seu objetivo de campanha.</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {formats.map((fmt) => (
            <article class="flex flex-col rounded-[4px] border border-pedra bg-branco p-5 sm:p-6">
              <h3 class="font-serif text-lg font-extrabold text-ink">{fmt.name}</h3>
              <p class="mt-1 text-xs font-semibold tabular-nums text-nioaque-green">{fmt.size}</p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{fmt.description}</p>
              <p class="mt-4 border-t border-pedra pt-3 text-xs font-medium text-ink-muted">{fmt.position}</p>
            </article>
          ))}
        </div>
      </section>

      {/* Vantagens */}
      <section id="vantagens" class="mt-12 rounded-[4px] border border-pedra bg-branco p-6 sm:p-10" aria-labelledby="t-vantagens">
        <h2 id="t-vantagens" class="font-serif text-2xl font-bold tracking-tight text-ink sm:text-[30px] sm:leading-[34px]">Por que anunciar no O Nioaquense?</h2>
        <ul class="mt-6 space-y-4 text-[15px] leading-relaxed text-ink-soft">
          {advantages.map((adv) => (
            <li class="flex items-start gap-3">
              <span class="mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-nioaque-green" aria-hidden="true"></span>
              <span>{adv}</span>
            </li>
          ))}
        </ul>
      </section>

      {/* Contratação */}
      <section id="contratacao" class="mt-12" aria-labelledby="t-contratacao">
        <div class="rounded-[4px] bg-verde-mata p-6 text-white sm:p-10">
          <h2 id="t-contratacao" class="font-serif text-2xl font-bold tracking-tight sm:text-[30px] sm:leading-[34px]">Quer anunciar? Fale com a redação.</h2>
          <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-verde-texto-suave">
            Envie sua mensagem pelo formulário do portal. Retornamos em até 24 horas úteis com a tabela de preços e a
            disponibilidade de espaços.
          </p>
          <a
            href="/mande-sua-noticia"
            class="mt-7 inline-flex min-h-12 items-center justify-center rounded-[4px] bg-nioaque-red px-6 text-[15px] font-semibold text-white transition-colors hover:bg-nioaque-red-dark"
          >
            Enviar formulário
          </a>
        </div>
      </section>
    </div>
  </div>
</MainLayout>
