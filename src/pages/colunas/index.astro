---
import ColunaCard from '../../components/ColunaCard.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { avatarOf, getColumnists, getXPosts } from '../../lib/colunas';

/**
 * /colunas - opinião e análise dos colunistas do X.
 * Hero com as 3 colunas mais recentes (mais nova à esquerda), mini-perfis e arquivo.
 */
const [columnists, posts] = await Promise.all([getColumnists(Astro.locals), getXPosts(Astro.locals, { limit: 60 })]);
const hero = posts.slice(0, 3);
const older = posts.slice(3);
const countBy = (id: string) => posts.filter((p) => p.columnist_id === id).length;
---

<MainLayout title="Colunas" description="Colunas de opinião e análise de política e economia dos colunistas do O Nioaquense.">
  <div class="container-editorial py-6 sm:py-10">
    <header class="border-b-2 border-nioaque-green pb-4">
      <p class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red-dark">Colunas</p>
      <h1 class="mt-1 text-headline font-semibold leading-tight text-ink">Opinião e análise</h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-soft">
        Os colunistas comentam política, economia e atualidades no X. Cada publicação vira uma coluna aqui, com o post original para ler e compartilhar. As opiniões são dos autores.
      </p>
    </header>

    {hero.length === 0 ? (
      <p class="mt-10 rounded-[4px] border border-dashed border-line-strong bg-nioaque-white p-10 text-center text-sm text-ink-soft">As primeiras colunas chegam em breve.</p>
    ) : (
      <section class="mt-6" aria-label="Colunas mais recentes">
        <div class="grid gap-4 md:grid-cols-3">
          {hero.map((p, i) => (
            <div class="relative">
              {i === 0 && <span class="absolute -top-2 left-3 z-10 rounded-[4px] bg-nioaque-red px-2 py-0.5 font-sans text-[10px] font-bold uppercase tracking-wider text-white">Mais recente</span>}
              <ColunaCard post={p} clamp={9} />
            </div>
          ))}
        </div>
      </section>
    )}

    {columnists.length > 0 && (
      <section class="mt-12" aria-labelledby="sec-colunistas">
        <h2 id="sec-colunistas" class="font-editorial text-2xl font-semibold tracking-tight text-ink">Colunistas</h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-3">
          {columnists.map((c) => (
            <li>
              <a href={`/colunas/${c.handle}`} class="flex h-full gap-3 rounded-[10px] border border-slate-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md">
                <img src={avatarOf(c)} alt="" width="56" height="56" loading="lazy" referrerpolicy="no-referrer" class="h-14 w-14 shrink-0 rounded-full bg-slate-100 object-cover" />
                <span class="min-w-0">
                  <span class="block font-sans text-sm font-extrabold text-ink">{c.name}</span>
                  <span class="block font-sans text-xs text-ink-muted">@{c.handle} · {countBy(c.id)} coluna{countBy(c.id) === 1 ? '' : 's'}</span>
                  {c.bio && <span class="mt-1 line-clamp-3 block font-sans text-xs leading-relaxed text-ink-soft">{c.bio}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {older.length > 0 && (
      <section class="mt-12" aria-labelledby="sec-anteriores">
        <h2 id="sec-anteriores" class="font-editorial text-2xl font-semibold tracking-tight text-ink">Colunas anteriores</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {older.map((p) => <ColunaCard post={p} clamp={6} />)}
        </div>
      </section>
    )}
  </div>
</MainLayout>
