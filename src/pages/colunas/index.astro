---
import ColunaCard from '../../components/ColunaCard.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { avatarOf, getColumnists, getXPosts } from '../../lib/colunas';

/**
 * /colunas - opinião e análise dos colunistas do X.
 * Cada colunista tem um bloco: mini-perfil e, logo abaixo, as colunas mais recentes dele.
 */
const [columnists, posts] = await Promise.all([getColumnists(Astro.locals), getXPosts(Astro.locals, { limit: 90 })]);
if (columnists.length === 0) return Astro.redirect('/');
const PER = 3;
---

<MainLayout title="Colunas" description="Colunas de opinião e análise de política e economia dos colunistas do O Nioaquense.">
  <div class="container-editorial py-6 sm:py-10">
    <header class="border-b-2 border-nioaque-green pb-4">
      <p class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red-dark">Colunas</p>
      <h1 class="mt-1 text-headline font-semibold leading-tight text-ink">Opinião e análise</h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-soft">
        Os colunistas comentam política, economia e atualidades no X. Cada publicação vira uma coluna aqui, com o post original para ler e compartilhar. As opiniões são dos autores.
      </p>
    </header>

    {columnists.length === 0 ? (
      <p class="mt-10 rounded-[4px] border border-dashed border-line-strong bg-nioaque-white p-10 text-center text-sm text-ink-soft">As primeiras colunas chegam em breve.</p>
    ) : (
      <div class="mt-8 space-y-12">
        {columnists.map((c) => {
          const mine = posts.filter((p) => p.columnist_id === c.id);
          return (
            <section aria-labelledby={`c-${c.handle}`}>
              <div class="flex items-center gap-4">
                <img src={avatarOf(c)} alt="" width="64" height="64" loading="lazy" referrerpolicy="no-referrer" class="h-16 w-16 shrink-0 rounded-full bg-foto-reserva object-cover" />
                <div class="min-w-0 flex-1">
                  <h2 id={`c-${c.handle}`} class="font-sans text-lg font-extrabold leading-tight text-ink">{c.name}</h2>
                  <p class="font-sans text-xs text-ink-muted">@{c.handle}</p>
                  {c.bio && <p class="mt-1 max-w-2xl text-sm leading-relaxed text-ink-soft">{c.bio}</p>}
                </div>
                <a href={`/colunas/${c.handle}`} class="hidden shrink-0 text-sm font-semibold text-nioaque-green-dark hover:underline sm:block">Ver todas →</a>
              </div>
              {mine.length === 0 ? (
                <p class="mt-4 text-sm text-ink-muted">Nenhuma coluna publicada ainda.</p>
              ) : (
                <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {mine.slice(0, PER).map((p) => <ColunaCard post={p} clamp={6} />)}
                </div>
              )}
              <a href={`/colunas/${c.handle}`} class="mt-3 inline-block text-sm font-semibold text-nioaque-green-dark hover:underline sm:hidden">Ver todas →</a>
            </section>
          );
        })}
      </div>
    )}
  </div>
</MainLayout>
