---
import ColunaCard from '../../components/ColunaCard.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { avatarOf, getColumnists, getXPosts } from '../../lib/colunas';

const { handle = '' } = Astro.params;
const columnists = await getColumnists(Astro.locals);
const c = columnists.find((x) => x.handle.toLowerCase() === handle.toLowerCase());
if (!c) return Astro.redirect('/colunas');
const posts = await getXPosts(Astro.locals, { limit: 60, columnistId: c.id });
---

<MainLayout title={`${c.name} · Colunas`} description={c.bio ?? `Colunas de ${c.name}`}>
  <div class="container-editorial py-6 sm:py-10">
    <a href="/colunas" class="text-xs font-semibold text-nioaque-green-dark hover:underline">← Todas as colunas</a>
    <header class="mt-3 flex items-center gap-4 border-b-2 border-nioaque-green pb-5">
      <img src={avatarOf(c)} alt="" width="80" height="80" referrerpolicy="no-referrer" class="h-20 w-20 rounded-full bg-foto-reserva object-cover" />
      <div class="min-w-0">
        <h1 class="text-headline font-semibold leading-tight text-ink">{c.name}</h1>
        <p class="font-sans text-sm text-ink-muted">@{c.handle} · <a href={`https://x.com/${c.handle}`} target="_blank" rel="noopener noreferrer" class="font-semibold text-nioaque-green-dark hover:underline">seguir no X</a></p>
        {c.bio && <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-soft">{c.bio}</p>}
      </div>
    </header>
    {posts.length === 0 ? (
      <p class="mt-8 text-sm text-ink-soft">Nenhuma coluna publicada ainda.</p>
    ) : (
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => <ColunaCard post={p} clamp={6} />)}
      </div>
    )}
  </div>
</MainLayout>
