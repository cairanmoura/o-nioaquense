---
import ToggleSwitch from '../../components/admin/ToggleSwitch.tsx';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/auth';

const session = Astro.locals.adminUser;
if (!session) return Astro.redirect('/admin/login');
if (!isAdmin(session)) return Astro.redirect('/admin');
---

<AdminLayout title="Fontes de Notícias" subtitle="Piloto automático — extração e publicação de fontes RSS">
  <div class="mx-auto max-w-5xl space-y-6">

    {/* Ação em lote: executa a extração agora */}
    <section class="rounded-sm border border-line bg-nioaque-white p-5">
      <header class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red">
            Execução manual
          </h2>
          <p class="mt-1 text-xs leading-relaxed text-ink-muted">
            Dispara a extração de todas as fontes ativas agora. Matérias novas são
            inseridas direto na Home quando a fonte tem "Publicar Direto" ativado.
          </p>
        </div>
        <button
          id="executar-extracao"
          class="rounded-sm bg-nioaque-green px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-nioaque-green-dark flex items-center gap-2"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="shrink-0"
          >
            <path d="m22 2-7 20-4-9-9-4ZM22 2 11 13" />
          </svg>
          Executar Extração Agora
          <span id="msg-extracao" class="ml-2 text-[11px]"></span>
        </button>
      </header>
    </section>

    {/* Lista de fontes com switches de controle */}
    <section class="rounded-sm border border-line bg-nioaque-white p-5">
      <header class="mb-4">
        <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red">
          Fontes cadastradas
        </h2>
        <p class="mt-1 text-xs leading-relaxed text-ink-muted">
          Cada fonte tem switches individuais: Ativo, Publicar Direto (piloto
          automático), Reescrever com IA e Usar Foto Original.
        </p>
      </header>

      <div id="fontes-lista">
        <p class="text-xs text-ink-muted">Carregando fontes…</p>
      </div>
    </section>

    {/* Formulário: adicionar nova fonte */}
    <section class="rounded-sm border border-line bg-nioaque-white p-5">
      <header class="mb-4">
        <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red">
          Adicionar nova fonte
        </h2>
      </header>
      <form id="add-source" class="space-y-3">
        <input
          name="name"
          placeholder="Nome da fonte (ex.: G1 Mato Grosso do Sul)"
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
          required
        />
        <input
          name="rss_url"
          type="url"
          placeholder="URL do RSS ou página inicial (ex.: https://g1.globo.com/ms/mato-grosso-do-sul/)"
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
          required
        />
        <select
          name="source_type"
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
        >
          <option value="rss">RSS (feed XML)</option>
          <option value="html_scraper">Web Scraper (raspagem de HTML — para portais sem RSS)</option>
        </select>
        <select name="ownership" class="w-full rounded-[4px] border border-line bg-editorial px-4 py-3 text-sm" aria-label="Tipo de fonte">
          <option value="private">Portal privado (reescrita total com IA, sempre rascunho)</option>
          <option value="public">Fonte pública / oficial (texto limpo + resumo)</option>
        </select>
        <input
          name="default_category"
          placeholder="Categoria padrão (nioaque, ms, brasil)"
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
        />
        <input
          name="keywords_filter"
          placeholder="Palavras-chave (vírgula): Nioaque, Jardim, BR-060"
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
        />
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <ToggleSwitch
            client:load
            endpoint="/api/admin/news-sources/NEW"
            field="is_active"
            checked={true}
            label="Ativo"
          />
          <ToggleSwitch
            client:load
            endpoint="/api/admin/news-sources/NEW"
            field="auto_publish"
            checked={true}
            label="Publicar Direto"
          />
          <ToggleSwitch
            client:load
            endpoint="/api/admin/news-sources/NEW"
            field="ai_rewrite"
            checked={true}
            label="Reescrever com IA"
          />
          <ToggleSwitch
            client:load
            endpoint="/api/admin/news-sources/NEW"
            field="use_original_image"
            checked={true}
            label="Usar Foto Original"
          />
        </div>
        <button type="submit" class="rounded-sm bg-nioaque-green px-5 py-2.5 text-sm font-semibold text-white hover:bg-nioaque-green-dark w-full sm:w-auto">
          Adicionar fonte
        </button>
      </form>
    </section>

  </div>
</AdminLayout>

<script>
  /* Carrega as fontes via API (cliente, com cookie de sessão) */
  const fontesContainer = document.getElementById('fontes-lista')!;

  async function carregarFontes() {
    try {
      const res = await fetch('/api/admin/news-sources', {
        method: 'GET',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
      });
      if (!res.ok) {
        fontesContainer.innerHTML =
          '<p class="text-xs text-ink-muted">Erro ao carregar fontes. Faça login novamente.</p>';
        return;
      }
      const sources = await res.json();
      renderFontes(sources);
    } catch (err) {
      fontesContainer.innerHTML =
        '<p class="text-xs text-ink-muted">Erro de conexão ao carregar fontes.</p>';
    }
  }

  function renderFontes(sources: any[]) {
    const container = fontesContainer;

    if (!sources || sources.length === 0) {
      container.innerHTML =
        '<p class="text-sm text-ink-muted">Nenhuma fonte cadastrada. Use o formulário abaixo para adicionar.</p>';
      return;
    }

    const ul = document.createElement('ul');
    ul.className = 'space-y-3';

    sources.forEach((s) => {
      const li = document.createElement('li');
      li.className = 'flex items-start justify-between gap-4 rounded-xl border border-line bg-editorial p-4';
      li.innerHTML = `
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold text-ink truncate">
            ${escapeHtml(s.name)}
            <span class="ml-2 inline-block rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide ${
              s.source_type === 'html_scraper'
                ? 'bg-nioaque-red-50 text-nioaque-red-dark'
                : 'bg-nioaque-green-50 text-nioaque-green-dark'
            }">${s.source_type === 'html_scraper' ? 'Scraper' : 'RSS'}</span>
          </p>
          <p class="truncate text-xs text-ink-muted">${escapeHtml(s.rss_url)}</p>
          <p class="mt-1 text-xs text-ink-muted">
            Categoria: ${escapeHtml(s.default_category ?? '—')} · Última busca: ${escapeHtml(s.last_fetched_at ?? 'nunca')}
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
          <!-- Switches serão hidratados pelo ToggleSwitch (client:load) -->
          <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center w-full">
            <ToggleSwitch
              client:load
              endpoint="/api/admin/news-sources/${s.id}"
              field="is_active"
              checked="${Boolean(s.is_active)}"
              label="Ativo"
              description="O robô busca esta fonte"
            />
            <ToggleSwitch
              client:load
              endpoint="/api/admin/news-sources/${s.id}"
              field="auto_publish"
              checked="${Boolean(s.auto_publish)}"
              label="Publicar Direto"
              description="Insere direto na Home (status publicado)"
              highlight="green"
            />
            <ToggleSwitch
              client:load
              endpoint="/api/admin/news-sources/${s.id}"
              field="ai_rewrite"
              checked="${Boolean(s.ai_rewrite)}"
              label="Reescrever com IA"
              description="Título inédito + 3 bullets do Direto ao Ponto"
            />
            <ToggleSwitch
              client:load
              endpoint="/api/admin/news-sources/${s.id}"
              field="use_original_image"
              checked="${Boolean(s.use_original_image)}"
              label="Usar Foto Original"
              description="Extrai a foto real da matéria"
            />
            ${s.keywords_filter ? `<p class="mt-2 text-xs text-ink-muted font-medium w-full">Filtro: ${escapeHtml(s.keywords_filter)}</p>` : ''}
          </div>
        </div>
      `;
      ul.appendChild(li);
    });

    container.innerHTML = '';
    container.appendChild(ul);
  }

  function escapeHtml(text: string) {
    if (!text) return '';
    return String(text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  carregarFontes();

  /* Botão Executar Extração Agora */
  const btn = document.getElementById('executar-extracao') as HTMLButtonElement | null;
  const msg = document.getElementById('msg-extracao') as HTMLElement | null;
  btn?.addEventListener('click', async () => {
    if (btn) btn.disabled = true;
    if (msg) msg.textContent = 'Executando…';
    try {
      // Envia o access token do Supabase logado no header (mais confiavel que cookie no Worker)
      let userToken = '';
      try {
        const { createSupabaseBrowserClient } = await import('../../lib/supabase/client');
        const sb = await createSupabaseBrowserClient();
        if (sb) {
          const { data } = await sb.auth.getSession();
          userToken = data.session?.access_token ?? '';
        }
      } catch {
        /* segue sem token */
      }

      const res = await fetch('/api/cron/extract-news', {
        method: 'POST',
        credentials: 'include',
        headers: {
          'Content-Type': 'application/json',
          ...(userToken ? { 'x-user-token': userToken } : {}),
        },
      });
      const data = await res.json();
      if (res.ok) {
        // Mostra erros por fonte (se houver)
        const comErro = (data.results ?? []).filter(
          (r: any) => r.error || r.ai_error || (r.insert_errors && r.insert_errors.length),
        );
        if (msg) {
          let texto = 'Concluído! ' + (data.inserted ?? 0) + ' inserida(s), ' + (data.skipped ?? 0) + ' ignorada(s).';
          const retidas = (data.results ?? []).reduce((n: number, r: any) => n + (r.held ?? 0), 0);
          if (retidas) texto += ' ' + retidas + ' em rascunho para revisão.';
          if (comErro.length) {
            texto += ' ⚠ ' + comErro.map((r: any) => r.source + ': ' + (r.error ?? r.ai_error ?? r.insert_errors.join('; '))).join(' | ');
          }
          msg.textContent = texto;
          msg.style.color = comErro.length ? '#E60000' : '#008026';
        }
        setTimeout(() => window.location.reload(), comErro.length ? 30000 : 1500);
        if (comErro.length && btn) btn.disabled = false;
      } else {
        if (msg) {
          msg.textContent = 'Erro: ' + (data.error ?? 'Não autorizado');
          msg.style.color = '#E60000';
        }
        if (btn) btn.disabled = false;
      }
    } catch (err) {
      if (msg) {
        msg.textContent = 'Erro de conexão.';
        msg.style.color = '#E60000';
      }
      if (btn) btn.disabled = false;
    }
  });

  /* Formulário: adicionar nova fonte */
  const form = document.getElementById('add-source') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    if (!payload.keywords_filter) delete payload.keywords_filter;
    if (!payload.default_category) delete payload.default_category;
    const res = await fetch('/api/admin/news-sources', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) window.location.reload();
    else alert('Erro ao adicionar fonte');
  });
</script>