---
import ToggleSwitch from '../../components/admin/ToggleSwitch.tsx';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/auth';

const session = Astro.locals.adminUser;
if (!session) return Astro.redirect('/admin/login');
if (!isAdmin(session)) return Astro.redirect('/admin');
---

<AdminLayout title="Fontes de Notícias" subtitle="Piloto automático — extração e publicação de fontes RSS">
  <div class="mx-auto max-w-5xl space-y-6">

    {/* Ação em lote: executa a extração agora */}
    <section class="rounded-sm border border-line bg-nioaque-white p-5">
      <header class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red-dark">
            Execução manual
          </h2>
          <p class="mt-1 text-xs leading-relaxed text-ink-muted">
            Põe todas as fontes ativas na fila de extração. Cada matéria é processada separadamente em segundo plano, sem o teto de 5 por rodada. Matérias novas vão direto ao ar ou para rascunho, conforme a regra de cada fonte.</p>
        </div>
        <button
          id="executar-extracao"
          class="rounded-sm bg-nioaque-green px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-nioaque-green-dark flex items-center gap-2"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="shrink-0"
          >
            <path d="m22 2-7 20-4-9-9-4ZM22 2 11 13" />
          </svg>
          Extrair agora
        </button>
        <button id="povoar-mes" type="button" class="rounded-[4px] border border-nioaque-green px-4 py-2.5 text-sm font-semibold text-nioaque-green-dark hover:bg-nioaque-green-50">Povoar último mês</button>
        <p id="msg-extracao" class="w-full text-xs font-medium leading-relaxed" aria-live="polite"></p>
      </header>
    </section>

    {/* Lista de fontes com switches de controle */}
    <section class="rounded-sm border border-line bg-nioaque-white p-5">
      <header class="mb-4">
        <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red-dark">
          Fontes cadastradas
        </h2>
        <p class="mt-1 text-xs leading-relaxed text-ink-muted">
          Cada fonte tem switches individuais: Ativo, Publicar Direto (piloto
          automático), Reescrever com IA e Usar Foto Original.
        </p>
      </header>

      <div id="fontes-lista">
        <p class="text-xs text-ink-muted">Carregando fontes…</p>
      </div>
    </section>

    {/* Formulário: adicionar nova fonte */}
    <section class="rounded-sm border border-line bg-nioaque-white p-5">
      <header class="mb-4">
        <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red-dark">
          Adicionar nova fonte
        </h2>
      </header>
      <form id="add-source" class="space-y-3">
        <input
          name="name"
          placeholder="Nome da fonte (ex.: G1 Mato Grosso do Sul)"
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
          required
        />
        <input
          name="rss_url"
          type="url"
          placeholder="URL do RSS ou página inicial (ex.: https://g1.globo.com/ms/mato-grosso-do-sul/)"
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
          required
        />
        <select
          name="source_type"
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
        >
          <option value="rss">RSS (feed XML)</option>
          <option value="html_scraper">Web Scraper (raspagem de HTML — para portais sem RSS)</option>
        </select>
        <select name="ownership" class="w-full rounded-[4px] border border-line bg-editorial px-4 py-3 text-sm" aria-label="Tipo de fonte">
          <option value="private">Portal privado (reescrita total com IA, sempre rascunho)</option>
          <option value="public">Fonte pública / oficial (texto limpo + resumo)</option>
        </select>
        <input
          name="default_category"
          placeholder="Categoria padrão (nioaque, ms, brasil)"
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
        />
        <input
          name="keywords_filter"
          placeholder="Palavras-chave (vírgula): Nioaque, Jardim, BR-060"
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
        />
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <ToggleSwitch
            client:load
            endpoint="/api/admin/news-sources/NEW"
            field="is_active"
            checked={true}
            label="Ativo"
          />
          <ToggleSwitch
            client:load
            endpoint="/api/admin/news-sources/NEW"
            field="auto_publish"
            checked={true}
            label="Publicar Direto"
          />
          <ToggleSwitch
            client:load
            endpoint="/api/admin/news-sources/NEW"
            field="ai_rewrite"
            checked={true}
            label="Reescrever com IA"
          />
          <ToggleSwitch
            client:load
            endpoint="/api/admin/news-sources/NEW"
            field="use_original_image"
            checked={true}
            label="Usar Foto Original"
          />
        </div>
        <button type="submit" class="rounded-sm bg-nioaque-green px-5 py-2.5 text-sm font-semibold text-white hover:bg-nioaque-green-dark w-full sm:w-auto">
          Adicionar fonte
        </button>
      </form>
    </section>

  </div>
</AdminLayout>

<script>
  /* Carrega as fontes via API (cliente, com cookie de sessão) */
  const fontesContainer = document.getElementById('fontes-lista')!;

  async function carregarFontes() {
    try {
      const res = await fetch('/api/admin/news-sources', {
        method: 'GET',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
      });
      if (!res.ok) {
        fontesContainer.innerHTML =
          '<p class="text-xs text-ink-muted">Erro ao carregar fontes. Faça login novamente.</p>';
        return;
      }
      const sources = await res.json();
      renderFontes(sources);
    } catch (err) {
      fontesContainer.innerHTML =
        '<p class="text-xs text-ink-muted">Erro de conexão ao carregar fontes.</p>';
    }
  }

  const inputCls = 'mt-1 w-full rounded-[4px] border border-pedra bg-white px-3 py-2 text-sm';
  const labelCls = 'block text-xs font-bold text-ink';

  function toggleHtml(id: string, field: string, checked: boolean, label: string, hint: string) {
    return `
      <label class="flex cursor-pointer items-start gap-2 rounded-[4px] border border-pedra bg-white px-3 py-2 text-xs">
        <input type="checkbox" data-toggle="${field}" data-id="${id}" ${checked ? 'checked' : ''} class="mt-0.5 h-4 w-4 accent-[#166A34]" />
        <span><span class="block font-bold text-ink">${label}</span><span class="text-ink-muted">${hint}</span></span>
      </label>`;
  }

  function renderFontes(sources: any[]) {
    const container = fontesContainer;

    if (!sources || sources.length === 0) {
      container.innerHTML =
        '<p class="text-sm text-ink-muted">Nenhuma fonte cadastrada. Use o formulário abaixo para adicionar.</p>';
      return;
    }

    const ul = document.createElement('ul');
    ul.className = 'space-y-3';

    sources.forEach((s) => {
      const li = document.createElement('li');
      li.dataset.sourceId = s.id;
      li.className = 'rounded-xl border border-line bg-editorial p-4';
      li.innerHTML = `
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-ink">
              ${escapeHtml(s.name)}
              <span class="ml-2 inline-block rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide ${
                s.source_type === 'html_scraper'
                  ? 'bg-nioaque-red-50 text-nioaque-red-dark'
                  : 'bg-nioaque-green-50 text-nioaque-green-dark'
              }">${s.source_type === 'html_scraper' ? 'Scraper' : 'RSS'}</span>
              <span class="ml-1 inline-block rounded-full bg-pedra px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-ink">${s.ownership === 'public' ? 'Fonte pública' : 'Portal privado'}</span>
            </p>
            <p class="truncate text-xs text-ink-muted">${escapeHtml(s.rss_url)}</p>
            <p class="mt-1 text-xs text-ink-muted">
              Tema padrão: ${escapeHtml(s.default_category ?? '—')} · Local padrão: ${escapeHtml(s.default_scope ?? 'automático')} · Última busca: ${escapeHtml(s.last_fetched_at ?? 'nunca')}
            </p>
            ${s.keywords_filter ? `<p class="mt-1 text-xs font-medium text-ink-muted">Filtro: ${escapeHtml(s.keywords_filter)}</p>` : ''}
            ${s.last_message ? `<p class="mt-1 text-xs ${s.last_status === 'erro' ? 'text-nioaque-red-dark' : 'text-ink-muted'}">${escapeHtml(s.last_message)}</p>` : ''}
          </div>
          <div class="flex shrink-0 gap-2 text-xs font-semibold">
            <button type="button" data-edit="${s.id}" class="rounded-[4px] border border-pedra bg-white px-3 py-1.5 text-ink hover:border-nioaque-green">Editar</button>
            <button type="button" data-del="${s.id}" data-name="${escapeHtml(s.name)}" class="rounded-[4px] border border-nioaque-red px-3 py-1.5 text-nioaque-red-dark hover:bg-nioaque-red hover:text-white">Excluir</button>
          </div>
        </div>

        <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
          ${toggleHtml(s.id, 'is_active', Boolean(s.is_active), 'Ativo', 'O robô busca esta fonte')}
          ${toggleHtml(s.id, 'auto_publish', Boolean(s.auto_publish), 'Publicar direto', 'Vai ao ar sem revisão (fonte pública)')}
          ${toggleHtml(s.id, 'ai_rewrite', Boolean(s.ai_rewrite), 'Reescrever com IA', 'Título inédito + resumo')}
          ${toggleHtml(s.id, 'use_original_image', Boolean(s.use_original_image), 'Foto original', 'Extrai a foto real da matéria')}
        </div>

        <form data-form="${s.id}" hidden class="mt-4 grid gap-3 border-t border-line pt-4 sm:grid-cols-2">
          <label class="${labelCls}">Nome<input name="name" value="${escapeHtml(s.name)}" required class="${inputCls}" /></label>
          <label class="${labelCls}">URL do feed / página<input name="rss_url" type="url" value="${escapeHtml(s.rss_url)}" required class="${inputCls}" /></label>
          <label class="${labelCls}">Tipo
            <select name="source_type" class="${inputCls}">
              <option value="rss" ${s.source_type !== 'html_scraper' ? 'selected' : ''}>RSS / Atom / News</option>
              <option value="html_scraper" ${s.source_type === 'html_scraper' ? 'selected' : ''}>Scraper (página inicial)</option>
            </select>
          </label>
          <label class="${labelCls}">Origem do texto
            <select name="ownership" class="${inputCls}">
              <option value="private" ${s.ownership !== 'public' ? 'selected' : ''}>Portal privado (reescrita total, sempre rascunho)</option>
              <option value="public" ${s.ownership === 'public' ? 'selected' : ''}>Fonte pública / governo (pode publicar direto)</option>
            </select>
          </label>
          <label class="${labelCls}">Filtro de palavras (vírgula)<input name="keywords_filter" value="${escapeHtml(s.keywords_filter ?? '')}" placeholder="nioaque, jardim, br-060" class="${inputCls}" /></label>
          <label class="${labelCls}">Tema padrão (só se a IA não definir)<input name="default_category" value="${escapeHtml(s.default_category ?? '')}" class="${inputCls}" /></label>
          <label class="${labelCls}">Local padrão (só se nada indicar o local)
            <select name="default_scope" class="${inputCls}">
              ${['', 'nioaque', 'regiao', 'ms', 'brasil', 'mundo'].map((v) => `<option value="${v}" ${(s.default_scope ?? '') === v ? 'selected' : ''}>${({ '': 'Automático (recomendado)', nioaque: 'Nioaque', regiao: 'Região', ms: 'Mato Grosso do Sul', brasil: 'Brasil', mundo: 'Mundo' } as any)[v]}</option>`).join('')}
            </select>
          </label>
          <div class="flex items-end gap-2 sm:col-span-2">
            <button type="submit" class="rounded-[4px] bg-nioaque-green px-4 py-2 text-sm font-semibold text-white hover:bg-nioaque-green-dark">Salvar alterações</button>
            <button type="button" data-cancel="${s.id}" class="rounded-[4px] border border-pedra px-4 py-2 text-sm font-semibold text-ink">Cancelar</button>
            <span data-msg="${s.id}" class="text-xs text-ink-muted" role="status"></span>
          </div>
        </form>
      `;
      ul.appendChild(li);
    });

    container.innerHTML = '';
    container.appendChild(ul);
  }

  /* Editar / salvar / excluir / chaves (delegação de eventos) */
  const api = (id: string, method: string, body?: unknown) =>
    fetch('/api/admin/news-sources/' + id, {
      method,
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });

  fontesContainer.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const edit = t.closest<HTMLElement>('[data-edit]');
    if (edit) {
      const f = fontesContainer.querySelector<HTMLFormElement>(`form[data-form="${edit.dataset.edit}"]`);
      if (f) f.hidden = !f.hidden;
      return;
    }
    const cancel = t.closest<HTMLElement>('[data-cancel]');
    if (cancel) {
      const f = fontesContainer.querySelector<HTMLFormElement>(`form[data-form="${cancel.dataset.cancel}"]`);
      if (f) f.hidden = true;
      return;
    }
    const del = t.closest<HTMLElement>('[data-del]');
    if (del) {
      if (!confirm(`Excluir a fonte "${del.dataset.name}"?\n\nAs matérias já importadas continuam no site.`)) return;
      const res = await api(del.dataset.del!, 'DELETE');
      if (res.ok) carregarFontes();
      else alert((await res.json().catch(() => ({}))).error ?? 'Falha ao excluir');
    }
  });

  fontesContainer.addEventListener('change', async (e) => {
    const box = e.target as HTMLInputElement;
    if (!box.dataset.toggle) return;
    box.disabled = true;
    const res = await api(box.dataset.id!, 'PATCH', { [box.dataset.toggle]: box.checked });
    box.disabled = false;
    if (!res.ok) {
      box.checked = !box.checked;
      alert((await res.json().catch(() => ({}))).error ?? 'Falha ao salvar');
    }
  });

  fontesContainer.addEventListener('submit', async (e) => {
    const form = e.target as HTMLFormElement;
    if (!form.dataset.form) return;
    e.preventDefault();
    const id = form.dataset.form;
    const msgEl = form.querySelector<HTMLElement>(`[data-msg="${id}"]`);
    const fd = new FormData(form);
    const body: Record<string, unknown> = {};
    fd.forEach((v, k) => (body[k] = String(v).trim() || null));
    if (msgEl) msgEl.textContent = 'Salvando…';
    const res = await api(id, 'PATCH', body);
    if (res.ok) carregarFontes();
    else if (msgEl) msgEl.textContent = (await res.json().catch(() => ({}))).error ?? 'Falha ao salvar';
  });

  function escapeHtml(text: string) {
    if (!text) return '';
    return String(text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  carregarFontes();

  /* Extrair agora: um clique enfileira a varredura inteira. O trabalho roda em
   * segundo plano (Cloudflare Queues, uma materia por vez); a lista de fontes
   * e' recarregada de tempos em tempos para mostrar o andamento. */
  const btn = document.getElementById('executar-extracao') as HTMLButtonElement | null;
  const msg = document.getElementById('msg-extracao') as HTMLElement | null;
  const show = (text: string, bad = false) => {
    if (!msg) return;
    msg.textContent = text;
    msg.style.color = bad ? '#B80000' : '#006B1F';
  };

  async function disparar(btn: HTMLButtonElement, backfill: boolean) {
    btn.disabled = true;
    show(backfill ? 'Enfileirando o povoamento do último mês…' : 'Enfileirando…');

    let userToken = '';
    try {
      const { createSupabaseBrowserClient } = await import('../../lib/supabase/client');
      const sb = await createSupabaseBrowserClient();
      if (sb) {
        const { data } = await sb.auth.getSession();
        userToken = data.session?.access_token ?? '';
      }
    } catch {
      /* segue sem token */
    }

    try {
      const res = await fetch('/api/cron/extract-news' + (backfill ? '?backfill=1' : ''), {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json', ...(userToken ? { 'x-user-token': userToken } : {}) },
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        show(data.error ?? 'Erro ' + res.status, true);
        btn.disabled = false;
        return;
      }
      if (data.queued) {
        show('Varredura enfileirada. As matérias chegam aos poucos (cerca de 1 a 3 minutos); o "Última busca" de cada fonte abaixo vai se atualizando.');
        // acompanha por ~3 minutos
        let n = 0;
        const timer = setInterval(() => {
          carregarFontes();
          if (++n >= 12) {
            clearInterval(timer);
            btn.disabled = false;
          }
        }, 15000);
        return;
      }
      show('Concluído: ' + (data.inserted ?? 0) + ' matéria(s) inseridas.');
      carregarFontes();
    } catch {
      show('Erro de conexão.', true);
    }
    btn.disabled = false;
  }
  btn?.addEventListener('click', () => disparar(btn, false));
  const btnMes = document.getElementById('povoar-mes') as HTMLButtonElement | null;
  btnMes?.addEventListener('click', () => {
    if (confirm('Povoar o site com as matérias dos últimos 30 dias de todas as fontes? Isso usa bastante a IA gratuita e pode levar de 10 a 30 minutos. As matérias entram com a data original do veículo.')) disparar(btnMes, true);
  });

  /* Formulário: adicionar nova fonte */
  const form = document.getElementById('add-source') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    if (!payload.keywords_filter) delete payload.keywords_filter;
    if (!payload.default_category) delete payload.default_category;
    const res = await fetch('/api/admin/news-sources', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) window.location.reload();
    else alert('Erro ao adicionar fonte');
  });
</script>