---
import Icon from '../../components/admin/Icon.astro';
import ToggleSwitch from '../../components/admin/ToggleSwitch.tsx';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminDashboard } from '../../lib/admin';
import { isAdmin } from '../../lib/auth';
import { formatNumber } from '../../lib/format';

const session = Astro.locals.adminUser;

if (!session) {
  return Astro.redirect('/admin/login');
}

if (!isAdmin(session)) {
  return Astro.redirect('/admin');
}

const dashboard = await getAdminDashboard(Astro.locals, session);

const SLOT_LABEL: Record<string, string> = {
  header_billboard: 'Topo do portal',
  home_middle: 'Meio da home',
  article_inline: 'Dentro da materia',
  sidebar: 'Barra lateral',
  daily_deal: 'Destaque',
};

const SLOT_OPTIONS = Object.entries(SLOT_LABEL);

const formatPeriod = (ad: (typeof dashboard.ads)[number]) => {
  const start = ad.starts_at ? ad.starts_at.slice(0, 10).split('-').reverse().join('/') : 'imediato';
  const end = ad.ends_at ? ad.ends_at.slice(0, 10).split('-').reverse().join('/') : 'sem data';
  return `${start} a ${end}`;
};

const situation = (ad: (typeof dashboard.ads)[number]) => {
  const now = new Date().toISOString();
  if (ad.starts_at && ad.starts_at > now) return 'agendado';
  if (ad.ends_at && ad.ends_at < now) return 'encerrado';
  return ad.active ? 'no ar' : 'pausado';
};
---

<AdminLayout
  title="Anuncios Locais"
  subtitle={`${dashboard.counts.activeAds} no ar de ${dashboard.ads.length}`}
>
  <div class="mx-auto max-w-3xl space-y-6">
    {/* ---------------------- Relatorio de cliques ---------------------- */}
    <section class="rounded-2xl border border-line bg-nioaque-white p-5">
      <header class="flex items-center gap-2">
        <Icon name="megaphone" size={16} class="text-nioaque-red" />
        <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-green">
          Relatorio de cliques
        </h2>
      </header>
      <p class="mt-1 text-xs leading-relaxed text-ink-muted">
        Numero de cliques nos botoes "Chamar no WhatsApp". E o numero para apresentar ao
        comerciante de Nioaque.
      </p>

      <div class="mt-4 grid grid-cols-3 gap-3">
        <div class="rounded-xl bg-editorial p-3 text-center">
          <p class="font-editorial text-2xl font-semibold text-ink">
            {formatNumber(dashboard.adReport.totalClicks)}
          </p>
          <p class="mt-0.5 text-[10px] font-bold uppercase tracking-[0.12em] text-ink-muted">
            Cliques totais
          </p>
        </div>
        <div class="rounded-xl bg-editorial p-3 text-center">
          <p class="font-editorial text-2xl font-semibold text-ink">
            {dashboard.adReport.activeAds}
          </p>
          <p class="mt-0.5 text-[10px] font-bold uppercase tracking-[0.12em] text-ink-muted">
            No ar
          </p>
        </div>
        <div class="rounded-xl bg-editorial p-3 text-center">
          <p class="font-editorial text-2xl font-semibold text-ink">
            {dashboard.adReport.byOfferType.daily_deal}
          </p>
          <p class="mt-0.5 text-[10px] font-bold uppercase tracking-[0.12em] text-ink-muted">
            Ofertas do dia
          </p>
        </div>
      </div>

      {
        dashboard.adReport.top.length > 0 && (
          <ul class="mt-4 divide-y divide-line border-t border-line">
            {dashboard.adReport.top.map((ad, index) => (
              <li class="flex items-center gap-3 py-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-nioaque-green-50 text-[11px] font-bold text-nioaque-green-dark">
                  {index + 1}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-semibold text-ink">
                    {ad.client_name}
                  </span>
                  <span class="block truncate text-xs text-ink-muted">{ad.title}</span>
                </span>
                <span class="shrink-0 font-editorial text-lg font-semibold text-nioaque-green">
                  {formatNumber(ad.clicks_count)}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {/* ---------------------- Anuncios cadastrados ---------------------- */}
    <section class="space-y-4">
      <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-ink-muted">
        Anuncios cadastrados
      </h2>

      {
        dashboard.ads.map((ad) => (
          <article class="rounded-2xl border border-line bg-nioaque-white p-4">
            <div class="flex flex-wrap items-start gap-3">
              {ad.image_url && (
                <img
                  src={ad.image_url}
                  alt=""
                  width="120"
                  height="68"
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-28 shrink-0 rounded-lg object-cover ring-1 ring-line"
                />
              )}

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span
                    class:list={[
                      'pill-scope',
                      ad.offer_type === 'daily_deal'
                        ? 'bg-nioaque-red-50 text-nioaque-red-dark'
                        : 'bg-nioaque-green-50 text-nioaque-green-dark',
                    ]}
                  >
                    {ad.offer_type === 'daily_deal' ? 'Oferta do dia' : 'Banner'}
                  </span>
                  <span class="pill-scope bg-ink/10 text-ink-soft">
                    {SLOT_LABEL[ad.slot_position] ?? ad.slot_position}
                  </span>
                  <span
                    class:list={[
                      'pill-scope',
                      situation(ad) === 'no ar'
                        ? 'bg-nioaque-green text-white'
                        : situation(ad) === 'pausado'
                          ? 'bg-amber-100 text-amber-900'
                          : 'bg-ink/10 text-ink-soft',
                    ]}
                  >
                    {situation(ad)}
                  </span>
                </div>

                <h3 class="mt-2 font-editorial text-lg font-semibold leading-snug text-ink">
                  {ad.client_name}
                </h3>
                <p class="mt-0.5 text-sm leading-relaxed text-ink-soft">{ad.title}</p>

                <dl class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1.5 text-xs">
                  <div>
                    <dt class="font-bold uppercase tracking-[0.1em] text-ink-muted">Cliques</dt>
                    <dd class="font-editorial text-base font-semibold text-nioaque-green">
                      {formatNumber(ad.clicks_count)}
                    </dd>
                  </div>
                  <div>
                    <dt class="font-bold uppercase tracking-[0.1em] text-ink-muted">Periodo</dt>
                    <dd class="mt-0.5 text-ink">{formatPeriod(ad)}</dd>
                  </div>
                  <div>
                    <dt class="font-bold uppercase tracking-[0.1em] text-ink-muted">WhatsApp</dt>
                    <dd class="mt-0.5 text-ink">{ad.whatsapp_number ?? '—'}</dd>
                  </div>
                  <div>
                    <dt class="font-bold uppercase tracking-[0.1em] text-ink-muted">Condicao</dt>
                    <dd class="mt-0.5 text-ink">{ad.price_label ?? '—'}</dd>
                  </div>
                </dl>
              </div>
            </div>

            <div class="mt-4 rounded-xl bg-editorial p-4">
              <ToggleSwitch
                client:visible
                endpoint={`/api/admin/ads/${ad.id}`}
                field="active"
                checked={ad.active}
                label="Anuncio no ar"
                description="Desligado, o anuncio some do portal mas continua cadastrado e mantendo os cliques ja contados."
              />
            </div>
          </article>
        ))
      }
    </section>

    {/* ---------------------- Novo anuncio ---------------------- */}
    <section class="rounded-2xl border border-line bg-nioaque-white p-5">
      <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-green">
        Cadastrar anuncio
      </h2>
      <p class="mt-1 text-xs leading-relaxed text-ink-muted">
        Banners e "Ofertas do Dia em Nioaque" para o comercio local.
      </p>

      <form method="POST" action="/api/admin/ads" class="mt-4 space-y-4">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
              Nome do comercio
            </span>
            <input
              type="text"
              name="client_name"
              required
              placeholder="Ex.: Mercado Nilo"
              class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-nioaque-green focus:outline-none"
            />
          </label>

          <label class="block">
            <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
              WhatsApp do lojista
            </span>
            <input
              type="tel"
              name="whatsapp_number"
              placeholder="5567999990000"
              class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-nioaque-green focus:outline-none"
            />
          </label>
        </div>

        <label class="block">
          <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
            Texto do anuncio
          </span>
          <input
            type="text"
            name="title"
            required
            placeholder="Ex.: 20% de desconto em cesta basica nesta semana"
            class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-nioaque-green focus:outline-none"
          />
        </label>

        <div class="grid gap-4 sm:grid-cols-3">
          <label class="block">
            <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
              Tipo
            </span>
            <select
              name="offer_type"
              class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink focus:border-nioaque-green focus:outline-none"
            >
              <option value="banner">Banner</option>
              <option value="daily_deal">Oferta do Dia</option>
            </select>
          </label>

          <label class="block">
            <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
              Posicao no site
            </span>
            <select
              name="slot_position"
              class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink focus:border-nioaque-green focus:outline-none"
            >
              {SLOT_OPTIONS.map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </label>

          <label class="block">
            <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
              Preco / condicao
            </span>
            <input
              type="text"
              name="price_label"
              placeholder="Ex.: R$ 39,90"
              class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-nioaque-green focus:outline-none"
            />
          </label>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
              Foto / arte (URL)
            </span>
            <input
              type="text"
              name="image_url"
              placeholder="/covers/ad-01.svg"
              class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-nioaque-green focus:outline-none"
            />
          </label>

          <label class="block">
            <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
              Link de destino
            </span>
            <input
              type="text"
              name="target_url"
              placeholder="https://..."
              class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-nioaque-green focus:outline-none"
            />
          </label>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
              Inicio da veiculacao
            </span>
            <input
              type="date"
              name="starts_at"
              class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink focus:border-nioaque-green focus:outline-none"
            />
          </label>

          <label class="block">
            <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
              Fim da veiculacao
            </span>
            <input
              type="date"
              name="ends_at"
              class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink focus:border-nioaque-green focus:outline-none"
            />
          </label>
        </div>

        <label class="block">
          <span class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-ink-muted">
            Observacao interna
          </span>
          <input
            type="text"
            name="notes"
            placeholder="Contrato, forma de pagamento, material entregue..."
            class="mt-1.5 w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm text-ink placeholder:text-ink-muted/60 focus:border-nioaque-green focus:outline-none"
          />
        </label>

        <button
          type="submit"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-nioaque-green px-5 py-3.5 text-xs font-bold uppercase tracking-[0.12em] text-white transition-colors hover:bg-nioaque-green-dark"
        >
          <Icon name="megaphone" size={14} />
          Cadastrar anuncio
        </button>
      </form>
    </section>
  </div>
</AdminLayout>
