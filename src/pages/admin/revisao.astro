---
import ActionButton from '../../components/admin/ActionButton.tsx';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminDashboard } from '../../lib/admin';
import { isAdmin } from '../../lib/auth';
import { formatDateTime } from '../../lib/format';
import { SCOPE_LABEL } from '../../lib/types';

const session = Astro.locals.adminUser;

if (!session) {
  return Astro.redirect('/admin/login');
}

if (!isAdmin(session)) {
  return Astro.redirect('/admin');
}

const dashboard = await getAdminDashboard(Astro.locals, session);
---

<AdminLayout
  title="Fila de Revisao"
  subtitle={`${dashboard.pendingArticles.length} texto(s) aguardando`}
>
  <div class="mx-auto max-w-3xl">
    {
      dashboard.pendingArticles.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-line-strong bg-nioaque-white p-10 text-center">
          <p class="font-editorial text-xl font-semibold text-ink">Fila vazia</p>
          <p class="mt-1.5 text-sm text-ink-soft">
            Nenhum texto aguardando revisao. Quando um colunista enviar, ele aparece aqui.
          </p>
        </div>
      ) : (
        <ul class="space-y-4">
          {dashboard.pendingArticles.map((article) => {
            const author = dashboard.authors.get(article.author_id);

            return (
              <li class="rounded-2xl border border-line bg-nioaque-white p-5">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="pill-scope bg-nioaque-red-50 text-nioaque-red-dark">
                    {SCOPE_LABEL[article.scope]}
                  </span>
                  {article.category_label && (
                    <span class="pill-scope bg-ink/10 text-ink-soft">{article.category_label}</span>
                  )}
                </div>

                <h2 class="mt-3 font-editorial text-xl font-semibold leading-snug text-ink">
                  {article.title}
                </h2>

                {article.subtitle && (
                  <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{article.subtitle}</p>
                )}

                {article.summary_bullets.length > 0 && (
                  <ul class="mt-4 space-y-2 rounded-xl bg-editorial p-4">
                    {article.summary_bullets.map((bullet) => (
                      <li class="flex gap-3 text-sm text-ink">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-nioaque-red" />
                        {bullet}
                      </li>
                    ))}
                  </ul>
                )}

                <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4">
                  <div class="flex items-center gap-2.5">
                    {author?.avatar_url && (
                      <img
                        src={author.avatar_url}
                        alt=""
                        width="32"
                        height="32"
                        loading="lazy"
                        decoding="async"
                        class="h-8 w-8 rounded-full object-cover"
                      />
                    )}
                    <div>
                      <p class="text-xs font-semibold text-ink">
                        {author?.column_name ?? author?.full_name ?? 'Colaborador'}
                      </p>
                      <p class="text-[10px] uppercase tracking-[0.1em] text-ink-muted">
                        Enviado em {formatDateTime(article.created_at)}
                      </p>
                    </div>
                  </div>

                  <div class="flex flex-wrap gap-2">
                    <a
                      href={`/admin/artigos/${article.id}`}
                      class="inline-flex items-center gap-1.5 rounded-full border border-line px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.1em] text-ink-soft transition-colors hover:border-nioaque-green hover:text-nioaque-green"
                    >
                      Ler e editar
                    </a>
                    <ActionButton
                      client:load
                      endpoint={`/api/admin/articles/${article.id}`}
                      payload={{ action: 'publish' }}
                      label="Aprovar e publicar"
                      shortLabel="Aprovar"
                      icon="check"
                      variant="success"
                    />
                    <ActionButton
                      client:load
                      endpoint={`/api/admin/articles/${article.id}`}
                      payload={{ action: 'draft' }}
                      label="Devolver"
                      shortLabel="Devolver"
                      icon="x"
                      variant="ghost"
                      confirm="Devolver o texto para rascunho?"
                    />
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</AdminLayout>
