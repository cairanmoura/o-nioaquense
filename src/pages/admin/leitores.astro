---
import ActionButton from '../../components/admin/ActionButton.tsx';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminDashboard } from '../../lib/admin';
import { isAdmin } from '../../lib/auth';
import { formatDateTime } from '../../lib/format';

const session = Astro.locals.adminUser;

if (!session) {
  return Astro.redirect('/admin/login');
}

if (!isAdmin(session)) {
  return Astro.redirect('/admin');
}

const dashboard = await getAdminDashboard(Astro.locals, session);

const STATUS_LABEL: Record<string, string> = {
  pending: 'Nova',
  reviewed: 'Em analise',
  converted_to_article: 'Virou materia',
  archived: 'Arquivada',
};

const STATUS_CLASS: Record<string, string> = {
  pending: 'bg-nioaque-red-50 text-nioaque-red-dark',
  reviewed: 'bg-amber-100 text-amber-900',
  converted_to_article: 'bg-nioaque-green-50 text-nioaque-green-dark',
  archived: 'bg-ink/10 text-ink-soft',
};

const pending = dashboard.submissions.filter((item) => item.status === 'pending');
const handled = dashboard.submissions.filter((item) => item.status !== 'pending');
---

<AdminLayout
  title="Boca no Trombone"
  subtitle={`${pending.length} relato(s) novo(s) de moradores`}
>
  <div class="mx-auto max-w-3xl space-y-6">
    {/* Relatos novos */}
    {
      pending.length > 0 && (
        <section aria-labelledby="relatos-novos">
          <h2 id="relatos-novos" class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red">
            Relatos novos
          </h2>

          <ul class="mt-3 space-y-4">
            {pending.map((submission) => (
              <li class="overflow-hidden rounded-2xl border border-line bg-nioaque-white">
                <div class="flex flex-wrap items-center gap-2 border-b border-line bg-editorial px-4 py-2.5">
                  <span class:list={['pill-scope', STATUS_CLASS[submission.status]]}>
                    {STATUS_LABEL[submission.status]}
                  </span>
                  {submission.neighborhood && (
                    <span class="pill-scope bg-nioaque-green-50 text-nioaque-green-dark">
                      {submission.neighborhood}
                    </span>
                  )}
                  <span class="ml-auto text-[11px] font-semibold uppercase tracking-[0.1em] text-ink-muted">
                    {formatDateTime(submission.created_at)}
                  </span>
                </div>

                <div class="p-4">
                  <p class="text-[0.9375rem] leading-relaxed text-ink">{submission.message}</p>

                  <p class="mt-3 text-xs font-semibold text-ink-muted">
                    {submission.sender_name} &middot; {submission.sender_whatsapp}
                  </p>

                  {/* Fotos enviadas pelo leitor */}
                  {submission.media_urls.length > 0 && (
                    <div class="mt-3">
                      <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.14em] text-ink-muted">
                        Fotos do morador
                      </p>
                      <div class="flex flex-wrap gap-2">
                        {submission.media_urls.map((url) => (
                          <a href={url} target="_blank" rel="noopener noreferrer" class="block">
                            <img
                              src={url}
                              alt="Foto enviada pelo leitor"
                              loading="lazy"
                              decoding="async"
                              class="h-28 w-40 rounded-lg object-cover ring-1 ring-line"
                            />
                          </a>
                        ))}
                      </div>
                    </div>
                  )}

                  <div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-4">
                    <ActionButton
                      client:visible
                      endpoint={`/api/admin/submissions/${submission.id}`}
                      payload={{ action: 'to_draft' }}
                      label="Transformar em Rascunho de Materia"
                      shortLabel="Virar rascunho"
                      icon="pen"
                      variant="primary"
                    />
                    <a
                      href={`https://wa.me/${submission.sender_whatsapp.replace(/\D/g, '')}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-full bg-[#25D366] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.1em] text-white transition-opacity hover:opacity-90"
                    >
                      Responder no WhatsApp
                    </a>
                    <ActionButton
                      client:visible
                      endpoint={`/api/admin/submissions/${submission.id}`}
                      payload={{ status: 'archived' }}
                      label="Arquivar"
                      shortLabel="Arquivar"
                      icon="trash"
                      variant="ghost"
                    />
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Ja tratados */}
    {
      handled.length > 0 && (
        <section aria-labelledby="relatos-tratados">
          <h2 id="relatos-tratados" class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-ink-muted">
            Ja tratados
          </h2>

          <ul class="mt-3 divide-y divide-line rounded-2xl border border-line bg-nioaque-white px-4">
            {handled.map((submission) => (
              <li class="flex items-start gap-3 py-4">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class:list={['pill-scope', STATUS_CLASS[submission.status]]}>
                      {STATUS_LABEL[submission.status]}
                    </span>
                    {submission.neighborhood && (
                      <span class="text-[11px] font-semibold text-ink-muted">
                        {submission.neighborhood}
                      </span>
                    )}
                  </div>
                  <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink-soft">
                    {submission.message}
                  </p>
                  <p class="mt-1 text-[11px] text-ink-muted">
                    {submission.sender_name} &middot; {formatDateTime(submission.created_at)}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      dashboard.submissions.length === 0 && (
        <div class="rounded-2xl border border-dashed border-line-strong bg-nioaque-white p-10 text-center">
          <p class="font-editorial text-xl font-semibold text-ink">Nenhum relato ainda</p>
          <p class="mt-1.5 text-sm text-ink-soft">
            As pistas enviadas pelo formulario ou pelo WhatsApp aparecem aqui.
          </p>
        </div>
      )
    }
  </div>
</AdminLayout>
