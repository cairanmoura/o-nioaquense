---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/auth';

const session = Astro.locals.adminUser;
if (!session) return Astro.redirect('/admin/login');
if (!isAdmin(session)) return Astro.redirect('/admin');

const inp = 'mt-1 w-full rounded-[4px] border border-slate-300 bg-white px-3 py-2.5 text-sm';
---

<AdminLayout title="Colunas do X" subtitle="Cada post de um colunista vira uma coluna no portal">
  <div class="mx-auto max-w-4xl space-y-6">
    <section class="rounded-[4px] border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-extrabold text-ink">Adicionar posts</h2>
      <p class="mt-1 text-xs text-ink-muted">Cole um ou mais links de posts do X (um por linha). O texto, a data e a foto vêm do próprio X.</p>
      <textarea id="urls" rows="4" class={inp} placeholder="https://x.com/SamPancher/status/123…"></textarea>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button id="add-posts" type="button" class="rounded-[4px] bg-nioaque-green px-4 py-2.5 text-sm font-semibold text-white hover:bg-nioaque-green-dark">Publicar colunas</button>
        <span id="posts-msg" class="text-xs text-ink-muted" role="status" aria-live="polite"></span>
      </div>
    </section>

    <section class="rounded-[4px] border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-sm font-extrabold text-ink">Colunistas</h2>
        <button id="refresh" type="button" class="rounded-[4px] border border-slate-300 px-3 py-1.5 text-xs font-semibold text-ink hover:border-nioaque-green">Atualizar fotos e bios do X</button>
      </div>
      <ul id="columnists" class="mt-3 divide-y divide-slate-200 text-sm"></ul>
      <form id="add-col" class="mt-4 flex flex-wrap items-end gap-2">
        <label class="min-w-[12rem] flex-1 text-xs font-bold text-ink">Novo colunista (usuário do X)
          <input id="handle" class={inp} placeholder="@usuario" />
        </label>
        <button class="rounded-[4px] bg-ink px-4 py-2.5 text-sm font-semibold text-white">Adicionar</button>
      </form>
      <p id="col-msg" class="mt-2 text-xs text-ink-muted" role="status"></p>
    </section>

    <section class="rounded-[4px] border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-extrabold text-ink">Colunas publicadas</h2>
      <ul id="posts" class="mt-3 divide-y divide-slate-200 text-sm"></ul>
    </section>
  </div>
</AdminLayout>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const call = (method: string, body?: unknown, qs = '') =>
    fetch('/api/admin/colunas' + qs, { method, credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });

  async function load() {
    const res = await call('GET');
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      $('columnists').innerHTML = `<li class="py-3 text-nioaque-red-dark">${esc(data.error ?? 'Erro ao carregar')}</li>`;
      return;
    }
    const byId = new Map<string, any>(data.columnists.map((c: any) => [c.id, c]));
    $('columnists').innerHTML = data.columnists
      .map(
        (c: any) => `<li class="flex items-center gap-3 py-2">
          <img src="${c.avatar_url || 'https://unavatar.io/x/' + c.handle}" alt="" width="40" height="40" class="h-10 w-10 rounded-full bg-slate-100 object-cover" referrerpolicy="no-referrer" />
          <span class="min-w-0 flex-1"><strong class="block truncate text-ink">${esc(c.name)}</strong><span class="text-xs text-ink-muted">@${esc(c.handle)}</span></span>
          <button data-delcol="${c.id}" class="text-xs font-semibold text-nioaque-red-dark underline">Remover</button>
        </li>`,
      )
      .join('') || '<li class="py-3 text-ink-muted">Nenhum colunista.</li>';
    $('posts').innerHTML = data.posts
      .map(
        (p: any) => `<li class="flex items-start gap-3 py-2">
          <span class="min-w-0 flex-1"><span class="text-xs font-bold text-nioaque-green-dark">${esc(byId.get(p.columnist_id)?.name ?? '')} · ${new Date(p.posted_at).toLocaleDateString('pt-BR')}</span>
          <span class="mt-0.5 block text-ink">${esc(p.text.slice(0, 160))}${p.text.length > 160 ? '…' : ''}</span></span>
          <a href="/coluna/${p.id}" target="_blank" class="text-xs font-semibold text-ink underline">Ver</a>
          <button data-delpost="${p.id}" class="text-xs font-semibold text-nioaque-red-dark underline">Excluir</button>
        </li>`,
      )
      .join('') || '<li class="py-3 text-ink-muted">Nenhuma coluna ainda.</li>';
  }

  $('add-posts').addEventListener('click', async () => {
    const msg = $('posts-msg');
    const urls = ($('urls') as HTMLTextAreaElement).value;
    if (!urls.trim()) return;
    msg.textContent = 'Importando…';
    const res = await call('POST', { action: 'add_posts', urls });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) return void (msg.textContent = data.error ?? 'Erro');
    const bad = data.results.filter((r: any) => !r.ok);
    msg.textContent = `${data.results.length - bad.length} publicada(s).` + (bad.length ? ' Problemas: ' + bad.map((b: any) => b.message).join('; ') : '');
    if (!bad.length) ($('urls') as HTMLTextAreaElement).value = '';
    load();
  });

  $('refresh').addEventListener('click', async () => {
    $('col-msg').textContent = 'Atualizando…';
    const res = await call('POST', { action: 'refresh_profiles' });
    const data = await res.json().catch(() => ({}));
    $('col-msg').textContent = res.ok ? `${data.updated} perfil(is) atualizado(s).` : data.error ?? 'Erro';
    load();
  });

  $('add-col').addEventListener('submit', async (e) => {
    e.preventDefault();
    const handle = ($('handle') as HTMLInputElement).value;
    const res = await call('POST', { action: 'add_columnist', handle });
    const data = await res.json().catch(() => ({}));
    $('col-msg').textContent = res.ok ? 'Colunista adicionado.' : data.error ?? 'Erro';
    if (res.ok) ($('handle') as HTMLInputElement).value = '';
    load();
  });

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const post = t.closest<HTMLElement>('[data-delpost]')?.dataset.delpost;
    const col = t.closest<HTMLElement>('[data-delcol]')?.dataset.delcol;
    if (post && confirm('Excluir esta coluna?')) {
      await call('DELETE', undefined, `?post=${post}`);
      load();
    } else if (col && confirm('Remover o colunista e todas as colunas dele?')) {
      await call('DELETE', undefined, `?columnist=${col}`);
      load();
    }
  });

  load();
</script>
