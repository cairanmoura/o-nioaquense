---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/auth';

const session = Astro.locals.adminUser;
if (!session) return Astro.redirect('/admin/login');
if (!isAdmin(session)) return Astro.redirect('/admin');
---

<AdminLayout title="Curadoria" subtitle="Importador por link com fotos reais">
  <div class="mx-auto max-w-5xl space-y-6">
    <section class="rounded-sm border border-line bg-nioaque-white p-5">
      <header class="mb-4">
        <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red">
          Colar URL de notícia
        </h2>
        <p class="mt-1 text-xs leading-relaxed text-ink-muted">
          Cole a URL de uma notícia de site privado (Campo Grande News, Midiamax,
          G1). O sistema extrai o texto, reescreve com IA e puxa automaticamente a
          foto de capa (<code class="text-[10px] bg-editorial px-1 py-0.5 rounded">og:image</code>)
          e todas as fotos internas da matéria original.
        </p>
      </header>

      <form id="curate" class="space-y-3">
        <input
          name="url"
          type="url"
          placeholder="https://www.campograndenews.com.br/..."
          class="w-full rounded-xl border border-line bg-editorial px-4 py-3 text-sm"
          required
        />
        <button type="submit" class="rounded-sm bg-nioaque-green px-5 py-2.5 text-sm font-semibold text-white hover:bg-nioaque-green-dark">
          Extrair e reescrever com IA
        </button>
      </form>

      <div id="result" class="mt-4 hidden space-y-4">
        <h3 class="text-sm font-semibold text-ink">Resultado</h3>
        <div id="result-content" class="rounded-xl border border-line bg-editorial p-4 text-sm text-ink">
          Processando…
        </div>

        {/* Imagens extraídas da matéria original */}
        <div id="images-section" class="mt-4 hidden">
          <h4 class="text-xs font-semibold text-ink-muted uppercase tracking-wider mb-2">
            Fotos extraídas da matéria original
          </h4>
          <div id="images-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
          <p class="mt-2 text-xs text-ink-muted">
            A foto de capa é preenchida automaticamente. O upload final para o
            Supabase deve ser aprovado pelo editor.
          </p>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('curate');
  const result = document.getElementById('result');
  const content = document.getElementById('result-content');
  const imagesSection = document.getElementById('images-section');
  const imagesGrid = document.getElementById('images-grid');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form as HTMLFormElement);
    const url = fd.get('url');
    if (content) content.textContent = 'Processando…';
    if (imagesSection) imagesSection.classList.add('hidden');
    if (imagesGrid) imagesGrid.innerHTML = '';
    result?.classList.remove('hidden');
    try {
      const res = await fetch('/api/ai/curate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      });
      const data = await res.json();
      if (content) content.innerHTML = data?.draft ?? data?.error ?? 'Sem resultado';

      // Se a IA retornou dados de imagem, exibe as fotos extraídas
      if (data && data.coverImage) {
        if (imagesSection) imagesSection.classList.remove('hidden');
        if (imagesGrid) {
          const cap = document.createElement('div');
          cap.className = 'col-span-full bg-nioaque-white/50 p-2 rounded text-[10px] text-ink-muted';
          cap.textContent = `Capa: ${data.coverImage}`;
          imagesGrid.appendChild(cap);
          if (data.internalImages && data.internalImages.length) {
            for (const img of data.internalImages) {
              const wrap = document.createElement('div');
              wrap.className = 'flex flex-col items-center gap-1';
              const imgEl = document.createElement('img');
              imgEl.src = img.url;
              imgEl.alt = img.caption || '';
              imgEl.className = 'w-24 h-24 rounded object-cover border border-line';
              imgEl.referrerPolicy = 'no-referrer';
              imgEl.loading = 'lazy';
              imgEl.onerror = function () { this.src = '/artes-nioarquense/arte-cultura-9gac.svg'; };
              wrap.appendChild(imgEl);
              if (img.caption) {
                const capEl = document.createElement('div');
                capEl.className = 'text-[10px] text-center text-ink-muted';
                capEl.textContent = img.caption;
                wrap.appendChild(capEl);
              }
              imagesGrid.appendChild(wrap);
            }
          }
        }
      }
    } catch (err) {
      if (content) content.textContent = 'Erro ao processar.';
    }
  });
</script>