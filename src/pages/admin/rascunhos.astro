---
import ActionButton from '../../components/admin/ActionButton.tsx';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/auth';
import { formatDateTime } from '../../lib/format';
import { SCOPE_LABEL } from '../../lib/types';
import type { ArticleScope } from '../../lib/types';

const session = Astro.locals.adminUser;
if (!session) return Astro.redirect('/admin/login');
if (!isAdmin(session)) return Astro.redirect('/admin');

const supabase = Astro.locals.supabase;
let drafts: any[] = [];
if (supabase) {
  const { data } = await supabase
    .from('articles')
    .select('*')
    .eq('status', 'draft')
    .order('created_at', { ascending: false })
    .limit(100);
  drafts = data ?? [];
}

const photoOf = (url: string | null) => (url && !/\.svg(\?|$)/i.test(url) ? url : null);
---

<AdminLayout title="Rascunhos" subtitle={`${drafts.length} matéria(s) aguardando revisão`}>
  <div class="mx-auto max-w-4xl">
    {
      drafts.length === 0 ? (
        <div class="rounded-[4px] border border-dashed border-slate-300 bg-white p-10 text-center">
          <p class="text-xl font-extrabold text-ink">Nenhum rascunho</p>
          <p class="mt-1.5 text-sm text-ink-soft">
            Matérias de portais privados e da Curadoria chegam aqui para revisão antes de ir ao ar.
          </p>
        </div>
      ) : (
        <ul class="space-y-4">
          {drafts.map((a) => (
            <li class="flex gap-4 rounded-[4px] border border-slate-200 bg-white p-4 shadow-sm">
              {photoOf(a.cover_image_url) ? (
                <img
                  src={a.cover_image_url}
                  alt=""
                  width="160"
                  height="120"
                  loading="lazy"
                  referrerpolicy="no-referrer"
                  class="hidden h-24 w-32 shrink-0 rounded-[4px] bg-slate-100 object-cover sm:block"
                />
              ) : (
                <div class="hidden h-24 w-32 shrink-0 items-center justify-center rounded-[4px] bg-slate-100 text-[11px] text-ink-muted sm:flex">
                  Sem foto
                </div>
              )}
              <div class="min-w-0 flex-1">
                <p class="text-[11px] font-bold uppercase tracking-wider text-nioaque-green">
                  {SCOPE_LABEL[a.scope as ArticleScope] ?? a.scope}
                  {a.category_label ? ` · ${a.category_label}` : ''}
                  {a.source_name ? ` · ${a.source_name}` : ''}
                </p>
                <h2 class="mt-1 text-lg font-extrabold leading-snug text-ink">{a.title}</h2>
                {a.subtitle && <p class="mt-1 line-clamp-2 text-sm text-ink-soft">{a.subtitle}</p>}
                <p class="mt-1 text-xs text-ink-muted">Criado em {formatDateTime(a.created_at)}</p>

                <div class="mt-3 flex flex-wrap gap-2">
                  <a
                    href={`/admin/artigos/${a.id}`}
                    class="inline-flex items-center rounded-[4px] border border-slate-300 px-4 py-2 text-xs font-bold text-ink-soft hover:border-nioaque-green hover:text-nioaque-green"
                  >
                    Ler e editar
                  </a>
                  <ActionButton
                    client:load
                    endpoint={`/api/admin/articles/${a.id}`}
                    payload={{ action: 'publish' }}
                    label="Aprovar e publicar"
                    shortLabel="Publicar"
                    icon="check"
                    variant="success"
                    reload
                  />
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</AdminLayout>
