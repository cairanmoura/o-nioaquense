---
import ArticleCard from '../../components/ArticleCard.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { getColumnistBySlug } from '../../lib/content';
import { SCOPE_LABEL } from '../../lib/types';

/**
 * /colunistas/[slug]
 * -----------------------------------------------------------------------------
 * Pagina individual do colunista: foto, bio, redes sociais e historico de textos.
 */

const { slug = '' } = Astro.params;

const columnist = await getColumnistBySlug(Astro.locals, slug);

if (!columnist) {
  return Astro.redirect('/colunistas');
}

const { profile, articles } = columnist;
const socials = Object.entries(profile.social_links).filter(([, value]) => Boolean(value));

const published = articles.filter((article) => article.status === 'published');
---

<MainLayout
  title={`${profile.full_name} — ${profile.column_name ?? 'Colunista'}`}
  description={profile.bio ?? `Os textos de ${profile.full_name} no O Nioaquense.`}
  image={profile.avatar_url ?? undefined}
>
  <div class="container-editorial py-8 sm:py-10">
    {/* Cabecalho do colunista */}
    <header
      class="mx-auto flex max-w-3xl flex-col items-center gap-5 rounded-3xl border border-line bg-nioaque-white p-6 text-center sm:flex-row sm:items-start sm:text-left sm:p-8"
    >
      {
        profile.avatar_url ? (
          <img
            src={profile.avatar_url}
            alt=""
            width="120"
            height="120"
            loading="eager"
            decoding="async"
            class="h-28 w-28 shrink-0 rounded-full object-cover ring-4 ring-nioaque-green sm:h-32 sm:w-32"
          />
        ) : (
          <span class="flex h-28 w-28 shrink-0 items-center justify-center rounded-full bg-nioaque-green font-editorial text-4xl font-semibold text-white ring-4 ring-nioaque-green sm:h-32 sm:w-32">
            {profile.full_name.charAt(0)}
          </span>
        )
      }

      <div class="min-w-0 flex-1">
        <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-nioaque-red">
          {profile.column_name ?? 'Colunista'}
        </p>
        <h1 class="mt-1 text-headline font-semibold leading-tight text-ink">
          {profile.full_name}
        </h1>

        {profile.bio && (
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">{profile.bio}</p>
        )}

        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 sm:justify-start">
          <span class="pill-scope bg-nioaque-green-50 text-nioaque-green-dark">
            {published.length} {published.length === 1 ? 'texto' : 'textos'}
          </span>

          {socials.map(([network, url]) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="pill-scope bg-editorial text-ink-soft transition-colors hover:bg-nioaque-green-50 hover:text-nioaque-green-dark"
            >
              {network}
            </a>
          ))}
        </div>
      </div>
    </header>

    {/* Historico de textos */}
    <section class="mx-auto mt-10 max-w-4xl" aria-labelledby="textos-do-colunista">
      <h2
        id="textos-do-colunista"
        class="border-b-2 border-nioaque-green pb-3 font-editorial text-2xl font-semibold tracking-tight text-ink"
      >
        Textos publicados
      </h2>

      {
        articles.length === 0 ? (
          <p class="mt-6 rounded-2xl border border-dashed border-line-strong bg-nioaque-white p-8 text-center text-sm text-ink-soft">
            Este colunista ainda não publicou textos.
          </p>
        ) : (
          <ul class="mt-6 space-y-8">
            {articles.map((article) => (
              <li>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="pill-scope bg-nioaque-green-50 text-nioaque-green-dark">
                    {SCOPE_LABEL[article.scope]}
                  </span>
                  {article.category_label && (
                    <span class="pill-scope bg-ink/10 text-ink-soft">{article.category_label}</span>
                  )}
                </div>
                <ArticleCard article={article} author={profile} variant="standard" class="mt-3" />
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <p class="mx-auto mt-10 max-w-4xl">
      <a
        href="/colunistas"
        class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.12em] text-nioaque-green transition-colors hover:text-nioaque-red"
      >
        <span aria-hidden="true">←</span>
        Todos os colunistas
      </a>
    </p>
  </div>
</MainLayout>
