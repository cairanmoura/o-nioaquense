---
import MainLayout from '../../layouts/MainLayout.astro';
import ColunaCard from '../../components/ColunaCard.astro';
import { avatarOf, getXPost, getXPosts } from '../../lib/colunas';
import { formatDateTime } from '../../lib/format';

const { id = '' } = Astro.params;
const post = await getXPost(Astro.locals, id);
if (!post) return Astro.redirect('/colunas');
const c = post.columnist!;
const more = (await getXPosts(Astro.locals, { limit: 4, columnistId: c.id })).filter((p) => p.id !== post.id).slice(0, 3);
const title = `${c.name}: ${post.text.replace(/\s+/g, ' ').slice(0, 70)}${post.text.length > 70 ? '…' : ''}`;
// Link do embed oficial do X (o script do X transforma o blockquote no post completo)
const embedUrl = post.url.replace('https://x.com/', 'https://twitter.com/');
---

<MainLayout title={title} description={post.text.replace(/\s+/g, ' ').slice(0, 155)}>
  <article class="container-editorial py-6 sm:py-10">
    <a href="/colunas" class="text-xs font-semibold text-nioaque-green-dark hover:underline">← Todas as colunas</a>

    <div class="mx-auto mt-4 max-w-2xl">
      <p class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red-dark">Coluna</p>
      <a href={`/colunas/${c.handle}`} class="mt-3 flex items-center gap-3">
        <img src={avatarOf(c)} alt="" width="56" height="56" referrerpolicy="no-referrer" class="h-14 w-14 rounded-full bg-slate-100 object-cover" />
        <span class="leading-tight">
          <span class="block font-sans text-base font-extrabold text-ink">{c.name}</span>
          <span class="block font-sans text-sm text-ink-muted">@{c.handle} · {formatDateTime(post.posted_at)}</span>
        </span>
      </a>

      <p class="mt-5 whitespace-pre-line break-words font-editorial text-[1.25rem] leading-[1.7] text-ink">{post.text}</p>
      {post.media_url && <img src={post.media_url} alt="" referrerpolicy="no-referrer" class="mt-5 w-full rounded-[10px] object-cover" />}

      <section class="mt-8" aria-label="Post original no X">
        <p class="mb-2 font-sans text-xs font-semibold uppercase tracking-wider text-ink-muted">Post original no X</p>
        <blockquote class="twitter-tweet" data-lang="pt" data-dnt="true"><a href={embedUrl}>{post.text.slice(0, 120)}</a></blockquote>
        <a href={post.url} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex font-sans text-sm font-semibold text-nioaque-green-dark hover:underline">Abrir no X ↗</a>
      </section>

      <p class="mt-8 rounded-[4px] bg-nioaque-green-50 p-3 font-sans text-xs leading-relaxed text-ink-soft">
        Texto de opinião publicado originalmente no X pelo autor. As ideias expressas são de responsabilidade de quem assina.
      </p>
    </div>

    {more.length > 0 && (
      <section class="mx-auto mt-12 max-w-5xl">
        <h2 class="font-editorial text-xl font-semibold text-ink">Mais de {c.name}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">{more.map((p) => <ColunaCard post={p} clamp={4} />)}</div>
      </section>
    )}
  </article>
  <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
</MainLayout>
