---
import EnviarPistaForm from '../components/leitores/EnviarPistaForm.tsx';
import Icon from '../components/admin/Icon.astro';
import MainLayout from '../layouts/MainLayout.astro';

/**
 * /mande-sua-noticia
 * -----------------------------------------------------------------------------
 * "Boca no Trombone": canal direto do morador de Nioaque com a redação.
 */

const redaWhatsapp = import.meta.env.PUBLIC_REDACAO_WHATSAPP ?? '5567999990000';

const EXEMPLOS = [
  'Buraco na rua que piora com a chuva',
  'Lâmpada queimada há semanas no bairro',
  'Coleta de lixo atrasada',
  'Ônibus parando mais longe da escola',
];

const contatoWhatsapp = `https://wa.me/${redaWhatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(
  'Olá! Tenho uma dica para o O Nioaquense:',
)}`;
---

<MainLayout
  title="Mande sua Notícia"
  description="Boca no Trombone: mande a sua dica, reclamação ou pauta direto para a redação do O Nioaquense. Com fotos, sem burocracia."
>
  <div class="container-editorial py-8 sm:py-10">
    <div class="mx-auto grid max-w-4xl gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-12">
      {/* Explicacao */}
      <div>
        <header>
          <p class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-red">
            Boca no Trombone
          </p>
          <h1 class="mt-1 text-headline font-semibold leading-tight text-ink">
            Mande a sua notícia
          </h1>
          <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink-soft">
            Viu um problema na sua rua? Sabe de uma obra que travou? Tem uma pauta que a cidade
            precisa saber? Conte aqui. A redação apura com os órgãos públicos e publica.
          </p>
        </header>

        <ul class="mt-6 space-y-3">
          {
            [
              ['megaphone', 'Você não precisa ser jornalista', 'Conta o que você viu, com as suas palavras.'],
              ['check', 'A redação apura antes de publicar', 'Nada vai ao ar sem confirmação com a fonte oficial.'],
              ['lock', 'Seu nome é seu', 'Publicamos sua identificação apenas se você autorizar.'],
            ].map(([icon, title, description]) => (
              <li class="flex items-start gap-3 rounded-2xl border border-line bg-nioaque-white p-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-nioaque-green-50 text-nioaque-green">
                  <Icon name={icon} size={17} />
                </span>
                <span class="min-w-0">
                  <span class="block font-editorial text-base font-semibold text-ink">{title}</span>
                  <span class="mt-0.5 block text-sm leading-relaxed text-ink-soft">{description}</span>
                </span>
              </li>
            ))
          }
        </ul>

        {/* WhatsApp direto */}
        <div class="mt-6 rounded-2xl bg-ink p-5">
          <p class="font-sans text-[10px] font-bold uppercase tracking-[0.16em] text-white/60">
            Prefere o WhatsApp?
          </p>
          <p class="mt-2 text-sm leading-relaxed text-white/80">
            Chame a redação direto. Se a sua pista for aprovada, ela vira matéria no portal.
          </p>
          <a
            href={contatoWhatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-3 text-xs font-bold uppercase tracking-[0.1em] text-white transition-opacity hover:opacity-90"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.83 9.83 0 0 0 4.68 1.2h.01c5.43 0 9.84-4.4 9.84-9.84C21.89 6.4 17.48 2 12.04 2Zm5.76 14.02c-.24.68-1.4 1.3-1.94 1.36-.54.06-1.04.08-1.68-.12-.4-.12-.9-.3-1.56-.58-2.74-1.18-4.52-3.94-4.66-4.12-.14-.18-1.12-1.5-1.12-2.86 0-1.36.7-2.02.96-2.3.26-.28.56-.34.74-.34.18 0 .38 0 .54.02.18.02.42-.06.66.5.24.56.82 1.94.9 2.08.06.14.1.3.02.48-.08.18-.12.3-.24.46-.12.16-.26.36-.36.48-.12.12-.26.26-.1.5.14.24.64 1.06 1.38 1.72.94.84 1.74 1.1 1.98 1.22.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.6-.18 1.2Z" />
            </svg>
            Chamar a redação
          </a>
        </div>

        {/* Exemplos */}
        <div class="mt-6">
          <p class="font-sans text-[10px] font-bold uppercase tracking-[0.14em] text-ink-muted">
            Exemplos do que funciona
          </p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {
              EXEMPLOS.map((example) => (
                <li class="rounded-full bg-editorial px-3 py-1.5 text-xs text-ink-soft">{example}</li>
              ))
            }
          </ul>
        </div>
      </div>

      {/* Formulario */}
      <div class="rounded-3xl border border-line bg-nioaque-white p-5 sm:p-6">
        <EnviarPistaForm client:load />
      </div>
    </div>
  </div>
</MainLayout>
