---
import ArticleCard from '../../components/ArticleCard.astro';
import ArticlePills from '../../components/ArticlePills.astro';
import GoogleAdSlot from '../../components/GoogleAdSlot.astro';
import LocalAdBanner from '../../components/LocalAdBanner.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { getArticlePage, getHomeFeed } from '../../lib/content';
import { formatDateTime, formatNumber } from '../../lib/format';

const { slug = '' } = Astro.params;

const [page, feed] = await Promise.all([
  getArticlePage(Astro.locals, slug),
  getHomeFeed(Astro.locals),
]);

if (!page.article) {
  return Astro.redirect('/');
}

const article = page.article;
const author = page.author;
const profilesById = new Map(feed.profiles.map((profile) => [profile.id, profile]));
---

<MainLayout
  title={article.title}
  description={article.subtitle ?? article.summary_bullets[0] ?? article.title}
  image={article.cover_image_url ?? undefined}
>
  <article class="container-editorial py-8 sm:py-10">
    {/* Cabecalho */}
    <header class="mx-auto max-w-3xl">
      <ArticlePills article={article} showEditor />

      <h1 class="mt-4 text-headline font-semibold leading-[1.06] text-ink">{article.title}</h1>

      {
        article.subtitle && (
          <p class="mt-4 text-lg leading-relaxed text-ink-soft">{article.subtitle}</p>
        )
      }

      <div
        class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 border-y border-line py-4 text-xs font-medium uppercase tracking-[0.1em] text-ink-muted"
      >
        {
          author && (
            <div class="flex items-center gap-2.5">
              {author.avatar_url && (
                <img
                  src={author.avatar_url}
                  alt=""
                  width="36"
                  height="36"
                  loading="lazy"
                  decoding="async"
                  class="h-9 w-9 rounded-full object-cover"
                />
              )}
              <span class="font-semibold text-ink">
                {author.column_name ?? author.full_name}
              </span>
            </div>
          )
        }
        <span aria-hidden="true">&middot;</span>
        <time datetime={article.published_at ?? undefined}>
          {formatDateTime(article.published_at)}
        </time>
        <span aria-hidden="true">&middot;</span>
        <span>{formatNumber(article.views_count)} leituras</span>
      </div>
    </header>

    {/* Foto de capa */}
    {
      article.cover_image_url && (
        <figure class="mx-auto mt-8 max-w-4xl">
          <img
            src={article.cover_image_url}
            alt={article.cover_image_caption ?? article.title}
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
            class="aspect-[16/9] w-full rounded-2xl object-cover ring-1 ring-line"
          />
          {article.cover_image_caption && (
            <figcaption class="mt-2 px-1 text-xs leading-relaxed text-ink-muted">
              {article.cover_image_caption}
            </figcaption>
          )}
        </figure>
      )
    }

    {/* Corpo + lateral */}
    <div class="mx-auto mt-10 grid max-w-5xl gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,18rem)]">
      <div class="min-w-0">
        {/* Direto ao ponto */}
        {
          article.summary_bullets.length > 0 && (
            <aside class="box-resumo mb-8 p-6" aria-label="Direto ao ponto">
              <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-green">
                Direto ao ponto
              </h2>
              <ul class="mt-3 space-y-2.5">
                {article.summary_bullets.map((bullet) => (
                  <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-ink">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-nioaque-red" aria-hidden="true" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        <div
          class="prose-editorial space-y-5 font-editorial text-[1.0625rem] leading-[1.75] text-ink sm:text-lg"
          set:html={article.content}
        />

        {/* Anuncio no meio da materia */}
        <div class="mt-10">
          <GoogleAdSlot format="horizontal" label="Publicidade" />
        </div>

        {/* Assinatura do autor */}
        {
          author && (
            <aside class="mt-10 flex items-start gap-4 rounded-2xl border border-line bg-nioaque-white p-5">
              {author.avatar_url && (
                <img
                  src={author.avatar_url}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                  decoding="async"
                  class="h-14 w-14 shrink-0 rounded-full object-cover"
                />
              )}
              <div class="min-w-0">
                <p class="font-editorial text-lg font-semibold text-ink">{author.full_name}</p>
                {author.column_name && (
                  <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-nioaque-red">
                    {author.column_name}
                  </p>
                )}
                {author.bio && (
                  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{author.bio}</p>
                )}
              </div>
            </aside>
          )
        }

        {/* Relacionadas */}
        {
          page.related.length > 0 && (
            <section class="mt-12" aria-labelledby="relacionadas">
              <h2
                id="relacionadas"
                class="border-b-2 border-nioaque-green pb-3 font-editorial text-2xl font-semibold tracking-tight text-ink"
              >
                Leia tambem
              </h2>
              <div class="grid gap-6 pt-6 sm:grid-cols-3">
                {page.related.map((related) => (
                  <ArticleCard
                    article={related}
                    author={profilesById.get(related.author_id) ?? null}
                    variant="standard"
                  />
                ))}
              </div>
            </section>
          )
        }
      </div>

      {/* Lateral */}
      <aside class="lg:sticky lg:top-32 lg:self-start">
        <LocalAdBanner ad={feed.ads.sidebar} />
        <p class="mt-3 text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-muted/70">
          Publicidade
        </p>
      </aside>
    </div>
  </article>
</MainLayout>
