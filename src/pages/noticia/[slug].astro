---
import ArticleCard from '../../components/ArticleCard.astro';
import Comments from '../../components/Comments.astro';
import AudioPlayer from '../../components/AudioPlayer.tsx';
import CategoryPill from '../../components/CategoryPill.astro';
import CoverArt from '../../components/CoverArt.astro';
import GoogleAdSlot from '../../components/GoogleAdSlot.astro';
import LocalAdBanner from '../../components/LocalAdBanner.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { getArticlePage, getHomeFeed } from '../../lib/content';
import { excerpt } from '../../lib/seo';
import { linkifyArticle } from '../../lib/linkify';
import { renderEventCards } from '../../lib/events';


import { formatDateTime, formatNumber } from '../../lib/format';
import { SCOPE_LABEL } from '../../lib/types';
import { isPhotoCover } from '../../lib/rss';
import { imgSrcset, imgUrl } from '../../lib/img';
import type { Profile } from '../../lib/types';

/**
 * Pagina de leitura da materia.
 * -----------------------------------------------------------------------------
 *  - Cabecalho: pilula da editoria, titulo serifado, subtitulo, autor, data
 *  - "Direto ao Ponto" em destaque (estilo Nexo/Axios)
 *  - "Ouvir a Noticia" (Web Speech API, pt-BR)
 *  - Corpo com tipografia confortavel, anuncio intercalado eBOX relacionados
 *  - Meta tags + Schema.org NewsArticle
 */

const { slug = '' } = Astro.params;

const [page, feed] = await Promise.all([
  getArticlePage(Astro.locals, slug),
  getHomeFeed(Astro.locals),
]);

if (!page.article) {
  return Astro.redirect('/');
}

const article = page.article;
const author = page.author;
const profilesById = new Map<string, Profile>(feed.profiles.map((profile) => [profile.id, profile]));

const canonical = new URL(`/noticia/${article.slug}`, Astro.site ?? Astro.url.origin).href;
const shareUrl = canonical;
const shareText = article.title;

const description = excerpt(
  article.subtitle ?? article.summary_bullets.join(' ') ?? article.content,
  160,
);

/** Materias relacionadas de Nioaque (mesmo escopo). */
const related = page.related.length
  ? page.related
  : feed.byScope.nioaque.filter((item) => item.id !== article.id).slice(0, 3);

// "Outras versoes": outros veiculos que noticiaram o mesmo fato (guardados sem reescrita)
let otherVersions: { id: string; source_name: string | null; source_url: string; title: string }[] = [];
try {
  const sb = Astro.locals.supabase;
  if (sb) {
    const { data } = await sb.from('duplicate_articles').select('id,source_name,source_url,title').eq('duplicate_of', article.id).order('created_at', { ascending: false }).limit(6);
    otherVersions = (data as typeof otherVersions) ?? [];
  }
} catch {
  /* migracao 021 ainda nao rodou */
}
const words = article.content.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 200));
const rawSourceUrl = article.source_url ?? null;
const realSourceUrl = rawSourceUrl && !/news\.google\.com|bing\.com/i.test(rawSourceUrl) ? rawSourceUrl : null;
const looksAggregator = (n: string) => /radar|google news|bing/i.test(n);
const hostOf = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return null; } };
/* Credito vai para o veiculo real; nome de agregador vira o dominio do link original. */
const sourceName =
  article.source_name && !looksAggregator(article.source_name)
    ? article.source_name
    : realSourceUrl
      ? hostOf(realSourceUrl)
      : null;
const isColumnist = author?.role === 'columnist';
const bylineName = article.author_name || (isColumnist ? (author?.column_name ?? author?.full_name) : null) || 'Redação';
const sourceUrl = realSourceUrl;
const sourceInitials = sourceName
  ? sourceName
      .split(/\s+/)
      .map((part) => part.charAt(0))
      .slice(0, 2)
      .join('')
      .toUpperCase()
  : '';
// Arte geometrica nao e' foto: nao vale como imagem de compartilhamento.
const photoCover = isPhotoCover(article.cover_image_url) ? article.cover_image_url : null;

// "Atualizado em": so quando a materia foi alterada de verdade depois de publicada (> 30 min)
const updatedLabel =
  article.published_at && article.updated_at &&
  new Date(article.updated_at).getTime() - new Date(article.published_at).getTime() > 30 * 60_000
    ? formatDateTime(article.updated_at)
    : null;

const whatsappShare = `https://wa.me/?text=${encodeURIComponent(`${shareText}\n${shareUrl}`)}`;
const telegramShare = `https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`;
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
const xShare = `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`;
---

<MainLayout
  title={article.title}
  description={description}
  image={photoCover ?? undefined}
  ogType="article"
>
  {/* Metadados e Schema.org NewsArticle */}
  <Fragment slot="head">
    <meta property="article:published_time" content={article.published_at ?? ''} />
    <meta property="article:modified_time" content={article.updated_at} />
    <meta property="article:section" content={SCOPE_LABEL[article.scope]} />
    <meta property="article:author" content={bylineName} />

    {
      article.category_label && (
        <meta name="keywords" content={article.category_label} />
      )
    }

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'NewsArticle',
        headline: article.title,
        description,
        image: photoCover ? [photoCover] : ['/icons/icon-512.png'],
        datePublished: article.published_at,
        dateModified: article.updated_at,
        author: { '@type': isColumnist ? 'Person' : 'Organization', name: bylineName },
        publisher: {
          '@type': 'Organization',
          name: 'O Nioaquense',
          logo: { '@type': 'ImageObject', url: '/icons/icon-512.png' },
        },
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        articleSection: SCOPE_LABEL[article.scope],
        isAccessibleForFree: true,
        inLanguage: 'pt-BR',
      })}
    />
  </Fragment>

  <article class="container-editorial py-8 sm:py-10">
    {/* Cabecalho */}
    <header class="mx-auto max-w-3xl">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold">
        <CategoryPill category={article.category_label} fallback={SCOPE_LABEL[article.scope]} />
        <span class="font-medium text-ink-muted">&middot; {SCOPE_LABEL[article.scope]}</span>
      </div>

      <h1 class="mt-4 text-[clamp(1.75rem,1.2rem+2vw,2.5rem)] font-extrabold leading-[1.12] tracking-tight text-ink">
        {article.title}
      </h1>

      {article.subtitle && (
        <p class="mt-5 text-lg leading-relaxed text-ink-soft sm:text-xl">{article.subtitle}</p>
      )}

      {/* Autor + data + compartilhamento */}
      <div
        class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-3 border-y border-line py-4"
      >
        <div class="min-w-0 text-sm leading-snug">
          <p class="font-bold text-ink">
            Por {bylineName}
            {isColumnist && <span class="font-medium text-ink-muted"> · {author?.column_name}</span>}
          </p>
          {
            sourceName && (
              <p class="mt-0.5 text-xs text-ink-muted">
                Fonte:{' '}
                {sourceUrl && !/news.google.com|bing.com/i.test(sourceUrl) ? (
                  <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-nioaque-green-dark underline underline-offset-2">
                    {sourceName}
                  </a>
                ) : (
                  <span class="font-semibold text-ink-soft">{sourceName}</span>
                )}
              </p>
            )
          }
        </div>

        <div class="ml-auto flex items-center gap-3">
          <p class="text-xs font-medium text-ink-muted">
            <time datetime={article.published_at ?? undefined}>
              {formatDateTime(article.published_at)}
            </time>
            <span aria-hidden="true"> · </span>
            {readingMinutes} min de leitura
            {
              updatedLabel && (
                <>
                  <span aria-hidden="true"> · </span>
                  <time datetime={article.updated_at}>Atualizado em {updatedLabel}</time>
                </>
              )
            }
          </p>

          {/* Compartilhamento rapido */}
          <div class="flex items-center gap-1.5">
            <a
              href={whatsappShare}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Compartilhar no WhatsApp"
              title="Compartilhar no WhatsApp"
              class="flex h-9 w-9 items-center justify-center rounded-[4px] bg-[#25D366] text-white transition-opacity hover:opacity-90"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.83 9.83 0 0 0 4.68 1.2h.01c5.43 0 9.84-4.4 9.84-9.84C21.89 6.4 17.48 2 12.04 2Zm5.76 14.02c-.24.68-1.4 1.3-1.94 1.36-.54.06-1.04.08-1.68-.12-.4-.12-.9-.3-1.56-.58-2.74-1.18-4.52-3.94-4.66-4.12-.14-.18-1.12-1.5-1.12-2.86 0-1.36.7-2.02.96-2.3.26-.28.56-.34.74-.34.18 0 .38 0 .54.02.18.02.42-.06.66.5.24.56.82 1.94.9 2.08.06.14.1.3.02.48-.08.18-.12.3-.24.46-.12.16-.26.36-.36.48-.12.12-.26.26-.1.5.14.24.64 1.06 1.38 1.72.94.84 1.74 1.1 1.98 1.22.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.6-.18 1.2Z" />
              </svg>
            </a>
            <a
              href={telegramShare}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Compartilhar no Telegram"
              title="Compartilhar no Telegram"
              class="flex h-9 w-9 items-center justify-center rounded-[4px] bg-[#229ED9] text-white transition-opacity hover:opacity-90"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.3-.1-.5-.6-.2L6.2 13.1l-4.8-1.5c-1-.3-1-1 .2-1.5l18.8-7.2c.9-.3 1.6.2 1.5 1.4Z" />
              </svg>
            </a>
            <a
              href={xShare}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Compartilhar no X"
              title="Compartilhar no X"
              class="flex h-9 w-9 items-center justify-center rounded-[4px] bg-ink text-white transition-opacity hover:opacity-90"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L2.8 2h6.4l4.4 5.9L18.9 2Zm-1.1 18.2h1.7L7.3 3.7H5.5l12.3 16.5Z" />
              </svg>
            </a>
            <a
              href={facebookShare}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Compartilhar no Facebook"
              title="Compartilhar no Facebook"
              class="flex h-9 w-9 items-center justify-center rounded-[4px] bg-[#1877F2] text-white transition-opacity hover:opacity-90"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07Z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    {/* Capa: foto da materia ou capa desenhada (arte com a editoria) */}
    <figure class="mx-auto mt-8 max-w-4xl">
      {isPhotoCover(article.cover_image_url) ? (
        <img
          src={imgUrl(article.cover_image_url, 800)}
          srcset={imgSrcset(article.cover_image_url, [480, 640, 800, 1200])}
          sizes="(min-width: 896px) 896px, 100vw"
          alt={article.cover_image_caption ?? article.title}
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 9%22%3E%3Crect width=%2216%22 height=%229%22 fill=%22%2300661E%22/%3E%3C/svg%3E'; this.onerror=null;"
          class="block h-auto max-h-[78vh] w-full rounded-[4px] bg-editorial object-contain"
        />
      ) : (
        <CoverArt
          label={article.category_label ?? SCOPE_LABEL[article.scope]}
          scope={SCOPE_LABEL[article.scope]}
          slug={article.slug}
          alt={article.title}
          class="aspect-[16/9] w-full rounded-[4px]"
        />
      )}
      {isPhotoCover(article.cover_image_url) && (
        <figcaption class="mt-2 px-1 text-xs leading-relaxed text-ink-muted">
          {article.cover_image_caption ?? `Foto: Reprodução${article.source_name ? ` / ${article.source_name}` : ''}`}
        </figcaption>
      )}
    </figure>

    {/* Direto ao Ponto */}
    {
      article.summary_bullets.length > 0 && (
        <aside class="box-resumo mx-auto mt-8 max-w-3xl p-5 sm:p-6" aria-label="Direto ao Ponto">
          <h2 class="font-sans text-xs font-bold uppercase tracking-[0.08em] text-nioaque-green">
            Direto ao Ponto
          </h2>
          <ul class="mt-3 space-y-2.5">
            {article.summary_bullets.map((bullet) => (
              <li class="flex gap-2.5 text-base leading-relaxed text-ink">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-red" aria-hidden="true" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    {/* Ouvir a Noticia */}
    <div class="mx-auto mt-6 max-w-3xl">
      {/* "Ouvir a Notícia": `client:load` de propósito — é um botão que o
          morador precisa usar assim que vê, sem esperar a hidratação. */}
      <AudioPlayer
        client:load
        title={article.title}
        bullets={article.summary_bullets}
        html={article.content}
      />
    </div>

    {/* Capa antiga removida: agora fica logo abaixo do cabecalho */}

    {/* Corpo + lateral */}
    <div class="mx-auto mt-10 grid max-w-5xl gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,18rem)]">
      <div class="min-w-0">
        <div
          class="prose-editorial space-y-5 font-editorial text-[1.125rem] leading-[1.8] text-ink sm:text-[1.1875rem]"
          set:html={renderEventCards(linkifyArticle(article.content, { tags: article.tags ?? [], localTags: article.local_tags ?? [] }))}
        />

        {otherVersions.length > 0 && (
          <aside class="mt-8 rounded-[6px] border border-pedra bg-branco p-4" aria-label="Outras versões deste fato">
            <p class="font-sans text-[11px] font-bold uppercase tracking-[0.14em] text-nioaque-green">Outras versões</p>
            <p class="mt-1 text-sm text-ink-soft">O mesmo assunto também foi noticiado por:</p>
            <ul class="mt-2 space-y-1.5 text-sm">
              {otherVersions.map((v) => (
                <li>
                  <a href={v.source_url} target="_blank" rel="noopener noreferrer" class="font-semibold text-nioaque-green-dark hover:underline">{v.source_name ?? 'Veículo'}</a>
                  <span class="text-ink-muted"> · {v.title}</span>
                </li>
              ))}
            </ul>
          </aside>
        )}

        {sourceName && sourceUrl && (
          <p class="mt-8 border-t border-line pt-4 text-sm leading-relaxed text-ink-soft">
            <strong class="font-semibold text-ink">Fonte:</strong>{' '}
            <a
              href={sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline font-semibold text-nioaque-green"
            >
              {sourceName}
            </a>
            . O Nioaquense publica a chamada e a foto; a íntegra está no veículo original.
          </p>
        )}

        {/* Anuncio intercalado: o do comercio local (slot "Dentro da materia")
            e, abaixo, o espaco do Google AdSense. O banner local so aparece
            quando ha anunciante - sem ele, o espaco do AdSense ja esta
            reservado e nao sobra uma caixa vazia no meio da materia. */}
        <div class="mt-10 space-y-6">
          {feed.ads.article_inline && <LocalAdBanner ad={feed.ads.article_inline} label="Publicidade local" />}
          <GoogleAdSlot format="horizontal" label="Publicidade" />
        </div>

        {/* Assinatura */}
        {
          isColumnist && author && (
            <aside class="mt-10 flex items-start gap-4 rounded-[4px] border border-line bg-nioaque-white p-5">
              {author.avatar_url ? (
                <img
                  src={author.avatar_url}
                  alt=""
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-16 shrink-0 rounded-[4px] object-cover ring-2 ring-nioaque-green"
                />
              ) : (
                <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-[4px] bg-nioaque-green font-editorial text-xl font-extrabold text-white">
                  {author.full_name.charAt(0)}
                </span>
              )}
              <div class="min-w-0">
                <p class="font-editorial text-lg font-extrabold text-ink">{author.full_name}</p>
                {author.column_name && (
                  <p class="text-xs font-semibold text-nioaque-red-dark">
                    {author.column_name}
                  </p>
                )}
                {author.bio && (
                  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{author.bio}</p>
                )}
                <a
                  href={`/colunistas/${author.slug}`}
                  class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red-dark"
                >
                  Ver todos os textos
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </aside>
          )
        }

        {/* Relacionadas */}
        {
          related.length > 0 && (
            <section class="mt-12" aria-labelledby="relacionadas">
              <h2
                id="relacionadas"
                class="border-b-2 border-nioaque-green pb-3 font-editorial text-2xl font-semibold tracking-tight text-ink"
              >
                Leia também
              </h2>
              <div class="grid gap-5 pt-6 sm:grid-cols-2 [&>article]:border-b [&>article]:border-line [&>article]:pb-5 sm:[&>article]:border-0 sm:[&>article]:pb-0">
                {related.map((item) => (
                  <ArticleCard
                    article={item}
                    author={profilesById.get(item.author_id) ?? null}
                    variant="compact"
                  />
                ))}
              </div>
            </section>
          )
        }

        <Comments slug={article.slug} />
      </div>

      {/* Lateral */}
      <aside class="lg:sticky lg:top-32 lg:self-start">
        <LocalAdBanner ad={feed.ads.sidebar} />

        <div class="mt-8 rounded-[4px] border border-line bg-nioaque-white p-5">
          <p class="text-xs font-semibold text-nioaque-green">Tem uma dica?</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">
            Mande a sua para a redação. Toda pista é apurada antes de virar notícia.
          </p>
          <a
            href="/mande-sua-noticia"
            class="mt-4 inline-flex items-center gap-2 rounded-[4px] bg-nioaque-red px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-nioaque-red-dark"
          >
            Boca no Trombone
          </a>
        </div>

        {article.views_count > 0 && (
          <p class="mt-6 text-xs text-ink-muted">
            {formatNumber(article.views_count)} leituras
          </p>
        )}
      </aside>
    </div>
  </article>
</MainLayout>
