---
/**
 * Comments.astro
 * -----------------------------------------------------------------------------
 * Comentarios da materia. A pagina e' guardada no cache da borda, entao a lista
 * e o formulario sao carregados no navegador (/api/comentarios). Anti-spam:
 * campo-isca, tempo minimo e filtros no servidor (src/lib/comments.ts).
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section class="mt-12" aria-labelledby="comentarios" data-comments data-slug={slug}>
  <h2 id="comentarios" class="border-b-2 border-nioaque-green pb-3 font-editorial text-2xl font-semibold tracking-tight text-ink">
    Comentários <span class="text-base font-medium text-ink-muted" data-comments-count></span>
  </h2>

  <ul class="mt-5 divide-y divide-line" data-comments-list aria-live="polite" style="min-height:3rem"></ul>
  <p class="mt-4 hidden text-sm text-ink-muted" data-comments-empty>Seja o primeiro a comentar.</p>

  <form class="mt-6 rounded-[4px] border border-line bg-nioaque-white p-4 sm:p-5" data-comments-form novalidate>
    <p class="text-sm font-semibold text-ink">Deixe seu comentário</p>
    <p class="mt-1 text-xs leading-relaxed text-ink-muted">
      Seja respeitoso. Não aceitamos ofensas, links ou propaganda. Veja os
      <a href="/termos" class="underline">Termos de uso</a>.
    </p>

    <label class="mt-4 block text-sm font-semibold text-ink" for="c-nome">Nome ou apelido</label>
    <input id="c-nome" name="name" maxlength="40" autocomplete="nickname" required class="mt-1 min-h-11 w-full rounded-[4px] border border-line-strong bg-branco px-3 text-base text-ink" />

    <label class="mt-3 block text-sm font-semibold text-ink" for="c-texto">Comentário</label>
    <textarea id="c-texto" name="body" rows="4" maxlength="1000" required class="mt-1 w-full rounded-[4px] border border-line-strong bg-branco px-3 py-2 text-base text-ink"></textarea>

    <!-- isca anti-robo: pessoas nao veem nem preenchem -->
    <div aria-hidden="true" style="position:absolute;left:-9999px;height:0;overflow:hidden">
      <label>Site <input name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button type="submit" class="min-h-11 rounded-[4px] bg-nioaque-green px-5 text-sm font-semibold text-white hover:bg-verde-mata disabled:opacity-60">Publicar comentário</button>
      <p class="text-sm" role="status" data-comments-msg></p>
    </div>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-comments]').forEach((root) => {
    const slug = root.dataset.slug!;
    const list = root.querySelector<HTMLUListElement>('[data-comments-list]')!;
    const empty = root.querySelector<HTMLElement>('[data-comments-empty]')!;
    const count = root.querySelector<HTMLElement>('[data-comments-count]')!;
    const form = root.querySelector<HTMLFormElement>('[data-comments-form]')!;
    const msg = root.querySelector<HTMLElement>('[data-comments-msg]')!;
    const opened = Date.now();

    const when = (iso: string) => new Date(iso).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });

    function draw(items: { author_name: string; body: string; created_at: string }[]) {
      list.replaceChildren(
        ...items.map((c) => {
          const li = document.createElement('li');
          li.className = 'py-4';
          const head = document.createElement('p');
          head.className = 'text-sm font-semibold text-ink';
          head.textContent = c.author_name;
          const t = document.createElement('span');
          t.className = 'ml-2 text-xs font-normal text-ink-muted';
          t.textContent = when(c.created_at);
          head.append(t);
          const p = document.createElement('p');
          p.className = 'mt-1 whitespace-pre-line text-[0.9375rem] leading-relaxed text-ink-soft';
          p.textContent = c.body; // textContent: nunca interpreta HTML
          li.append(head, p);
          return li;
        }),
      );
      count.textContent = items.length ? `(${items.length})` : '';
      empty.classList.toggle('hidden', items.length > 0);
    }

    function load() {
      fetch(`/api/comentarios?slug=${encodeURIComponent(slug)}`)
        .then((r) => r.json())
        .then((d) => draw(d.comments ?? []))
        .catch(() => {});
    }
    // Carrega so quando a secao se aproxima da tela (nao pesa o carregamento da materia)
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
      }, { rootMargin: '400px' });
      io.observe(root);
    } else load();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      msg.className = 'text-sm text-ink-soft';
      msg.textContent = 'Enviando…';
      btn.disabled = true;
      try {
        const res = await fetch('/api/comentarios', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, name: fd.get('name'), body: fd.get('body'), website: fd.get('website'), t: opened }),
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || 'Não foi possível enviar agora.');
        form.querySelector<HTMLTextAreaElement>('textarea')!.value = '';
        msg.className = 'text-sm font-semibold text-nioaque-green';
        msg.textContent = d.status === 'approved' ? 'Comentário publicado. Obrigado!' : 'Recebemos seu comentário. Ele aparece após a revisão da redação.';
        if (d.status === 'approved') load();
      } catch (err) {
        msg.className = 'text-sm font-semibold text-nioaque-red-dark';
        msg.textContent = (err as Error).message;
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
