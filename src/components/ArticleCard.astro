---
import ArticlePills from './ArticlePills.astro';
import CoverArt from './CoverArt.astro';
import { formatDate, formatRelative } from '../lib/format';
import { isPhotoCover } from '../lib/rss';
import { SCOPE_LABEL } from '../lib/types';
import type { Article, Profile } from '../lib/types';

interface Props {
  article: Article;
  author?: Profile | null;
  /**
   * - `lead`     : grande, com imagem e resumo "Direto ao Ponto"
   * - `standard` : card vertical com imagem
   * - `compact`  : linha com miniatura a esquerda (listas)
   * - `column`   : coluna opinativa, sem imagem
   */
  variant?: 'lead' | 'standard' | 'compact' | 'column';
  /** Mostra o resumo em bullets (caixa "Direto ao Ponto"). */
  showSummary?: boolean;
  /** Classes extras do box "Direto ao Ponto" (ex.: "hidden lg:block" = so no desktop). */
  summaryClass?: string;
  /** Mostra a editoria alem da categoria (ex.: "Nioaque" + "Cidade"). */
  showEditor?: boolean;
  class?: string;
}

const {
  article,
  author = null,
  variant = 'standard',
  showSummary = false, // "Direto ao Ponto": materia aberta e, no desktop, a manchete da Home (summaryClass)
  summaryClass = '',
  showEditor = false,
  class: className = '',
} = Astro.props;

const href = `/noticia/${article.slug}`;
// Autor exibido: escolhido na materia (padrao Redacao). Foto/nome do perfil so para colunistas.
const isColumnist = author?.role === 'columnist';
const authorName = article.author_name || (isColumnist ? (author?.column_name ?? author?.full_name ?? 'Redação') : 'Redação');
const avatar = isColumnist ? (author?.avatar_url ?? null) : null;
// Materia de agencia: a credibilidade esta em dizer de onde veio.
const credit = article.source_name ?? authorName;
// Foto de verdade OU capa desenhada (as artes geometricas tem caixa vazia).
const photo = isPhotoCover(article.cover_image_url) ? article.cover_image_url : null;
const coverLabel = article.category_label ?? SCOPE_LABEL[article.scope];
const coverScope = SCOPE_LABEL[article.scope];
// As listas nao carregam o corpo (pesado): so mostra o tempo de leitura quando o texto veio junto
const words = article.content ? article.content.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length : 0;
const readingMinutes = words ? Math.max(1, Math.round(words / 200)) : 0;
---

{
  variant === 'column' ? (
    <article
      class:list={[
        'group relative flex h-full flex-col overflow-hidden bg-nioaque-white p-5',
        className,
      ]}
    >
      <span class="absolute inset-y-5 left-0 w-1 rounded-r bg-nioaque-red" aria-hidden="true" />
      <div class="pl-3">
        <ArticlePills article={article} showEditor={showEditor} />
      </div>
      <h3 class="mt-2.5 pl-3 font-editorial text-lg font-extrabold leading-snug">
        <a href={href} class="transition-colors group-hover:text-nioaque-green">
          {article.title}
        </a>
      </h3>
      {article.subtitle && (
        <p class="mt-2 pl-3 text-[0.9375rem] leading-relaxed text-ink-soft line-clamp-3">
          {article.subtitle}
        </p>
      )}
      <div class="mt-auto flex items-center gap-2 pl-3 pt-4 text-xs font-medium text-ink-muted">
        {avatar && (
          <img
            src={avatar}
            alt=""
            width="24"
            height="24"
            loading="lazy"
            decoding="async"
            class="h-6 w-6 rounded-[4px] object-cover"
          />
        )}
        <span class="truncate">{authorName}</span>
      </div>
    </article>
  ) : variant === 'compact' ? (
    <article class:list={['group flex items-start gap-3', className]}>
      {/* Em miniatura a arte geometrica fica ilegivel; so a foto real vira thumb. */}
      {photo && (
        <a href={href} class="shrink-0" tabindex="-1" aria-hidden="true">
          <img
            src={photo}
            alt=""
            width="112"
            height="78"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 9%22%3E%3Crect width=%2216%22 height=%229%22 fill=%22%2300661E%22/%3E%3C/svg%3E'; this.onerror=null;"
            class="h-[72px] w-24 rounded-[4px] object-cover"
          />
        </a>
      )}
      <div class="min-w-0 flex-1">
        <ArticlePills article={article} showEditor={showEditor} />
        <h3 class="mt-1.5 font-editorial text-base font-extrabold leading-snug">
          <a href={href} class="transition-colors group-hover:text-nioaque-green">
            {article.title}
          </a>
        </h3>
        <p class="mt-1 text-xs font-medium text-ink-muted">{formatRelative(article.published_at)}</p>
      </div>
    </article>
  ) : variant === 'lead' ? (
    <article class:list={['group flex flex-col', className]}>
      {/* Mobile: a capa (16:9) vem ACIMA do titulo (order-first no link da
          imagem) para a manchete "bater o olho" ja na primeira dobra.
          A ordem do DOM (titulo primeiro) e' preservada para acessibilidade. */}
      <div class="mt-3 md:mt-0">
        <h2 class="text-[clamp(1.5rem,1.05rem+1.6vw,2.25rem)] font-extrabold leading-[1.12] tracking-tight">
          <a href={href} class="transition-colors group-hover:text-nioaque-green">
            {article.title}
          </a>
        </h2>
        {article.subtitle && (
          <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-lg">{article.subtitle}</p>
        )}
        <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-ink-muted">
          <span class="font-semibold text-nioaque-green-dark">{coverScope}</span>
          <span aria-hidden="true">&middot;</span>
          {avatar && (
            <img
              src={avatar}
              alt=""
              width="28"
              height="28"
              loading="lazy"
              decoding="async"
              class="h-7 w-7 rounded-[4px] object-cover"
            />
          )}
          <span class="text-ink-soft">{credit}</span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={article.published_at ?? undefined} title={formatDate(article.published_at)}>
            {formatRelative(article.published_at)}
          </time>
          <span aria-hidden="true">&middot;</span>
          {readingMinutes > 0 && <span>{readingMinutes} min de leitura</span>}
        </div>
      </div>

      <a
        href={href}
        class="order-first block overflow-hidden rounded-[4px] bg-nioaque-green-50 md:order-none md:mt-5"
      >
        {photo ? (
          <img
            src={photo}
            alt={article.cover_image_caption ?? article.title}
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
            referrerpolicy="no-referrer"
            onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 9%22%3E%3Crect width=%2216%22 height=%229%22 fill=%22%2300661E%22/%3E%3C/svg%3E'; this.onerror=null;"
            class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
        ) : (
          <CoverArt
            label={coverLabel}
            scope={coverScope}
            slug={article.slug}
            alt={article.title}
            class="aspect-[16/9] w-full transition-transform duration-500 group-hover:scale-[1.02]"
          />
        )}
      </a>

      {showSummary && article.summary_bullets.length > 0 && (
        <div class:list={['box-resumo mt-5 p-5', summaryClass]}>
          <h3 class="text-sm font-semibold text-nioaque-green">Direto ao Ponto</h3>
          <ul class="mt-3 space-y-2.5">
            {article.summary_bullets.map((bullet) => (
              <li class="flex gap-2.5 text-base leading-relaxed text-ink">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[4px] bg-nioaque-red" aria-hidden="true" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </article>
  ) : (
    <article
      class:list={[
        'group flex h-full flex-col overflow-hidden rounded-[4px] bg-nioaque-white',
        className,
      ]}
    >
      <a href={href} class="block overflow-hidden bg-nioaque-green-50">
        {photo ? (
          <img
            src={photo}
            alt={article.cover_image_caption ?? article.title}
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
            onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 9%22%3E%3Crect width=%2216%22 height=%229%22 fill=%22%2300661E%22/%3E%3C/svg%3E'; this.onerror=null;"
            class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        ) : (
          <CoverArt
            label={coverLabel}
            scope={coverScope}
            slug={article.slug}
            alt={article.title}
            class="aspect-[16/9] w-full transition-transform duration-500 group-hover:scale-[1.03]"
          />
        )}
      </a>
      <div class="flex flex-1 flex-col p-5">
        <ArticlePills article={article} showEditor={showEditor} />
        <h3 class="mt-2.5 font-editorial text-lg font-extrabold leading-snug">
          <a href={href} class="transition-colors group-hover:text-nioaque-green">
            {article.title}
          </a>
        </h3>
        {article.subtitle && (
          <p class="mt-2 text-base leading-relaxed text-ink-soft line-clamp-3">{article.subtitle}</p>
        )}
        <div class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-4 text-xs font-medium text-ink-muted">
          <span class="truncate">{credit}</span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={article.published_at ?? undefined} title={formatDate(article.published_at)}>
            {formatRelative(article.published_at)}
          </time>
        </div>
      </div>
    </article>
  )
}
