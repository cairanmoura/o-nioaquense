---
import ArticlePills from './ArticlePills.astro';
import ScopePill from './ScopePill.astro';
import { formatDate, formatNumber, formatRelative } from '../lib/format';
import type { Article, Profile } from '../lib/types';

interface Props {
  article: Article;
  author?: Profile | null;
  /**
   * - `lead`     : grande, com imagem e resumo "Direto ao Ponto"
   * - `standard` : card vertical com imagem
   * - `compact`  : linha com miniatura a esquerda (listas)
   * - `column`   : coluna opinativa, sem imagem
   */
  variant?: 'lead' | 'standard' | 'compact' | 'column';
  /** Mostra o resumo em bullets (caixa "Direto ao Ponto"). */
  showSummary?: boolean;
  /** Mostra a editoria alem da categoria (ex.: "Nioaque" + "Cidade"). */
  showEditor?: boolean;
  class?: string;
}

const {
  article,
  author = null,
  variant = 'standard',
  showSummary = variant === 'lead',
  showEditor = false,
  class: className = '',
} = Astro.props;

const href = `/materia/${article.slug}`;
const authorName = author?.column_name ?? author?.full_name ?? 'Redacao';
---

{
  variant === 'column' ? (
    <article
      class:list={[
        'group relative flex h-full flex-col rounded-2xl border border-line bg-nioaque-white p-5 transition-shadow hover:shadow-lift',
        className,
      ]}
    >
      <span class="absolute inset-y-5 left-0 w-1 rounded-r bg-nioaque-red" aria-hidden="true" />
      <div class="pl-3">
        <ScopePill scope={article.scope} category={article.category_label} />
      </div>
      <h3 class="mt-3 pl-3 text-title font-semibold leading-snug">
        <a href={href} class="transition-colors group-hover:text-nioaque-green">
          {article.title}
        </a>
      </h3>
      {article.subtitle && (
        <p class="mt-2 pl-3 text-sm leading-relaxed text-ink-soft">{article.subtitle}</p>
      )}
      <div class="mt-auto flex items-center gap-2 pl-3 pt-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-muted">
        {author?.avatar_url && (
          <img
            src={author.avatar_url}
            alt=""
            width="24"
            height="24"
            loading="lazy"
            decoding="async"
            class="h-6 w-6 rounded-full object-cover"
          />
        )}
        <span class="truncate">{authorName}</span>
      </div>
    </article>
  ) : variant === 'compact' ? (
    <article class:list={['group flex items-start gap-4 py-4 first:pt-0 last:pb-0', className]}>
      {article.cover_image_url && (
        <a href={href} class="shrink-0" tabindex="-1" aria-hidden="true">
          <img
            src={article.cover_image_url}
            alt=""
            width="112"
            height="78"
            loading="lazy"
            decoding="async"
            class="h-[78px] w-28 rounded-xl object-cover ring-1 ring-line"
          />
        </a>
      )}
      <div class="min-w-0 flex-1">
        <ArticlePills article={article} showEditor={showEditor} />
        <h3 class="mt-2 text-[1.0625rem] font-semibold leading-snug sm:text-lg">
          <a href={href} class="transition-colors group-hover:text-nioaque-green">
            {article.title}
          </a>
        </h3>
        <p class="mt-1.5 text-xs font-medium uppercase tracking-[0.1em] text-ink-muted">
          {formatRelative(article.published_at)} &middot; {formatNumber(article.views_count)}{' '}
          leituras
        </p>
      </div>
    </article>
  ) : variant === 'lead' ? (
    <article class:list={['group flex flex-col', className]}>
      {article.cover_image_url && (
        <a href={href} class="block overflow-hidden rounded-2xl bg-nioaque-green-50">
          <img
            src={article.cover_image_url}
            alt={article.cover_image_caption ?? article.title}
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
            class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </a>
      )}
      <div class="pt-4">
        <ArticlePills article={article} showEditor={showEditor} />
      </div>
      <h2 class="mt-3 text-headline font-semibold leading-[1.08]">
        <a href={href} class="transition-colors group-hover:text-nioaque-green">
          {article.title}
        </a>
      </h2>
      {article.subtitle && (
        <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-lg">{article.subtitle}</p>
      )}

      {showSummary && article.summary_bullets.length > 0 && (
        <div class="box-resumo mt-5 p-5">
          <h3 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-nioaque-green">
            Direto ao ponto
          </h3>
          <ul class="mt-3 space-y-2.5">
            {article.summary_bullets.map((bullet) => (
              <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-ink">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-nioaque-red" aria-hidden="true" />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line pt-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-muted">
        {author?.avatar_url && (
          <img
            src={author.avatar_url}
            alt=""
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
            class="h-7 w-7 rounded-full object-cover"
          />
        )}
        <span class="text-ink-soft">{authorName}</span>
        <span aria-hidden="true">&middot;</span>
        <time datetime={article.published_at ?? undefined} title={formatDate(article.published_at)}>
          {formatRelative(article.published_at)}
        </time>
      </div>
    </article>
  ) : (
    <article
      class:list={[
        'group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-nioaque-white transition-shadow hover:shadow-lift',
        className,
      ]}
    >
      {article.cover_image_url && (
        <a href={href} class="block overflow-hidden bg-nioaque-green-50">
          <img
            src={article.cover_image_url}
            alt={article.cover_image_caption ?? article.title}
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
            class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </a>
      )}
      <div class="flex flex-1 flex-col p-5">
        <ArticlePills article={article} showEditor={showEditor} />
        <h3 class="mt-3 text-title font-semibold leading-snug">
          <a href={href} class="transition-colors group-hover:text-nioaque-green">
            {article.title}
          </a>
        </h3>
        {article.subtitle && (
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{article.subtitle}</p>
        )}
        <div class="mt-auto flex items-center gap-2 pt-4 text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-muted">
          <span class="truncate">{authorName}</span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={article.published_at ?? undefined} title={formatDate(article.published_at)}>
            {formatRelative(article.published_at)}
          </time>
        </div>
      </div>
    </article>
  )
}
