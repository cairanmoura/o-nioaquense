---
import { SCOPE_LABEL } from '../lib/types';
import type { Article } from '../lib/types';

/**
 * ArticlePills.astro
 * -----------------------------------------------------------------------------
 * Linha de editoria da materia.
 *
 * Antes eram duas pilulas em caixa alta com muito espacamento entre letras.
 * Agora e' uma linha curta, legivel, com o ponto colorido da marca: continua
 * identificando a editoria sem competir com o titulo.
 */

interface Props {
  article: Article;
  /** Mostra a editoria alem da categoria (ex.: "Saude" + "Nioaque"). */
  showEditor?: boolean;
  class?: string;
}

const { article, showEditor = false, class: className = '' } = Astro.props;
const label = article.category_label ?? SCOPE_LABEL[article.scope];
---

<div
  class:list={[
    'flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs font-semibold leading-relaxed',
    className,
  ]}
>
  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-nioaque-green" aria-hidden="true" />
  <span class="text-nioaque-green-dark">{label}</span>
  {showEditor && <span class="font-medium text-ink-muted">&middot; {SCOPE_LABEL[article.scope]}</span>}
  {article.is_breaking && <span class="font-bold text-nioaque-red">&middot; Última hora</span>}
</div>
