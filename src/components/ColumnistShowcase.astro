---
import { formatDate } from '../lib/format';
import type { ColumnistPick } from '../lib/content';

/**
 * ColumnistShowcase.astro
 * -----------------------------------------------------------------------------
 * Faixa de colunistas em destaque: avatar circular com borda verde/vermelha,
 * nome da coluna, autor e titulo do texto.
 */

interface Props {
  picks: ColumnistPick[];
  class?: string;
}

const { picks, class: className = '' } = Astro.props;
const visible = picks.filter((pick) => pick.article).slice(0, 6);
---

<section
  class:list={['rounded-2xl bg-nioaque-white p-5 sm:p-7', className]}
  aria-labelledby="faixa-colunistas"
>
  <header class="flex flex-wrap items-end justify-between gap-3 border-b-2 border-nioaque-red pb-4">
    <h2 id="faixa-colunistas" class="font-editorial text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      Colunistas
    </h2>
    <a
      href="/editoria/coluna"
      class="text-sm font-semibold text-nioaque-green transition-colors hover:text-nioaque-red"
    >
      Ver todas
    </a>
  </header>

  <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {
      visible.map(({ profile, article }, index) => (
        <li>
          <article class="group flex h-full flex-col rounded-xl bg-editorial p-5">
            <div class="flex items-center gap-3.5">
              {profile.avatar_url ? (
                <img
                  src={profile.avatar_url}
                  alt=""
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'h-16 w-16 shrink-0 rounded-full border-[3px] object-cover transition-transform group-hover:scale-105',
                    index % 2 === 0 ? 'border-nioaque-green' : 'border-nioaque-red',
                  ]}
                />
              ) : (
                <span
                  class:list={[
                    'flex h-16 w-16 shrink-0 items-center justify-center rounded-full font-editorial text-xl font-semibold text-white',
                    index % 2 === 0 ? 'bg-nioaque-green' : 'bg-nioaque-red',
                  ]}
                >
                  {profile.full_name.charAt(0)}
                </span>
              )}

              <div class="min-w-0">
                <p class="truncate text-xs font-semibold text-nioaque-green">
                  {profile.column_name}
                </p>
                <p class="mt-0.5 truncate font-editorial text-base font-semibold text-ink">
                  {profile.full_name}
                </p>
              </div>
            </div>

            {article && (
              <>
                <h3 class="mt-4 font-editorial text-lg font-semibold leading-snug text-ink">
                  <a
                    href={`/noticia/${article.slug}`}
                    class="transition-colors group-hover:text-nioaque-green"
                  >
                    {article.title}
                  </a>
                </h3>

                <div class="mt-auto flex flex-wrap items-center gap-2 pt-4">
                  <span class="text-xs font-medium text-ink-muted">
                    {formatDate(article.published_at)}
                  </span>
                </div>
              </>
            )}
          </article>
        </li>
      ))
    }
  </ul>
</section>
