---
import type { LotteryResult } from '../lib/types';

/**
 * LotteryResults.astro - card compacto de loterias (numeros em grid denso).
 */
interface Props {
  results: LotteryResult[];
  class?: string;
}
const { results, class: className = '' } = Astro.props;
const visible = results.slice(0, 3);
---

{
  visible.length > 0 && (
    <section class:list={['w-full overflow-hidden rounded-[4px] border border-slate-200 bg-white shadow-sm', className]} aria-label="Resultados das loterias">
      <header class="bg-[#00661E] px-3 py-2">
        <h2 class="text-sm font-extrabold text-white">Loterias</h2>
      </header>
      <ul class="divide-y divide-slate-200">
        {visible.map((result) => (
          <li class="px-3 py-2.5">
            <p class="flex items-baseline justify-between gap-2 text-xs">
              <span class="font-bold text-nioaque-green">{result.modality}</span>
              <span class="text-ink-muted">#{result.contest_number} · {result.contest_date.split('-').reverse().slice(0, 2).join('/')}</span>
            </p>
            <ul class="mt-1.5 grid grid-cols-[repeat(auto-fill,1.75rem)] gap-1">
              {result.numbers.map((number) => (
                <li class="flex h-7 w-7 items-center justify-center rounded-[4px] bg-nioaque-green text-xs font-bold text-white">
                  {number}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  )
}
