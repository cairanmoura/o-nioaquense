---
export interface Props {
  icon?: string;
  size?: number;
}

const { icon = 'cloud', size = 11 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="shrink-0"
>
  {icon === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.5 6.5 4.9 4.9M19.1 19.1l-1.6-1.6M17.5 6.5l1.6-1.6M4.9 19.1l1.6-1.6" />
    </>
  )}
  {icon === 'cloud' && (
    <path d="M7 18a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 18Z" />
  )}
  {icon === 'rain' && (
    <>
      <path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z" />
      <path d="M9 18v2M13 18v2M17 18v2" />
    </>
  )}
  {icon === 'storm' && (
    <>
      <path d="M7 14a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 14Z" />
      <path d="m13 13-3 5h4l-2 4" />
    </>
  )}
  {icon === 'fog' && (
    <>
      <path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z" />
      <path d="M4 18h16M6 21h12" />
    </>
  )}
  {icon === 'snow' && (
    <>
      <path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z" />
      <path d="M9 19h.01M13 21h.01M17 19h.01" />
    </>
  )}
</svg>
