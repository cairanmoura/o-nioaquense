---
import LogoNioaquense from './LogoNioaquense.astro';

/**
 * Header.astro
 * -----------------------------------------------------------------------------
 * Cabecalho principal: logo, menu de editorias, busca rapida e o botao de
 * destaque "Mande sua Notícia".
 */

const editorias = [
  { href: '/editoria/nioaque', label: 'Nioaque', accent: true },
  { href: '/radar-oficial', label: 'Radar Oficial' },
  { href: '/editoria/coluna', label: 'Colunistas' },
  { href: '/editoria/ms', label: 'MS' },
  { href: '/editoria/brasil', label: 'Brasil' },
];

const searchTerm = Astro.url.searchParams.get('q') ?? '';
const activeScope = Astro.url.searchParams.get('escopo');
---

<header class="border-b border-line bg-nioaque-white">
  <div class="container-editorial">
    <div class="flex items-center gap-3 py-3 sm:gap-5">
      {/* Menu (mobile) */}
      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="menu-mobile"
        class="-ml-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line text-ink transition-colors hover:bg-nioaque-green-50 hover:text-nioaque-green lg:hidden"
      >
        <span class="sr-only">Abrir menu de editorias</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>

      {/* Logo */}
      <a href="/" class="w-28 shrink-0 sm:w-40 lg:w-48" aria-label="O Nioaquense - pagina inicial">
        <LogoNioaquense class="w-full" />
      </a>

      {/* Busca rapida (desktop) */}
      <form
        action="/busca"
        method="get"
        role="search"
        class="ml-auto hidden max-w-xs flex-1 items-center gap-2 rounded-full border border-line bg-editorial px-4 py-2 transition-colors focus-within:border-nioaque-green focus-within:bg-nioaque-white lg:flex"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-ink-muted">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
        <label for="busca-desktop" class="sr-only">Buscar no O Nioaquense</label>
        <input
          id="busca-desktop"
          type="search"
          name="q"
          value={searchTerm}
          placeholder="Buscar notícia..."
          class="w-full bg-transparent text-sm text-ink placeholder:text-ink-muted/80 focus:outline-none"
        />
      </form>

      {/* Botao de destaque */}
      <a
        href="/mande-sua-noticia"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-nioaque-red px-3 py-2.5 text-[11px] font-bold uppercase tracking-[0.1em] text-white transition-colors hover:bg-nioaque-red-dark sm:px-4"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M12 5v14M5 12h14" />
        </svg>
        <span class="hidden sm:inline">Mande sua</span>
        <span>Notícia</span>
      </a>
    </div>

    {/* Menu de editorias (desktop) */}
    <nav aria-label="Editorias" class="hidden border-t border-line lg:block">
      <ul class="flex items-center gap-1 py-2">
        {
          editorias.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={activeScope === item.href.split('/').pop() ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center rounded-full px-4 py-2 text-xs font-bold uppercase tracking-[0.12em] transition-colors',
                  item.accent
                    ? 'bg-nioaque-green text-white hover:bg-nioaque-green-dark'
                    : 'text-ink-soft hover:bg-nioaque-green-50 hover:text-nioaque-green-dark',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="ml-auto">
          <a
            href="/busca"
            class="inline-flex items-center gap-2 rounded-full px-3 py-2 text-xs font-bold uppercase tracking-[0.12em] text-ink-soft transition-colors hover:bg-nioaque-green-50 hover:text-nioaque-green-dark lg:hidden"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" stroke-linecap="round" />
            </svg>
            Buscar
          </a>
        </li>
      </ul>
    </nav>
  </div>

  {/* Painel do menu (mobile) */}
  <div id="menu-mobile" hidden class="border-t border-line bg-editorial lg:hidden">
    <div class="container-editorial py-4">
      <form action="/busca" method="get" role="search" class="mb-4 flex items-center gap-2 rounded-full border border-line bg-nioaque-white px-4 py-2.5">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-ink-muted">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
        <label for="busca-mobile" class="sr-only">Buscar no O Nioaquense</label>
        <input
          id="busca-mobile"
          type="search"
          name="q"
          value={searchTerm}
          placeholder="Buscar notícia..."
          class="w-full bg-transparent text-sm text-ink placeholder:text-ink-muted/80 focus:outline-none"
        />
      </form>

      <nav aria-label="Editorias">
        <ul class="grid grid-cols-2 gap-2">
          {
            editorias.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block rounded-xl px-4 py-3 text-sm font-semibold transition-colors',
                    item.accent
                      ? 'bg-nioaque-green text-white'
                      : 'bg-nioaque-white text-ink ring-1 ring-line hover:bg-nioaque-green-50 hover:text-nioaque-green-dark',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('menu-mobile');

  toggle?.addEventListener('click', () => {
    if (!panel) return;

    const willOpen = panel.hasAttribute('hidden');
    if (willOpen) {
      panel.removeAttribute('hidden');
    } else {
      panel.setAttribute('hidden', '');
    }

    toggle.setAttribute('aria-expanded', String(willOpen));
  });
</script>
