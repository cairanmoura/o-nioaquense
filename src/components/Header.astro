---
import LogoNioaquense from './LogoNioaquense.astro';
import WeatherIcon from './WeatherIcon.astro';
import { getNioaqueWeather } from '../lib/weather';
import { CATEGORIES } from '../lib/categories';
import { getColumnists } from '../lib/colunas';

/**
 * Header.astro
 * -----------------------------------------------------------------------------
 * Header verde-mata (sistema de design) com barra de leitura no topo extremo.
 *   [Logo] Início · Matérias · Utilidade · Transparência · Anuncie ... [Clima] [Busca] [+ Mande sua notícia] [Seções]
 *
 * "Seções" abre um painel compacto (dropdown ancorado ao botão, não tela cheia):
 * locais, serviços e temas. Em telas pequenas o painel também traz a navegação principal.
 */

const principal = [
  { href: '/', label: 'Início' },
  { href: '/materias', label: 'Matérias' },
  { href: '/utilidade', label: 'Utilidade' },
  { href: '/transparencia', label: 'Transparência' },
  { href: '/anuncie', label: 'Anuncie' },
];

const colunasAtivas = (await getColumnists(Astro.locals)).length > 0;
if (colunasAtivas) principal.splice(2, 0, { href: '/colunas', label: 'Colunas' });

const locais = [
  { href: '/materias?local=nioaque', label: 'Nioaque' },
  { href: '/materias?local=regiao', label: 'Região' },
  { href: '/materias?local=ms', label: 'Mato Grosso do Sul' },
  { href: '/materias?local=brasil', label: 'Brasil' },
  { href: '/materias?local=mundo', label: 'Mundo' },
];

const servicos = [
  { href: '/radar-oficial', label: 'Radar Oficial' },
  { href: '/autoridades', label: 'Autoridades públicas' },
  { href: '/colunistas', label: 'Colunistas' },
  { href: '/mande-sua-noticia', label: 'Mande sua notícia' },
  { href: '/expediente', label: 'Sobre o portal' },
];

const temas = CATEGORIES.filter((c) => c.slug !== 'geral').map((c) => ({
  href: `/materias?tema=${c.slug}`,
  label: c.label,
}));

const weather = await getNioaqueWeather(Astro.locals);
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const heading = 'text-[11px] font-bold uppercase tracking-[0.14em] text-nioaque-green';
const itemLink = 'block rounded-[4px] px-2 py-1.5 text-sm font-semibold text-ink hover:bg-nioaque-green-50 hover:text-nioaque-green-dark';
---

<div class="barra-leitura" aria-hidden="true"><i id="barra-leitura-fill"></i></div>

<header class="relative z-40 bg-verde-mata text-white">
  <div class="container-editorial box-border flex min-h-16 w-full flex-row items-center justify-between gap-2 py-2 sm:py-3">
    <div class="flex min-w-0 items-center gap-3 lg:gap-6">
      <a href="/" class="flex shrink-0" aria-label="O Nioaquense - página inicial">
        <LogoNioaquense tone="branca" class="h-[38px] w-auto sm:h-[56px] lg:h-[68px]" />
      </a>

      <nav aria-label="Principal" class="hidden min-w-0 xl:block">
        <ul class="flex items-center gap-5">
          {
            principal.map((item) => {
              const active = isActive(item.href);
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'inline-flex items-center whitespace-nowrap border-b-[3px] py-1.5 text-[15px] transition-colors',
                      active ? 'border-nioaque-red font-semibold text-white' : 'border-transparent font-medium text-white/90 hover:text-white',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <a
        href="/clima"
        class="flex min-h-11 items-center gap-1 rounded-[4px] px-1.5 text-sm font-semibold text-white hover:bg-white/10"
        aria-label={`Clima em Nioaque: ${weather.temperature} graus`}
      >
        <WeatherIcon icon={weather.icon ?? 'cloud'} size={18} />
        <span class="tabular-nums">{weather.temperature}°C</span>
      </a>

      <a
        href="/busca"
        class="inline-flex h-11 w-11 items-center justify-center rounded-[4px] text-white hover:bg-white/10"
        aria-label="Buscar"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
        </svg>
      </a>

      <button
        id="tema-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-[4px] text-white hover:bg-white/10"
        aria-label="Alternar tema claro/escuro"
      >
        <svg class="theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <a
        href="/mande-sua-noticia"
        class="hidden min-h-11 items-center whitespace-nowrap rounded-[4px] bg-nioaque-red px-5 text-[15px] font-semibold text-white transition-colors hover:bg-nioaque-red-dark md:inline-flex"
      >
        + Mande sua notícia
      </a>

      <div class="relative">
        <button
          id="secoes-toggle"
          type="button"
          class="inline-flex h-11 min-w-11 items-center justify-center gap-1 rounded-[4px] px-2 text-sm font-semibold text-white hover:bg-white/10 sm:px-3"
          aria-label="Abrir menu de seções"
          aria-expanded="false"
          aria-controls="secoes-panel"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 12h18M3 6h18M3 18h18"></path>
          </svg>
          <span class="hidden sm:inline">Seções ▾</span>
        </button>

        <div
          id="secoes-panel"
          hidden
          class="absolute right-0 top-full z-50 mt-2 max-h-[calc(100vh-5rem)] w-[min(calc(100vw-2rem),30rem)] overflow-y-auto rounded-[4px] border border-pedra bg-branco p-4 text-ink"
        >
<div class="xl:hidden">
            <p class={heading}>Navegar</p>
            <ul class="mt-1.5 grid grid-cols-2 gap-x-2">
              {principal.map((i) => (<li><a href={i.href} class={itemLink}>{i.label}</a></li>))}
            </ul>
          </div>

          <div class="grid grid-cols-2 gap-x-4 gap-y-3 mt-3 xl:mt-0">
            <div>
              <p class={heading}>Por local</p>
              <ul class="mt-1.5">
                {locais.map((i) => (<li><a href={i.href} class={itemLink}>{i.label}</a></li>))}
              </ul>
            </div>
            <div>
              <p class={heading}>Serviços</p>
              <ul class="mt-1.5">
                {servicos.map((i) => (<li><a href={i.href} class={itemLink}>{i.label}</a></li>))}
              </ul>
            </div>
          </div>

          <div class="mt-3 border-t border-pedra pt-3">
            <p class={heading}>Por tema</p>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {
                temas.map((i) => (
                  <li>
                    <a href={i.href} class="inline-block rounded-[4px] border border-pedra px-2.5 py-1 text-xs font-semibold text-ink hover:border-nioaque-green hover:bg-nioaque-green-50 hover:text-nioaque-green-dark">
                      {i.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href="/materias" class="mt-3 inline-flex text-sm font-semibold text-nioaque-green-dark hover:underline">Ver todas as matérias →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('secoes-toggle')!;
  const panel = document.getElementById('secoes-panel')!;
  const setOpen = (open: boolean) => {
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
  };
  toggle.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(panel.hidden);
  });
  document.addEventListener('click', (e) => {
    if (!panel.hidden && !panel.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // Tema claro/escuro
  document.getElementById('tema-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('tema', next); } catch {}
  });

  // Barra de leitura: progresso de rolagem da pagina (4px, topo extremo).
  const fill = document.getElementById('barra-leitura-fill') as HTMLElement | null;
  if (fill) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      fill.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
      ticking = false;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>
