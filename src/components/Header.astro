---
import LogoNioaquense from './LogoNioaquense.astro';
import WeatherIcon from './WeatherIcon.astro';
import { getNioaqueWeather } from '../lib/weather';
import { CATEGORIES } from '../lib/categories';

/**
 * Header.astro
 * -----------------------------------------------------------------------------
 * Linha unica, fundo branco.
 *   [Logo] Início · Matérias · Utilidade Pública · Anuncie ... [Clima] [Busca] [+ Mande sua notícia] [Seções]
 *
 * "Seções" abre um painel compacto (dropdown ancorado ao botão, não tela cheia):
 * locais, serviços e temas. Em telas pequenas o painel também traz a navegação principal.
 */

const principal = [
  { href: '/', label: 'Início' },
  { href: '/materias', label: 'Matérias' },
  { href: '/utilidade', label: 'Utilidade Pública' },
  { href: '/anuncie', label: 'Anuncie' },
];

const locais = [
  { href: '/materias?local=nioaque', label: 'Nioaque' },
  { href: '/materias?local=regiao', label: 'Região' },
  { href: '/materias?local=ms', label: 'Mato Grosso do Sul' },
  { href: '/materias?local=brasil', label: 'Brasil' },
  { href: '/materias?local=mundo', label: 'Mundo' },
];

const servicos = [
  { href: '/radar-oficial', label: 'Radar Oficial' },
  { href: '/autoridades', label: 'Autoridades públicas' },
  { href: '/colunistas', label: 'Colunistas' },
  { href: '/mande-sua-noticia', label: 'Mande sua notícia' },
  { href: '/expediente', label: 'Sobre o portal' },
];

const temas = CATEGORIES.filter((c) => c.slug !== 'geral').map((c) => ({
  href: `/materias?tema=${c.slug}`,
  label: c.label,
}));

const weather = await getNioaqueWeather(Astro.locals);
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const heading = 'text-[11px] font-bold uppercase tracking-[0.14em] text-nioaque-green';
const itemLink = 'block rounded-[4px] px-2 py-1.5 text-sm font-semibold text-ink hover:bg-nioaque-green-50 hover:text-nioaque-green-dark';
---

<header class="relative z-40 h-16 border-b border-slate-200 bg-white shadow-sm">
  <div class="container-editorial box-border flex h-full w-full flex-row items-center justify-between gap-2">
    <div class="flex min-w-0 items-center gap-3 lg:gap-5">
      <a href="/" class="flex shrink-0" aria-label="O Nioaquense - página inicial">
        <LogoNioaquense class="h-7 w-auto max-w-[120px] sm:h-10 sm:max-w-none" />
      </a>

      <nav aria-label="Principal" class="hidden min-w-0 lg:block">
        <ul class="flex items-center gap-0.5">
          {
            principal.map((item) => {
              const active = isActive(item.href);
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'inline-flex items-center whitespace-nowrap rounded-[4px] px-2.5 py-1.5 text-sm font-semibold transition-colors',
                      active ? 'bg-nioaque-green text-white' : 'text-ink hover:bg-nioaque-green-50 hover:text-nioaque-green-dark',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <a
        href="/#clima"
        class="flex items-center gap-1 rounded-[4px] px-1.5 py-1.5 text-sm font-semibold text-ink hover:bg-nioaque-green-50"
        aria-label={`Clima em Nioaque: ${weather.temperature} graus`}
      >
        <WeatherIcon icon={weather.icon ?? 'cloud'} size={18} />
        <span class="tabular-nums">{weather.temperature}°C</span>
      </a>

      <a
        href="/busca"
        class="rounded-[4px] p-2 text-ink hover:bg-nioaque-green-50 hover:text-nioaque-green"
        aria-label="Buscar"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
        </svg>
      </a>

      <a
        href="/mande-sua-noticia"
        class="hidden items-center whitespace-nowrap rounded-[4px] border border-nioaque-red px-3 py-1.5 text-sm font-semibold text-nioaque-red-dark transition-colors hover:bg-nioaque-red hover:text-white md:inline-flex"
      >
        + Mande sua notícia
      </a>

      <div class="relative">
        <button
          id="secoes-toggle"
          type="button"
          class="inline-flex items-center gap-1 rounded-[4px] border border-slate-200 bg-white p-2 text-sm font-semibold text-ink hover:bg-nioaque-green-50 sm:px-3 sm:py-1.5"
          aria-label="Abrir menu de seções"
          aria-expanded="false"
          aria-controls="secoes-panel"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
            <path d="M3 12h18M3 6h18M3 18h18"></path>
          </svg>
          <span class="hidden sm:inline">Seções ▾</span>
        </button>

        <div
          id="secoes-panel"
          hidden
          class="absolute right-0 top-full z-50 mt-2 max-h-[calc(100vh-5rem)] w-[min(calc(100vw-2rem),30rem)] overflow-y-auto rounded-md border border-slate-200 bg-white p-4 shadow-xl"
        >
          <div class="lg:hidden">
            <p class={heading}>Navegar</p>
            <ul class="mt-1.5 grid grid-cols-2 gap-x-2">
              {principal.map((i) => (<li><a href={i.href} class={itemLink}>{i.label}</a></li>))}
            </ul>
          </div>

          <div class="grid grid-cols-2 gap-x-4 gap-y-3 lg:mt-0 mt-3">
            <div>
              <p class={heading}>Por local</p>
              <ul class="mt-1.5">
                {locais.map((i) => (<li><a href={i.href} class={itemLink}>{i.label}</a></li>))}
              </ul>
            </div>
            <div>
              <p class={heading}>Serviços</p>
              <ul class="mt-1.5">
                {servicos.map((i) => (<li><a href={i.href} class={itemLink}>{i.label}</a></li>))}
              </ul>
            </div>
          </div>

          <div class="mt-3 border-t border-slate-200 pt-3">
            <p class={heading}>Por tema</p>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {
                temas.map((i) => (
                  <li>
                    <a href={i.href} class="inline-block rounded-full border border-slate-200 px-2.5 py-1 text-xs font-semibold text-ink hover:border-nioaque-green hover:bg-nioaque-green-50 hover:text-nioaque-green-dark">
                      {i.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href="/materias" class="mt-3 inline-flex text-sm font-semibold text-nioaque-green-dark hover:underline">Ver todas as matérias →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('secoes-toggle')!;
  const panel = document.getElementById('secoes-panel')!;
  const setOpen = (open: boolean) => {
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
  };
  toggle.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(panel.hidden);
  });
  document.addEventListener('click', (e) => {
    if (!panel.hidden && !panel.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
