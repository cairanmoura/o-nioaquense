---
import LogoNioaquense from './LogoNioaquense.astro';
import WeatherIcon from './WeatherIcon.astro';
import { getNioaqueWeather } from '../lib/weather';

/**
 * Header.astro
 * -----------------------------------------------------------------------------
 * Header de LINHA UNICA, fundo branco opaco, borda/sombra sutil.
 *
 * Ordem esquerda -> direita:
 *   [Logo] [Menu geografico] ... [Clima] [Busca] [+ Mande sua noticia] [Secoes]
 *
 * As editorias tematicas ficam escondidas no painel "Secoes".
 */

const categoriasGeograficas = [
  { href: '/editoria/nioaque', label: 'Nioaque' },
  { href: '/editoria/regiao', label: 'Região' },
  { href: '/editoria/ms', label: 'MS' },
  { href: '/editoria/brasil', label: 'Brasil' },
  { href: '/radar-oficial', label: 'Radar' },
];

const secoesTematicas = [
  { href: '/editoria/politica-poder', label: 'Política & Poder' },
  { href: '/editoria/agro-campo', label: 'Agro & Campo' },
  { href: '/editoria/policia-justica', label: 'Polícia & Justiça' },
  { href: '/editoria/saude', label: 'Saúde' },
  { href: '/editoria/educacao', label: 'Educação' },
  { href: '/editoria/esporte', label: 'Esporte' },
  { href: '/editoria/cultura', label: 'Cultura' },
];

const weather = await getNioaqueWeather(Astro.locals);
const path = Astro.url.pathname;
const isActive = (href: string) => path === href;
---

<header class="h-16 border-b border-slate-200 bg-white shadow-sm">
  <div class="container-editorial box-border flex h-full w-full flex-row items-center justify-between gap-2">
    <div class="flex min-w-0 items-center gap-3 lg:gap-5">
      <a href="/" class="flex shrink-0" aria-label="O Nioaquense - página inicial">
        <LogoNioaquense class="h-7 w-auto max-w-[120px] sm:h-10 sm:max-w-none" />
      </a>

      <nav aria-label="Categorias geográficas" class="hidden min-w-0 lg:block">
        <ul class="flex items-center gap-0.5">
          {
            categoriasGeograficas.map((item) => {
              const active = isActive(item.href);
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'inline-flex items-center whitespace-nowrap rounded-[4px] px-2.5 py-1.5 text-sm font-semibold transition-colors',
                      active
                        ? 'bg-nioaque-green text-white'
                        : 'bg-white text-ink hover:bg-nioaque-green-50 hover:text-nioaque-green-dark',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <a
        href="/#clima"
        class="flex items-center gap-1 rounded-[4px] px-1.5 py-1.5 text-sm font-semibold text-ink hover:bg-nioaque-green-50"
        aria-label={`Clima em Nioaque: ${weather.temperature} graus`}
      >
        <WeatherIcon icon={weather.icon ?? 'cloud'} size={18} />
        <span class="tabular-nums">{weather.temperature}°C</span>
      </a>

      <a
        href="/busca"
        class="rounded-[4px] p-2 text-ink hover:bg-nioaque-green-50 hover:text-nioaque-green"
        aria-label="Buscar"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
        </svg>
      </a>

      <a
        href="/mande-sua-noticia"
        class="hidden items-center whitespace-nowrap rounded-[4px] border border-nioaque-red px-3 py-1.5 text-sm font-semibold text-nioaque-red-dark transition-colors hover:bg-nioaque-red hover:text-white md:inline-flex"
      >
        + Mande sua notícia
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex items-center gap-1 rounded-[4px] border border-slate-200 bg-white p-2 text-sm font-semibold text-ink hover:bg-nioaque-green-50 sm:px-3 sm:py-1.5"
        aria-label="Abrir menu de seções"
        aria-expanded="false"
        aria-controls="menu-mobile"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 12h18M3 6h18M3 18h18"></path>
        </svg>
        <span class="hidden sm:inline">Seções ▾</span>
      </button>
    </div>
  </div>
</header>

<div id="menu-mobile" class="fixed inset-0 z-50 hidden overflow-y-auto bg-white">
  <div class="container-editorial py-5">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">Menu</span>
      <button id="menu-close" type="button" class="rounded-[4px] p-2 text-ink-muted hover:text-nioaque-red-dark" aria-label="Fechar menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <p class="mt-4 text-xs font-bold uppercase tracking-wider text-nioaque-green">Onde</p>
    <ul class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-5">
      {
        categoriasGeograficas.map((c) => (
          <li>
            <a href={c.href} class="block rounded-[4px] border border-slate-200 px-3 py-2.5 text-sm font-semibold text-ink hover:bg-nioaque-green-50">
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-xs font-bold uppercase tracking-wider text-nioaque-green">Seções</p>
    <ul class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
      {
        secoesTematicas.map((s) => (
          <li>
            <a href={s.href} class="block rounded-[4px] border border-slate-200 px-4 py-3 text-sm font-semibold text-ink hover:bg-nioaque-green-50 hover:text-nioaque-green">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a href="/mande-sua-noticia" class="mt-6 inline-flex items-center rounded-[4px] bg-nioaque-red px-4 py-2.5 text-sm font-semibold text-white hover:bg-nioaque-red-dark">
      + Mande sua notícia
    </a>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const panel = document.getElementById('menu-mobile')!;
  const setOpen = (open: boolean) => {
    panel.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setOpen(panel.classList.contains('hidden')));
  document.getElementById('menu-close')?.addEventListener('click', () => setOpen(false));
</script>
