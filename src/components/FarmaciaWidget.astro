---
import type { PublicUtility } from '../lib/types';

/**
 * FarmaciaWidget.astro
 * -----------------------------------------------------------------------------
 * Widget compacto da farmacia de plantao para a coluna lateral (sidebar) da Home.
 * Exibe apenas o nome, telefone e WhatsApp, sem poluir o cabeçalho.
 */

interface Props {
  utility: PublicUtility | null;
  class?: string;
}

const { utility, class: className = '' } = Astro.props;

const pharmacyDigits = (utility?.pharmacy_phone ?? '').replace(/\D/g, '');
const pharmacyTel = pharmacyDigits ? `tel:${pharmacyDigits}` : '#';
const pharmacyWhatsapp = pharmacyDigits ? `https://wa.me/${pharmacyDigits}` : '#';
---

<section
  class:list={[
    'overflow-hidden rounded-[4px] border border-line bg-nioaque-white p-4',
    className,
  ]}
  aria-label="Farmácia de plantão"
>
  <h3 class="text-xs font-semibold text-ink-muted uppercase tracking-wider mb-3">
    Farmácia de plantão
  </h3>

  {utility ? (
    <>
      <p class="font-editorial text-base font-semibold leading-tight text-ink mb-2">
        {utility.pharmacy_name}
      </p>
      {utility.pharmacy_address && (
        <p class="text-xs text-ink-soft mb-3">{utility.pharmacy_address}</p>
      )}
      <div class="flex gap-2">
        <a
          href={pharmacyTel}
          class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-[4px] bg-nioaque-green px-3 py-2 text-xs font-semibold text-white transition-colors hover:bg-nioaque-green-dark"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"
            />
          </svg>
          Ligar
        </a>
        <a
          href={pharmacyWhatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-[4px] bg-[#075E54] px-3 py-2 text-xs font-semibold text-white transition-colors hover:bg-[#054d45]"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.83 9.83 0 0 0 4.68 1.2h.01c5.43 0 9.84-4.4 9.84-9.84C21.89 6.4 17.48 2 12.04 2Zm5.76 14.02c-.24.68-1.4 1.3-1.94 1.36-.54.06-1.04.08-1.68-.12-.4-.12-.9-.3-1.56-.58-2.74-1.18-4.52-3.94-4.66-4.12-.14-.18-1.12-1.5-1.12-2.86 0-1.36.7-2.02.96-2.3.26-.28.56-.34.74-.34.18 0 .38 0 .54.02.18.02.42-.06.66.5.24.56.82 1.94.9 2.08.06.14.1.3.02.48-.08.18-.12.3-.24.46-.12.16-.26.36-.36.48-.12.12-.26.26-.1.5.14.24.64 1.06 1.38 1.72.94.84 1.74 1.1 1.98 1.22.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.6-.18 1.2Z" />
          </svg>
          WhatsApp
        </a>
      </div>
    </>
  ) : (
    <p class="text-sm text-ink-soft">Sem informação disponível hoje.</p>
  )}
</section>
