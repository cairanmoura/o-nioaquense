---
import type { MarketQuote } from '../lib/types';

/**
 * AgroBand.astro - ticker fino de ponta a ponta (divisor de secoes).
 * Dolar, Boi Gordo (@ MS) e Soja (Sc 60kg), vindos de `market_quotes`.
 */
interface Props {
  quotes: MarketQuote[];
}
const { quotes } = Astro.props;

const find = (symbol: string) => quotes.find((q) => q.symbol === symbol);
const items = [
  { icon: '💵', label: 'Dólar', quote: find('dolar') },
  { icon: '🐂', label: 'Boi Gordo (@ MS)', quote: find('boi_gordo') },
  { icon: '🌱', label: 'Soja (Sc 60kg)', quote: find('soja') },
];
const brl = (n: number) => 'R$ ' + n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---

<section aria-label="Cotações" class="w-full bg-[#00661E] text-white">
  <ul class="no-scrollbar mx-auto flex h-12 w-full items-center justify-start gap-6 overflow-x-auto whitespace-nowrap px-4 sm:h-14 sm:justify-center sm:gap-10">
    {
      items.map(({ icon, label, quote }) => (
        <li class="flex shrink-0 items-center gap-2 text-sm">
          <span aria-hidden="true">{icon}</span>
          <span class="font-semibold text-white/85">{label}</span>
          <span class="font-extrabold tabular-nums">{quote ? brl(quote.value) : '--'}</span>
        </li>
      ))
    }
  </ul>
</section>
