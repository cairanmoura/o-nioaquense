---
import type { MarketQuote } from '../lib/types';

/**
 * AgroBand.astro
 * Faixa verde-escura de ponta a ponta: Dolar, Arroba do Boi Gordo (MS) e
 * Saca de Soja 60kg (Maracaju/Regiao). Valores vem de `market_quotes`
 * (symbols: dolar, boi_gordo, soja); sem dado, o bloco mostra "--".
 */
interface Props {
  quotes: MarketQuote[];
}
const { quotes } = Astro.props;

const find = (...symbols: string[]) => quotes.find((q) => symbols.includes(q.symbol));

const blocks = [
  { label: 'Dólar Comercial', sub: 'Cotação do dia', quote: find('dolar', 'usd'), prefix: 'R$ ' },
  { label: 'Arroba do Boi Gordo', sub: 'Mato Grosso do Sul', quote: find('boi_gordo', 'boi', 'arroba_boi'), prefix: 'R$ ' },
  { label: 'Saca de Soja 60kg', sub: 'Maracaju / Região', quote: find('soja', 'soja_maracaju', 'saca_soja'), prefix: 'R$ ' },
];

const fmt = (n: number) => n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---

<section aria-label="Cotação Agro de Nioaque" class="w-full border-t-4 border-ocre bg-mercado text-[#F7F5F0]">
  <div class="container-editorial py-7 sm:py-8">
    <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-ocre">Mercado</p>
    <h2 class="mt-1 font-serif text-2xl font-bold leading-tight text-[#F7F5F0] sm:text-[30px] sm:leading-[34px]">Cotação Agro de Nioaque</h2>
    <dl class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-10">
      {
        blocks.map(({ label, sub, quote, prefix }) => {
          const up = (quote?.change_percent ?? 0) >= 0;
          return (
            <div>
              <dt class="text-sm font-semibold text-mercado-rotulo">{label}</dt>
              <dd class="mt-1 flex items-baseline gap-2">
                <span class="text-[30px] font-semibold leading-[34px] tabular-nums text-[#F7F5F0]">
                  {quote ? `${prefix}${fmt(quote.value)}` : '--'}
                </span>
                {quote && (
                  <span class:list={['text-xs font-bold tabular-nums', up ? 'text-[#6FCB8B]' : 'text-nioaque-red-light']}>
                    {up ? '▲ +' : '▼ '}
                    {fmt(quote.change_percent)}%
                  </span>
                )}
              </dd>
              <p class="mt-0.5 text-xs text-mercado-rotulo">{sub}</p>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>
