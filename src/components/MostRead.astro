---
import type { Article, Profile } from '../lib/types';

/**
 * MostRead.astro
 * -----------------------------------------------------------------------------
 * "Mais lidas" - o ranking de leituras da casa, ordenado por `views_count`.
 */

interface Props {
  articles: Article[];
  authors?: Map<string, Profile>;
  title?: string;
  class?: string;
  limit?: number;
}

const {
  articles,
  authors,
  title = 'Mais lidas',
  class: className = '',
  limit = 5,
} = Astro.props;

const top = [...articles]
  .sort((a, b) => b.views_count - a.views_count)
  .slice(0, limit);
---

{
  top.length > 0 && (
    <section
      class:list={['overflow-hidden rounded-2xl border border-line bg-nioaque-white', className]}
      aria-label={title}
    >
      <header class="border-b border-line bg-ink px-4 py-2.5">
        <h2 class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-white">
          {title}
        </h2>
      </header>

      <ol class="divide-y divide-line">
        {top.map((article, index) => (
          <li class="flex items-start gap-3 px-4 py-3">
            <span
              class:list={[
                'flex h-7 w-7 shrink-0 items-center justify-center rounded-full font-editorial text-sm font-semibold',
                index === 0
                  ? 'bg-nioaque-red text-white'
                  : index === 1
                    ? 'bg-nioaque-green text-white'
                    : 'bg-ink/10 text-ink-soft',
              ]}
            >
              {index + 1}
            </span>

            <div class="min-w-0 flex-1">
              {article.category_label && (
                <p class="text-[9px] font-bold uppercase tracking-[0.14em] text-nioaque-green">
                  {article.category_label}
                </p>
              )}
              <a
                href={`/noticia/${article.slug}`}
                class="mt-0.5 block font-editorial text-[0.9375rem] font-semibold leading-snug text-ink transition-colors hover:text-nioaque-green"
              >
                {article.title}
              </a>
              {authors?.get(article.author_id) && (
                <p class="mt-1 text-[11px] text-ink-muted">
                  {authors.get(article.author_id)!.column_name ??
                    authors.get(article.author_id)!.full_name}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}
