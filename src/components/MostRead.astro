---
import type { Article, Profile } from '../lib/types';

/**
 * MostRead.astro - "Mais lidas" numerada de 1 a 5.
 */
interface Props {
  articles: Article[];
  authors?: Map<string, Profile>;
  title?: string;
  class?: string;
  limit?: number;
}

const { articles, title = 'Mais lidas', class: className = '', limit = 5 } = Astro.props;

const top = [...articles].sort((a, b) => b.views_count - a.views_count).slice(0, limit);
---

{
  top.length > 0 && (
    <section class:list={['overflow-hidden rounded-[4px] border border-pedra bg-white', className]} aria-label={title}>
      <header class="border-b border-pedra bg-[#166A34] px-4 py-3">
        <h2 class="text-base font-extrabold text-white">{title}</h2>
      </header>
      <ol class="divide-y divide-pedra">
        {top.map((article, index) => (
          <li class="flex items-start gap-3 px-4 py-3">
            <span class:list={['w-7 shrink-0 text-2xl font-extrabold leading-none tabular-nums', index === 0 ? 'text-nioaque-red-dark' : 'text-slate-300']} aria-hidden="true">
              {index + 1}
            </span>
            <a href={`/noticia/${article.slug}`} class="block min-w-0 text-base font-bold leading-snug text-ink transition-colors hover:text-nioaque-green">
              {article.title}
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}
