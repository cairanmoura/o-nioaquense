---
import LocalAdBanner from './LocalAdBanner.astro';
import type { LocalAd } from '../lib/types';

/**
 * AdStrip.astro - banner horizontal curto (altura reservada, zero CLS).
 * Sem anuncio: mosaico nas cores da cidade com "ESPACO PUBLICITARIO - ANUNCIE AQUI".
 * Todo link de anuncio vai para /anuncie.
 */
interface Props {
  ad?: LocalAd | null;
  class?: string;
  label?: string;
}
const { ad = null, class: className = '', label = 'Publicidade' } = Astro.props;
---

<div class:list={['min-h-[90px] w-full', className]}>
  {
    ad ? (
      <LocalAdBanner ad={ad} label={label} class="h-full rounded-[4px]" />
    ) : (
      <a
        href="/anuncie"
        aria-label="Espaço publicitário - anuncie aqui"
        class="relative flex h-[90px] w-full items-center justify-center overflow-hidden rounded-[4px] border border-pedra bg-[#FAF9F6] text-center"
      >
        <span class="absolute inset-0 flex" aria-hidden="true">
          <span class="h-full w-[18%] bg-[#166A34]"></span>
          <span class="h-full w-[64%] bg-branco"></span>
          <span class="h-full w-[18%] bg-[#D92323]"></span>
        </span>
        <span class="relative z-10 rounded-[4px] bg-branco px-3 py-1.5">
          <span class="block text-[11px] font-extrabold uppercase tracking-wider text-ink">Espaço publicitário</span>
          <span class="block text-[11px] font-bold uppercase tracking-wider text-nioaque-green">Anuncie aqui</span>
        </span>
      </a>
    )
  }
</div>
