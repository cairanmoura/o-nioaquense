---
import { getNioaqueWeather } from '../lib/weather';
import type { WeatherIcon } from '../lib/weather';

/**
 * WeatherWidget.astro
 * -----------------------------------------------------------------------------
 * Retrato completo do tempo em Nioaque: agora, min/max, sensacao, vento,
 * umidade, chance de chuva, nascer/por do sol e a previsao dos proximos dias.
 *
 * Dados: Open-Meteo (gratuito, sem chave), com cache de 15 min na borda.
 */

const weather = await getNioaqueWeather(Astro.locals);

const ICONS: Record<WeatherIcon, string> = {
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.5 6.5 4.9 4.9M19.1 19.1l-1.6-1.6M17.5 6.5l1.6-1.6M4.9 19.1l1.6-1.6"/>',
  cloud: '<path d="M7 18a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 18Z"/>',
  rain: '<path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z"/><path d="M9 18v2M13 18v2M17 18v2"/>',
  storm: '<path d="M7 14a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 14Z"/><path d="m13 13-3 5h4l-2 4"/>',
  fog: '<path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z"/><path d="M4 18h16M6 21h12"/>',
  snow: '<path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z"/><path d="M9 19h.01M13 21h.01M17 19h.01"/>',
};

const SKY: Record<WeatherIcon, { bg: string; ink: string }> = {
  sun: { bg: 'linear-gradient(100deg,#fff6dc 0%,#ffe7b0 55%,#ffd27a 100%)', ink: '#c2740a' },
  cloud: { bg: 'linear-gradient(100deg,#eef2f4 0%,#dbe3e8 60%,#c7d2d9 100%)', ink: '#5d7280' },
  rain: { bg: 'linear-gradient(100deg,#e6eef4 0%,#c8d8e4 60%,#a9c0d1 100%)', ink: '#3f6682' },
  storm: { bg: 'linear-gradient(100deg,#dfe2ec 0%,#bcc2d6 60%,#9aa2c0 100%)', ink: '#454e78' },
  fog: { bg: 'linear-gradient(100deg,#f1f1ee 0%,#dfdfd9 60%,#cfcfc6 100%)', ink: '#6b6b60' },
  snow: { bg: 'linear-gradient(100deg,#f1f6fb 0%,#dbe8f3 60%,#c6dbed 100%)', ink: '#4f7aa0' },
};
const sky = SKY[weather.icon] ?? SKY.cloud;

const details = [
  { label: 'Sensação', value: `${weather.feelsLike}°` },
  { label: 'Vento', value: `${weather.windSpeed} km/h` },
  { label: 'Umidade', value: `${weather.humidity}%` },
  { label: 'Chuva', value: `${weather.rainChance}%` },
];
---

<section
  class="overflow-hidden rounded-[4px] bg-nioaque-white"
  aria-label="Clima em Nioaque"
>
  {/* Agora: faixa de ponta a ponta, com a ilustracao do tempo atual */}
  <div class="relative flex items-center gap-4 overflow-hidden p-5" style={`background:${sky.bg}`}>
    <svg
      aria-hidden="true"
      class="pointer-events-none absolute -right-4 top-1/2 h-44 w-44 -translate-y-1/2 opacity-25 sm:right-6 sm:h-52 sm:w-52"
      viewBox="0 0 24 24"
      fill="none"
      stroke={sky.ink}
      stroke-width="0.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={ICONS[weather.icon]}
    />
    <span class="relative flex h-16 w-16 shrink-0 items-center justify-center rounded-[4px] bg-white/80 text-nioaque-green">
      <svg
        width="30"
        height="30"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={ICONS[weather.icon]}
      />
    </span>

    <div class="relative min-w-0 flex-1">
      <p class="flex flex-wrap items-baseline gap-x-2">
        <span class="font-editorial text-4xl font-extrabold leading-none text-ink">
          {weather.temperature}°C
        </span>
        <span class="text-sm font-semibold text-ink">{weather.label}</span>
      </p>
      <p class="mt-1 text-xs text-ink-soft">
        Nioaque, MS &middot; Mín. <strong class="font-semibold text-ink">{weather.tempMin}°</strong>
        &middot; Máx. <strong class="font-semibold text-ink">{weather.tempMax}°</strong>
      </p>
    </div>
  </div>

  {/* Indicadores */}
  <dl class="grid grid-cols-2 gap-2 px-3 pt-3 sm:grid-cols-4">
    {
      details.map((detail) => (
        <div class="rounded-[4px] border border-line bg-editorial px-2 py-3 text-center">
          <dt class="text-xs font-medium text-ink-muted">{detail.label}</dt>
          <dd class="mt-0.5 font-editorial text-base font-extrabold text-ink">{detail.value}</dd>
        </div>
      ))
    }
  </dl>

  {/* Sol */}
  <div class="grid grid-cols-2 gap-2 px-3 py-3 text-xs font-semibold text-ink-soft">
    <span class="inline-flex items-center justify-center gap-1.5 rounded-[4px] border border-line bg-editorial px-2 py-2.5">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-amber-500">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
      </svg>
      Nascer {weather.sunrise}
    </span>
    <span class="inline-flex items-center justify-center gap-1.5 rounded-[4px] border border-line bg-editorial px-2 py-2.5">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-nioaque-red-dark">
        <path d="M12 3v6M5.6 5.6l3.5 3.5M3 13h6M18 13h3M14.9 9.1l3.5-3.5" stroke-linecap="round" />
        <path d="M4 18h16" stroke-linecap="round" />
      </svg>
      Pôr {weather.sunset}
    </span>
  </div>

  {/* Previsao dos proximos dias */}
  {
    weather.forecast.length > 0 && (
      <ul class="grid grid-cols-3 gap-2 px-3 pb-3 sm:grid-cols-6">
        {weather.forecast.slice(1, 7).map((day) => (
          <li class="rounded-[4px] border border-line bg-editorial px-2 py-3 text-center">
            <p class="text-xs font-medium text-ink-muted">
              {day.weekday} {day.day}
            </p>
            <p class="mt-1 font-editorial text-base font-extrabold text-ink">
              <span class="text-nioaque-red-dark">{day.tempMax}°</span>
              <span class="text-ink-muted"> / {day.tempMin}°</span>
            </p>
            <p class="mt-0.5 text-xs font-semibold text-nioaque-green">{day.rainChance}%</p>
          </li>
        ))}
      </ul>
    )
  }
</section>
