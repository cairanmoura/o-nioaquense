---
import { formatLongDate } from '../lib/format';
import type { PublicUtility } from '../lib/types';

/**
 * ServiceBlock.astro
 * -----------------------------------------------------------------------------
 * Atalhos uteis do portal. A farmacia de plantao foi retirada desta secao;
 * o clima agora aparece minimizado na barra fixa abaixo do cabecalho.
 */

interface Props {
  utility: PublicUtility | null;
  class?: string;
}

const { utility, class: className = '' } = Astro.props;
---

<section id="servicos" class:list={['scroll-mt-28', className]}>
  <div class="overflow-hidden rounded-[4px] bg-nioaque-white">
    <header class="flex items-center gap-2 bg-nioaque-green px-5 py-3">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white">
        <path d="M12 2 4 6v6c0 5 3.4 8.9 8 10 4.6-1.1 8-5 8-10V6l-8-4Z" stroke-linejoin="round" />
      </svg>
      <h2 class="font-editorial text-lg font-semibold text-white">Serviços do dia</h2>
      {
        utility && (
          <span class="ml-auto text-xs font-medium text-white/80">
            {formatLongDate(utility.duty_date)}
          </span>
        )
      }
    </header>

    <div class="grid md:grid-cols-2">
      {/* Atalhos */}
      <div class="p-5">
        <h3 class="text-xs font-semibold text-ink-muted">Atalhos</h3>

        <ul class="mt-3 space-y-2.5 text-sm">
          <li>
            <a
              href="/radar-oficial"
              class="link-underline font-semibold text-ink transition-colors hover:text-nioaque-red"
            >
              Radar Oficial da cidade
            </a>
          </li>
          <li>
            <a
              href="/#comercio"
              class="link-underline font-semibold text-ink transition-colors hover:text-nioaque-red"
            >
              Destaque do comércio local
            </a>
          </li>
          <li>
            <a
              href="/mande-sua-noticia"
              class="link-underline font-semibold text-ink transition-colors hover:text-nioaque-red"
            >
              Enviar uma pista à redação
            </a>
          </li>
          <li>
            <a
              href="/busca"
              class="link-underline font-semibold text-ink transition-colors hover:text-nioaque-red"
            >
              Buscar no portal
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
