---
import { formatLongDate } from '../lib/format';
import type { PublicUtility } from '../lib/types';

/**
 * ServiceBlock.astro
 * -----------------------------------------------------------------------------
 * Painel de servicos do dia: farmacia de plantao, horarios de onibus e atalhos
 * uteis. O alerta da cidade fica na barra fixa (NioaqueServiceBar).
 */

interface Props {
  utility: PublicUtility | null;
  class?: string;
}

const { utility, class: className = '' } = Astro.props;

const pharmacyDigits = (utility?.pharmacy_phone ?? '').replace(/\D/g, '');
const pharmacyTel = pharmacyDigits ? `tel:${pharmacyDigits}` : '#';
const pharmacyWhatsapp = pharmacyDigits ? `https://wa.me/${pharmacyDigits}` : '#';
---

<section id="servicos" class:list={['scroll-mt-28', className]}>
  <div class="overflow-hidden rounded-sm bg-nioaque-white">
    <header class="flex items-center gap-2 bg-nioaque-green px-5 py-3">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white">
        <path d="M12 2 4 6v6c0 5 3.4 8.9 8 10 4.6-1.1 8-5 8-10V6l-8-4Z" stroke-linejoin="round" />
      </svg>
      <h2 class="font-editorial text-lg font-semibold text-white">Serviços do dia</h2>
      {
        utility && (
          <span class="ml-auto text-xs font-medium text-white/80">
            {formatLongDate(utility.duty_date)}
          </span>
        )
      }
    </header>

    <div class="grid md:grid-cols-2">
      {/* Farmacia de plantao */}
      <div class="p-5">
        <h3 class="text-xs font-semibold text-ink-muted">Farmácia de plantão</h3>

        {
          utility ? (
            <>
              <p class="mt-3 font-editorial text-lg font-semibold leading-tight text-ink">
                {utility.pharmacy_name}
              </p>
              {utility.pharmacy_phone && (
                <a
                  href={pharmacyTel}
                  class="mt-1.5 inline-block font-sans text-sm font-bold text-nioaque-green hover:text-nioaque-red"
                >
                  {utility.pharmacy_phone}
                </a>
              )}
              {utility.pharmacy_address && (
                <p class="mt-1 text-sm leading-relaxed text-ink-soft">{utility.pharmacy_address}</p>
              )}
              <div class="mt-3 flex gap-2">
                <a
                  href={pharmacyTel}
                  class="inline-flex items-center gap-1.5 rounded-sm bg-nioaque-green px-3 py-2 text-xs font-semibold text-white transition-colors hover:bg-nioaque-green-dark"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path
                      d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  Ligar
                </a>
                <a
                  href={pharmacyWhatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-sm bg-[#075E54] px-3 py-2 text-xs font-semibold text-white transition-colors hover:bg-[#054d45]"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.83 9.83 0 0 0 4.68 1.2h.01c5.43 0 9.84-4.4 9.84-9.84C21.89 6.4 17.48 2 12.04 2Zm5.76 14.02c-.24.68-1.4 1.3-1.94 1.36-.54.06-1.04.08-1.68-.12-.4-.12-.9-.3-1.56-.58-2.74-1.18-4.52-3.94-4.66-4.12-.14-.18-1.12-1.5-1.12-2.86 0-1.36.7-2.02.96-2.3.26-.28.56-.34.74-.34.18 0 .38 0 .54.02.18.02.42-.06.66.5.24.56.82 1.94.9 2.08.06.14.1.3.02.48-.08.18-.12.3-.24.46-.12.16-.26.36-.36.48-.12.12-.26.26-.1.5.14.24.64 1.06 1.38 1.72.94.84 1.74 1.1 1.98 1.22.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.6-.18 1.2Z" />
                  </svg>
                  WhatsApp
                </a>
              </div>
            </>
          ) : (
            <p class="mt-3 text-sm text-ink-soft">Sem informacao disponivel hoje.</p>
          )
        }
      </div>

      {/* Atalhos */}
      <div class="p-5">
        <h3 class="text-xs font-semibold text-ink-muted">Atalhos</h3>

        <ul class="mt-3 space-y-2.5 text-sm">
          <li>
            <a
              href="/radar-oficial"
              class="link-underline font-semibold text-ink transition-colors hover:text-nioaque-red"
            >
              Radar Oficial da cidade
            </a>
          </li>
          <li>
            <a
              href="/#comercio"
              class="link-underline font-semibold text-ink transition-colors hover:text-nioaque-red"
            >
              Destaque do comércio local
            </a>
          </li>
          <li>
            <a
              href="/mande-sua-noticia"
              class="link-underline font-semibold text-ink transition-colors hover:text-nioaque-red"
            >
              Enviar uma pista à redação
            </a>
          </li>
          <li>
            <a
              href="/busca"
              class="link-underline font-semibold text-ink transition-colors hover:text-nioaque-red"
            >
              Buscar no portal
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
