---
/**
 * Colunas por mês, empilhadas quando há mais de uma série.
 * Meses depois do último com valor não aparecem (não são "zero": ainda não aconteceram).
 * `mesAndamento` marca o mês corrente, cujo valor ainda é parcial.
 */
import { MESES } from '../../lib/transparencia';

interface Props {
  series: { label: string; cor: string; valores: number[] }[];
  ultimoMes: number;
  altura?: number;
  brl: (v: number) => string;
  descricao: string;
  /** índice (0-11) do mês em andamento, quando o ano exibido é o corrente */
  mesAndamento?: number;
}
const { series, ultimoMes, altura = 200, brl, descricao, mesAndamento } = Astro.props;
const visiveis = Math.max(1, ultimoMes + 1);
const totais = Array.from({ length: visiveis }, (_, i) => series.reduce((s, x) => s + (x.valores[i] ?? 0), 0));
const max = Math.max(...totais, 1);
const parcial = mesAndamento !== undefined && mesAndamento >= 0 && mesAndamento < visiveis;
---

<div>
  <ol class="grid items-end gap-1" style={`height:${altura}px;grid-template-columns:repeat(${visiveis},minmax(0,1fr))`} aria-label={descricao}>
    {totais.map((t, i) => (
      <li class="flex h-full flex-col justify-end text-center" title={`${MESES[i]}${i === mesAndamento ? ' (mês em andamento, valor parcial)' : ''}: ${brl(t)}`}>
        <div
          class:list={['flex w-full flex-col-reverse overflow-hidden rounded-t-[2px]', i === mesAndamento && 'opacity-70 outline-dashed outline-1 outline-offset-0 outline-ink-soft']}
          style={`height:${t > 0 ? Math.max(3, (t / max) * 100) : 0}%`}
        >
          {series.map((s) => {
            const v = s.valores[i] ?? 0;
            return v > 0 ? <span class="block w-full" style={`background:${s.cor};height:${(v / t) * 100}%`}></span> : null;
          })}
        </div>
        <span class:list={['mt-1 block text-[10px] uppercase', i === mesAndamento ? 'font-bold text-ink' : 'text-ink-soft']}>{MESES[i]}{i === mesAndamento ? '*' : ''}</span>
        <span class="sr-only">{brl(t)}</span>
      </li>
    ))}
  </ol>
  {series.length > 1 && (
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-soft">
      {series.map((s) => (
        <li class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-[2px]" style={`background:${s.cor}`}></span>{s.label}</li>
      ))}
    </ul>
  )}
  {parcial && (
    <p class="mt-2 inline-flex items-center gap-1.5 rounded-[2px] bg-nioaque-green-50 px-2 py-1 text-xs font-semibold text-ink">
      <span aria-hidden="true">*</span> {MESES[mesAndamento!]}: mês em andamento, atualização parcial (não é queda de gastos).
    </p>
  )}
  <p class="mt-2 text-xs text-ink-soft">Maior mês: {brl(max)}.</p>
</div>
