---
/** Colunas por mês, empilhadas quando há mais de uma série. */
import { MESES } from '../../lib/transparencia';

interface Props {
  series: { label: string; cor: string; valores: number[] }[];
  ultimoMes: number;
  altura?: number;
  brl: (v: number) => string;
  descricao: string;
}
const { series, ultimoMes, altura = 200, brl, descricao } = Astro.props;
const totais = Array.from({ length: 12 }, (_, i) => series.reduce((s, x) => s + (x.valores[i] ?? 0), 0));
const max = Math.max(...totais, 1);
---

<div>
  <ol class="grid grid-cols-12 items-end gap-1" style={`height:${altura}px`} aria-label={descricao}>
    {totais.map((t, i) => (
      <li class="flex h-full flex-col justify-end text-center" title={`${MESES[i]}: ${brl(t)}`}>
        <div class="flex w-full flex-col-reverse overflow-hidden rounded-t-[2px]" style={`height:${t > 0 ? Math.max(3, (t / max) * 100) : 0}%`}>
          {series.map((s) => {
            const v = s.valores[i] ?? 0;
            return v > 0 ? <span class="block w-full" style={`background:${s.cor};height:${(v / t) * 100}%`}></span> : null;
          })}
        </div>
        <span class:list={['mt-1 block text-[10px] uppercase', i <= ultimoMes ? 'text-ink-soft' : 'text-ink-soft/50']}>{MESES[i]}</span>
        <span class="sr-only">{brl(t)}</span>
      </li>
    ))}
  </ol>
  {series.length > 1 && (
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-soft">
      {series.map((s) => (
        <li class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-[2px]" style={`background:${s.cor}`}></span>{s.label}</li>
      ))}
    </ul>
  )}
  <p class="mt-2 text-xs text-ink-soft">Maior mês: {brl(max)}.</p>
</div>
