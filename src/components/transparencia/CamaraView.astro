---
/**
 * Transparência da Câmara: topo fixo (busca e total pago) + 4 abas.
 * Só dados reais do portal oficial (despesas, detalhes dos empenhos e folha de pagamento).
 */
import ChartDonut from './ChartDonut.astro';
import ChartMeses from './ChartMeses.astro';
import ChartCalor from './ChartCalor.astro';
import Abas from './Abas.astro';
import { anoAtual, brl, brlCurto, CATEGORIAS, MESES, MESES_LONGOS, parts, semAcento, VEREADORES, type Categoria, type ResumoAno } from '../../lib/transparencia';
import type { ResumoFolhaCamara, ServidorCamara } from '../../lib/folha';
import type { ResumoIbge } from '../../lib/externas';
import { formatDate } from '../../lib/format';
import { ROTULO_CATEGORIA, datasDaViagem, ehTerca, producaoDosVereadores, seloDaLicitacao, selosDoContrato, ultimoRegistro, type DadosInstar, type PropNormalizada, type ResultadoNormalizacao } from '../../lib/camara-dados';
import { GRUPOS_LOCAL, LOCAIS, localPorId, type GrupoLocal } from '../../lib/locations-nioaque';
import type { SessaoCamara } from '../../lib/camara-sessoes';
import { dataLocal } from '../../lib/transparencia-store';

interface Props {
  resumo: ResumoAno | null;
  folhaCam: ResumoFolhaCamara | null;
  ibge: ResumoIbge | null;
  ano: number;
  anos: number[];
  aba: string;
  q: string;
  slugSel: string;
  atualizadoEm: string | null;
  ID: string;
  BASE: string;
  /** sessoes (YouTube + portal da Camara) */
  sessoes: SessaoCamara[];
  /** proposicoes do ano, ja higienizadas */
  proposicoes: (ResultadoNormalizacao & { total: number; atualizadoEm: string }) | null;
  /** contratos, licitacoes, legislacao e temas vazios do portal da Camara */
  instar: DadosInstar | null;
  /** local escolhido no filtro "quem lembra do seu bairro" */
  local: string;
}
const { resumo, folhaCam, ibge, ano, anos, aba, q, slugSel, atualizadoEm, ID, BASE, sessoes, proposicoes, instar, local } = Astro.props;

const cartao = 'rounded-[4px] border border-pedra bg-branco p-4';
const tituloCartao = 'font-editorial text-lg font-extrabold text-ink';
const botao =
  'inline-flex min-h-[44px] items-center gap-2 rounded-[4px] bg-nioaque-green px-4 text-sm font-semibold text-white hover:bg-nioaque-green-dark disabled:opacity-60';
const pill =
  'inline-flex min-h-[44px] items-center rounded-[4px] border border-pedra bg-branco px-4 text-sm font-semibold text-ink hover:border-nioaque-green hover:text-nioaque-green-dark';
const ICONE_IMG = 'M12 3v12m0 0-4-4m4 4 4-4M5 21h14';

const norm = (t: string) => semAcento(t);
const soDigitos = q.replace(/\D/g, '');
const bonito = (t: string) =>
  t === t.toUpperCase()
    ? t
        .toLowerCase()
        .replace(/(^|[\s.-])(\S)/g, (_, a, b) => a + b.toUpperCase())
        .replace(/\s(De|Do|Da|Dos|Das|E)\s/g, (c) => c.toLowerCase())
        .replace(/\b(Inss|Eireli|Epp|Mei|Ltda|Me|Fgts|Rpps)\b/g, (s) => (s === 'Ltda' ? 'Ltda' : s.toUpperCase()))
    : t;
const fmtCnpj = (c: string) =>
  c.length === 14 ? c.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5') : c.length === 11 ? `CPF ***.${c.slice(3, 6)}.${c.slice(6, 9)}-**` : c;

const filtrados = resumo && q ? resumo.empenhos.filter((e) => norm(e.credor).includes(norm(q)) || (soDigitos.length >= 4 && e.cnpj.includes(soDigitos))) : [];
const LIMITE = 40;

let ultimoMes = 0;
if (resumo) resumo.porMes.forEach((v, i) => v > 0 && (ultimoMes = i));
const periodo = resumo ? (ultimoMes === 0 ? `janeiro de ${ano}` : `janeiro a ${MESES_LONGOS[ultimoMes]} de ${ano}`) : String(ano);
const mesAndamento = resumo && ano === anoAtual() && ultimoMes === Number(parts().month) - 1 ? ultimoMes : undefined;
const pop = ibge ? ([...ibge.estimativas].filter((e) => e.ano <= ano).sort((a, b) => b.ano - a.ano)[0] ?? null) : null;

const cat = (c: Categoria) => resumo?.porCategoria[c] ?? 0;
const pctDe = (v: number) => (resumo && resumo.totalPago ? (v / resumo.totalPago) * 100 : 0);
const pct1 = (v: number) => pctDe(v).toFixed(1).replace('.', ',');
const pctFolhaDiarias = pctDe(cat('folha') + cat('diarias'));
const vereadoresTotal = resumo ? resumo.diariasPorVereador.reduce((s, v) => s + v.total, 0) : 0;

const porVereador = resumo ? resumo.diariasPorVereador.map((r) => ({ ...r, info: VEREADORES.find((v) => v.slug === r.slug)! })) : [];
const maxVer = Math.max(...porVereador.map((v) => v.total), 1);
const diariasDe = (slug: string) => (resumo ? resumo.diarias.filter((d) => d.vereador === slug) : []);

// producao legislativa (portal da Camara) e viagens em dia de sessao
const sessaoPorData = new Map(sessoes.map((x) => [x.data, x]));
const producao = proposicoes ? producaoDosVereadores(proposicoes.itens) : new Map<string, ReturnType<typeof producaoDosVereadores> extends Map<string, infer V> ? V : never>();
/** datas (terca com sessao registrada) em que a viagem do empenho coincide com a sessao plenaria */
const viagemEmSessao = (historico: string) => datasDaViagem(historico).filter((x) => ehTerca(x) && sessaoPorData.has(x));
const hojeIso = dataLocal().iso;
const semTexto = (p: PropNormalizada) => p.texto.replace(p.titulo, '').trim() === '';
const comTexto = proposicoes ? proposicoes.itens.filter((p) => p.categoria !== 'parecer' && !semTexto(p)).length : 0;
const totalProp = proposicoes ? proposicoes.itens.filter((p) => p.categoria !== 'parecer').length : 0;
const nomeVer = (slug: string) => VEREADORES.find((v) => v.slug === slug)?.nome ?? slug;

// filtro por local
const gruposLocal = Object.keys(GRUPOS_LOCAL) as GrupoLocal[];
const porLocal = new Map<string, PropNormalizada[]>();
for (const p of proposicoes?.itens ?? []) if (p.categoria !== 'parecer') for (const id of p.locais) porLocal.set(id, [...(porLocal.get(id) ?? []), p]);
const localSel = localPorId(local);
const propsDoLocal = localSel ? (porLocal.get(localSel.id) ?? []) : [];
const autoresDoLocal = new Map<string, number>();
for (const p of propsDoLocal) for (const sl of p.vereadores) autoresDoLocal.set(sl, (autoresDoLocal.get(sl) ?? 0) + 1);

// raio-x do portal oficial
const sessoesAno = sessoes.filter((x) => x.data.startsWith(String(ano)) && x.portal);
const ataPdfAno = sessoesAno.filter((x) => x.portal?.ataUrl).length;
const ult = instar ? ultimoRegistro(instar) : null;
const temaDe = (chave: string) => instar?.temas.find((t) => t.chave === chave) ?? null;
const periodoTema = (t: { porAno: Record<string, number> }) => {
  const k = Object.keys(t.porAno).sort();
  return k.length > 1 ? `${k[0]}–${k[k.length - 1]}` : (k[0] ?? '');
};
const loa = proposicoes?.itens.find((p) => /\bLOA\b/i.test(p.titulo) && p.sigla === 'PL') ?? null;

// subsídio: salário base do cargo eletivo na folha de pagamento do portal (mês de referência abaixo)
const refFolha = folhaCam ? `${folhaCam.ref.slice(5)}/${folhaCam.ref.slice(0, 4)}` : '';
const servidorDe = (v: { match: RegExp }): ServidorCamara | null => folhaCam?.servidores.find((s) => /eletivo/i.test(s.tipo) && v.match.test(semAcento(s.nome).toUpperCase())) ?? null;

const destinosInformados = resumo ? resumo.destinos.filter((d) => d.nome !== 'Não informado') : [];
const destinosTop = destinosInformados.slice(0, 6);
const destinosSemInfo = resumo ? (resumo.destinos.find((d) => d.nome === 'Não informado')?.quantidade ?? 0) : 0;
const maxDestino = destinosTop[0]?.valor || 1;

const fornecedores = resumo?.fornecedores ?? [];
const maxForn = fornecedores[0]?.pago || 1;
const lic = resumo?.licitacao;
const licBase = lic ? lic.com + lic.sem : 0;
const semLic = fornecedores.filter((f) => f.sem > 0).sort((a, b) => b.sem - a.sem);

// quadro de servidores, agrupado por tipo de vínculo
const ORDEM_TIPOS = ['Cargo Eletivo', 'Cargo Comissionado', 'Cargo Efetivo', 'Contrato Temporário'];
const servidores = folhaCam?.servidores ?? [];
const tipos = [...new Set(servidores.map((s) => s.tipo || 'Outros'))].sort((a, b) => (ORDEM_TIPOS.indexOf(a) + 100) % 100 - (ORDEM_TIPOS.indexOf(b) + 100) % 100);
const totalBase = servidores.reduce((s, x) => s + x.base, 0);

const atual = atualizadoEm ? new Date(atualizadoEm).toLocaleDateString('pt-BR', { timeZone: 'America/Campo_Grande' }) : null;

const exportData = resumo
  ? {
      ano,
      periodo,
      atualizadoEm: resumo.atualizadoEm,
      total: { empenhado: resumo.totalEmpenhado, liquidado: resumo.totalLiquidado, pago: resumo.totalPago },
      categorias: (Object.keys(CATEGORIAS) as Categoria[]).map((c) => ({ label: CATEGORIAS[c].label, cor: CATEGORIAS[c].cor, valor: cat(c) })),
      diarias: {
        total: resumo.diariasTotal,
        quantidade: resumo.diarias.length,
        pctGasto: pctDe(resumo.diariasTotal),
        equipeTotal: resumo.diariasEquipe.total,
        equipeQtd: resumo.diariasEquipe.quantidade,
        vereadoresTotal,
      },
      vereadores: porVereador.map((v) => ({
        slug: v.slug,
        nome: v.info.nome,
        cargo: v.info.cargo,
        partido: v.info.partido,
        foto: v.info.foto,
        total: v.total,
        quantidade: v.quantidade,
        dias: v.dias,
        porMes: v.porMes,
        lista: diariasDe(v.slug).slice(0, 9).map((d) => ({ data: d.data, destino: d.destino, valor: d.valor, dias: d.dias })),
      })),
    }
  : null;

const ABAS = [
  { id: 'vereadores', label: 'Vereadores e diárias' },
  { id: 'resumo', label: 'Resumo geral' },
  { id: 'contratos', label: 'Contratos e fornecedores' },
  { id: 'servidores', label: 'Servidores e folha' },
];
const diasTxt = (n: number) => (n > 0 ? ` · ${n} ${n === 1 ? 'dia' : 'dias'}` : '');
---

<div data-titulo={`Transparência da Câmara de Nioaque ${ano}`}>
  {!resumo && (
    <p class={`${cartao} mb-10 text-sm text-ink-soft`}>
      Dados ainda não sincronizados com a fonte oficial para {ano}. Enquanto isso, consulte direto em
      <a class="underline" href={`${BASE}/despesas/${ID}`} target="_blank" rel="noopener noreferrer">Despesas</a>.
    </p>
  )}
  {resumo && resumo.empenhos.length === 0 && <p class={`${cartao} mb-10 text-sm text-ink-soft`}>Nenhuma despesa registrada em {ano}.</p>}

  {resumo && resumo.empenhos.length > 0 && exportData && (
    <>
      <!-- ============================ TOPO FIXO ============================ -->
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3 print:hidden">
        <nav aria-label="Ano" class="flex gap-1">
          {anos.map((a) => (
            <a
              href={`?entidade=camara&ano=${a}&aba=${aba}`}
              aria-current={a === ano ? 'true' : undefined}
              class:list={['inline-flex min-h-[44px] min-w-[56px] items-center justify-center rounded-[4px] border px-3 text-sm font-semibold tabular-nums', a === ano ? 'border-nioaque-green bg-nioaque-green text-white' : 'border-pedra bg-branco text-ink hover:border-nioaque-green']}
            >
              {a}
            </a>
          ))}
        </nav>
      </div>

      <section aria-label="Resumo do ano" class="mb-5">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-nioaque-green">Total geral da Câmara · pago em {ano}</p>
          <button type="button" data-exportar-png="" class={botao}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_IMG} /></svg>
            <span data-rotulo>Salvar como imagem</span>
          </button>
        </div>
        <div class="mt-1 flex flex-wrap items-baseline gap-x-6 gap-y-1">
          <p class="font-editorial text-[clamp(2rem,9vw,3.25rem)] font-extrabold leading-none tabular-nums text-nioaque-green-dark">{brl(resumo.totalPago)}</p>
          {pop && (
            <p class="text-base text-ink">
              <strong class="tabular-nums">{brl(resumo.totalPago / pop.valor)}</strong> por habitante
              <span class="block text-xs text-ink-soft">População estimada de {pop.valor.toLocaleString('pt-BR')} (IBGE, {pop.ano}).</span>
            </p>
          )}
        </div>
        <p class="mt-2 text-sm text-ink">
          Folha e diárias pesam <strong class="tabular-nums">{pctFolhaDiarias.toFixed(1).replace('.', ',')}%</strong> do total
          <span class="text-ink-soft">(folha {pct1(cat('folha'))}% · diárias {pct1(cat('diarias'))}%)</span>.
        </p>
        <p class="mt-1 text-sm text-ink-soft">
          {periodo}. Liquidado: <abbr title="Serviço ou produto já recebido e conferido" class="no-underline"><span class="tabular-nums">{brl(resumo.totalLiquidado)}</span></abbr>
          · Reservado (empenhado): <abbr title="Valor separado no orçamento para a despesa" class="no-underline"><span class="tabular-nums">{brl(resumo.totalEmpenhado)}</span></abbr>
          · {resumo.empenhos.length} despesas.{atual ? ` Atualizado semanalmente (última vez em ${atual}).` : ''}
        </p>
      </section>

      <form id="busca" method="get" action="#busca" class="mb-5 scroll-mt-24 print:hidden">
        <input type="hidden" name="entidade" value="camara" />
        <input type="hidden" name="ano" value={ano} />
        <input type="hidden" name="aba" value={aba} />
        <label class="sr-only" for="q-cam">Pesquisar fornecedor, CNPJ, servidor ou despesa</label>
        <div class="flex gap-2">
          <input id="q-cam" name="q" value={q} type="search" placeholder="Pesquisar fornecedor, CNPJ, servidor ou despesa..." class="min-h-[48px] min-w-0 flex-1 rounded-[4px] border-2 border-pedra bg-branco px-4 text-base text-ink focus:border-nioaque-green" />
          <button type="submit" class={`${botao} min-h-[48px] px-5`}>Buscar</button>
        </div>
      </form>

      {q && (
        <section id="lista" class={`${cartao} mb-8`} aria-label="Resultados da busca">
          <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <p class="text-sm text-ink"><span class="block text-xs font-bold uppercase tracking-[0.1em] text-nioaque-green">Resultado da busca (não é o total geral)</span><strong>{filtrados.length}</strong> {filtrados.length === 1 ? 'despesa encontrada' : 'despesas encontradas'} para “{q}”, somando <strong>{brl(filtrados.reduce((s, e) => s + e.pago, 0))}</strong> pagos em {ano}.</p>
            <a href={`?entidade=camara&ano=${ano}&aba=${aba}`} class={pill}>Limpar busca</a>
          </div>
          {filtrados.length === 0 ? (
            <p class="text-sm text-ink-soft">Nenhuma despesa encontrada para essa busca.</p>
          ) : (
            <ul class="divide-y divide-pedra rounded-[4px] border border-pedra">
              {filtrados.slice(0, LIMITE).map((e) => (
                <li class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1 p-3">
                  <div class="min-w-0">
                    <p class="font-semibold text-ink">{bonito(e.credor)} {e.categoria === 'diarias' && <span class="ml-1 rounded-[2px] bg-nioaque-red-50 px-1.5 py-0.5 align-middle text-[11px] font-bold uppercase text-nioaque-red-dark">Diária</span>}</p>
                    <p class="text-xs text-ink-soft"><span class="tabular-nums">{formatDate(e.data)}</span> · empenho nº {e.numero}{e.cnpj ? ` · ${fmtCnpj(e.cnpj)}` : ''}</p>
                  </div>
                  <p class="text-right font-semibold tabular-nums text-ink">{brl(e.pago)}<span class="block text-xs font-normal text-ink-soft">{e.pago < e.empenhado ? `de ${brl(e.empenhado)} reservados` : 'pago'}</span></p>
                </li>
              ))}
            </ul>
          )}
          {filtrados.length > LIMITE && (
            <p class="mt-2 text-sm text-ink-soft">Mostrando {LIMITE} de {filtrados.length}. Refine a busca ou veja a lista completa em
              <a class="underline hover:text-nioaque-green-dark" href={`${BASE}/despesas/${ID}`} target="_blank" rel="noopener noreferrer">Despesas no portal oficial</a>.</p>
          )}
        </section>
      )}

      <Abas abas={ABAS} ativa={aba} params={{ entidade: 'camara', ano, ...(q ? { q } : {}) }} />

      <!-- ============================ ABA 1: VEREADORES E DIÁRIAS ============================ -->
      <section role="tabpanel" id="painel-vereadores" data-painel="vereadores" aria-labelledby="aba-vereadores" hidden={aba !== 'vereadores'}>
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="font-editorial text-2xl font-extrabold text-ink">Raio-X dos vereadores</h2>
            <p class="text-sm text-ink-soft">Subsídio e diárias recebidas em {ano}. Toque em um vereador para ver cada viagem.</p>
          </div>
          <button type="button" data-exportar-png="__vereadores__" class={botao}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_IMG} /></svg>
            <span data-rotulo>Salvar esta seção (PNG)</span>
          </button>
        </div>

        <dl class="mb-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
          <div class={cartao}><dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-ink-soft">Diárias pagas</dt><dd class="font-editorial text-xl font-extrabold tabular-nums text-ink">{brl(resumo.diariasTotal)}</dd><p class="text-xs text-ink-soft">{resumo.diarias.length} pagamentos</p></div>
          <div class={cartao}><dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-ink-soft">Do total gasto</dt><dd class="font-editorial text-xl font-extrabold tabular-nums text-ink">{pct1(resumo.diariasTotal)}%</dd></div>
          <div class={cartao}><dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-ink-soft">Vereadores</dt><dd class="font-editorial text-xl font-extrabold tabular-nums text-ink">{brlCurto(vereadoresTotal)}</dd></div>
          <div class={cartao}><dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-ink-soft">Assessores e equipe</dt><dd class="font-editorial text-xl font-extrabold tabular-nums text-ink">{brlCurto(resumo.diariasEquipe.total)}</dd></div>
        </dl>

        <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-3 [&>li]:has-[details[open]]:col-span-full">
          {porVereador.map((v) => {
            const sv = servidorDe(v.info);
            const viagens = diariasDe(v.slug);
            const prod = producao.get(v.slug);
            const emSessao = viagens.filter((d) => viagemEmSessao(d.historico).length > 0).length;
            return (
              <li>
                <details open={slugSel === v.slug} class="group h-full rounded-[4px] border border-pedra bg-branco open:border-2 open:border-nioaque-green">
                  <summary class="flex min-h-[44px] cursor-pointer list-none gap-3 p-3 [&::-webkit-details-marker]:hidden">
                    <img src={v.info.foto} alt={`Foto de ${v.info.nome}`} width="64" height="64" loading="lazy" class="h-16 w-16 shrink-0 rounded-full border-2 border-pedra object-cover" />
                    <span class="min-w-0 flex-1">
                      <span class="block truncate font-editorial text-base font-extrabold text-ink">{v.info.nome}</span>
                      <span class="block text-xs text-ink-soft">{v.info.cargo} · {v.info.partido}</span>
                      <span class="mt-1 block text-xs text-ink-soft">Subsídio: <strong class="tabular-nums text-ink">{sv ? brl(sv.base) : 'não sincronizado'}</strong></span>
                      <span class="block text-sm font-semibold tabular-nums text-nioaque-red-dark">{brl(v.total)} <span class="text-xs font-normal text-ink-soft">em diárias</span></span>
                      <span class="mt-1.5 block h-1.5 rounded-[2px] bg-editorial"><span class="block h-1.5 rounded-[2px] bg-nioaque-red" style={`width:${(v.total / maxVer) * 100}%`}></span></span>
                      <span class="mt-2 block text-xs font-semibold text-nioaque-green-dark">Clique para ver as viagens e os meses</span>
                      <span class="mt-2 block text-[10px] font-bold uppercase tracking-[0.1em] text-ink-soft">Produção legislativa em {ano}</span>
                      {proposicoes ? (
                        <span class="mt-1 grid grid-cols-3 gap-1 text-center text-[10px] leading-tight text-ink-soft">
                          <span class="rounded-[2px] bg-nioaque-green-50 px-1 py-1"><strong class="block text-base tabular-nums text-ink">{prod?.porCategoria.leis ?? 0}</strong>Leis e decretos</span>
                          <span class="rounded-[2px] bg-nioaque-green-50 px-1 py-1"><strong class="block text-base tabular-nums text-ink">{prod?.porCategoria.fiscalizacao ?? 0}</strong>Fiscalização</span>
                          <span class="rounded-[2px] bg-nioaque-green-50 px-1 py-1"><strong class="block text-base tabular-nums text-ink">{prod?.porCategoria.zeladoria ?? 0}</strong>Zeladoria e homenagens</span>
                        </span>
                      ) : (
                        <span class="mt-1 block text-xs text-ink-soft">Proposições de {ano} ainda não sincronizadas.</span>
                      )}
                      {prod && prod.porCategoria['sem-ementa'] > 0 && <span class="mt-1 block text-[11px] text-ink-soft">+ {prod.porCategoria['sem-ementa']} {prod.porCategoria['sem-ementa'] === 1 ? 'requerimento' : 'requerimentos'} sem ementa publicada no portal</span>}
                    </span>
                    <span class="self-center text-ink-soft transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
                  </summary>
                  <div class="border-t border-pedra p-3">
                    <p class="text-xs text-ink-soft">{v.quantidade === 0 ? 'Nenhuma diária paga em ' + ano + '.' : `${v.quantidade} ${v.quantidade === 1 ? 'diária' : 'diárias'}${diasTxt(v.dias)}.`}{sv ? ` Subsídio = salário base na folha de ${refFolha}.` : ''}</p>
                    {emSessao > 0 && <p class="mt-1 text-xs font-semibold text-ink">{emSessao} {emSessao === 1 ? 'viagem paga coincide' : 'viagens pagas coincidem'} com dia de sessão plenária (terça-feira).</p>}
                    {prod && prod.itens.length > 0 && (
                      <details class="mt-3 rounded-[4px] border border-pedra">
                        <summary class="flex min-h-[44px] cursor-pointer items-center px-3 text-sm font-bold text-nioaque-green-dark">Ver as {prod.total} proposições de {v.info.nome}<span class="ml-2 text-xs font-normal text-ink-soft">(clique para ver mais)</span></summary>
                        <ul class="max-h-72 divide-y divide-pedra overflow-y-auto border-t border-pedra text-sm">
                          {prod.itens.slice(0, 60).map((p) => (
                            <li class="p-2">
                              <p class="font-semibold text-ink">{p.titulo}</p>
                              <p class="text-xs text-ink-soft">{ROTULO_CATEGORIA[p.categoria]} · {p.situacao || 'situação não informada'}{p.data ? ` · ${formatDate(p.data)}` : ''} · <a class="underline" href={p.fonteUrl} target="_blank" rel="noopener noreferrer">fonte oficial</a></p>
                              {p.divergencia && <p class="text-xs text-ink-soft">O título cita {nomeVer(p.divergencia)}, mas vale o campo Autor do portal, que confere com o PDF.</p>}
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}
                    {v.quantidade > 0 && (
                      <>
                        <ol class="mt-2 grid grid-cols-3 gap-1.5 text-center text-[10px] uppercase text-ink-soft sm:grid-cols-4 lg:grid-cols-6" aria-label={`Diárias de ${v.info.nome} por mês`}>
                          {MESES.slice(0, ultimoMes + 1).map((m, i) => (
                            <li class:list={['rounded-[2px] px-1 py-1.5', v.porMes[i] > 0 ? 'bg-nioaque-green-50 font-bold text-ink' : 'bg-editorial']}>
                              {m}
                              <span class="block text-xs normal-case tabular-nums">{v.porMes[i] > 0 ? brl(v.porMes[i]).replace(/ /g, ' ').replace(',00', '') : '–'}</span>
                            </li>
                          ))}
                        </ol>
                        <ul class="mt-3 max-h-72 divide-y divide-pedra overflow-y-auto rounded-[4px] border border-pedra text-sm [scrollbar-color:#bdb6a3_transparent] [scrollbar-width:thin]">
                          {viagens.map((d) => (
                            <li class="flex items-start justify-between gap-3 p-2">
                              <div class="min-w-0">
                                <p class="font-semibold text-ink">{d.destino}{diasTxt(d.dias)}</p>
                                <p class="text-xs text-ink-soft"><span class="tabular-nums">{formatDate(d.data)}</span> · empenho nº {d.numero}</p>
                                {viagemEmSessao(d.historico).map((dt) => (
                                  <p class="mt-1 text-xs">
                                    <span class="rounded-[2px] bg-editorial px-1.5 py-0.5 font-bold text-ink">Viagem em dia de sessão: terça, {formatDate(dt)}</span>{' '}
                                    <a class="underline" href={`/camara/sessoes/${dt}`}>Ver a sessão</a>
                                    {sessaoPorData.get(dt)?.portal?.ataUrl && <> · <a class="underline" href={sessaoPorData.get(dt)!.portal!.ataUrl!} target="_blank" rel="noopener noreferrer">Ata manuscrita (PDF não pesquisável)</a></>}
                                  </p>
                                ))}
                              </div>
                              <p class="shrink-0 font-semibold tabular-nums text-ink">{brl(d.valor)}</p>
                            </li>
                          ))}
                        </ul>
                        <button type="button" data-exportar-png={v.slug} class={`${botao} mt-3`}>
                          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_IMG} /></svg>
                          <span data-rotulo>Baixar imagem (PNG)</span>
                        </button>
                      </>
                    )}
                  </div>
                </details>
              </li>
            );
          })}
        </ul>

        <section id="locais" class={`${cartao} mt-4 scroll-mt-4`} aria-labelledby="h-locais">
          <h3 id="h-locais" class={tituloCartao}>Quem lembra do seu bairro, aldeia ou assentamento?</h3>
          <p class="mb-3 text-xs text-ink-soft">Escolha o lugar para ver quantas proposições de {ano} citam esse local e quais vereadores as assinaram. Só conta o que está escrito na ementa ou na notícia oficial da Câmara.</p>
          {!proposicoes ? (
            <p class="text-sm text-ink-soft">Proposições de {ano} ainda não sincronizadas com o portal da Câmara.</p>
          ) : porLocal.size === 0 ? (
            <p class="text-sm text-ink-soft">Nenhuma ementa publicada cita bairros, aldeias ou assentamentos.</p>
          ) : (
            <>
              {gruposLocal.map((g) => {
                const lista = LOCAIS.filter((l) => l.grupo === g && (porLocal.get(l.id)?.length ?? 0) > 0);
                return lista.length === 0 ? null : (
                  <div class="mb-3">
                    <p class="mb-1.5 text-[11px] font-bold uppercase tracking-[0.12em] text-ink-soft">{GRUPOS_LOCAL[g]}</p>
                    <ul class="flex flex-wrap gap-2">
                      {lista.map((l) => (
                        <li>
                          <a href={`?entidade=camara&ano=${ano}&aba=vereadores&local=${l.id}#locais`} aria-current={localSel?.id === l.id ? 'true' : undefined} class:list={['inline-flex min-h-[44px] items-center gap-2 rounded-[4px] border px-3 text-sm font-semibold', localSel?.id === l.id ? 'border-nioaque-green bg-nioaque-green text-white' : 'border-pedra bg-branco text-ink hover:border-nioaque-green']}>
                            {l.nome} <span class="tabular-nums text-xs font-normal opacity-80">{porLocal.get(l.id)!.length}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })}
              {localSel && (
                <div class="mt-3 rounded-[4px] border-2 border-nioaque-green p-3">
                  <h4 class="font-editorial text-lg font-extrabold text-ink">{localSel.nome}: {propsDoLocal.length} {propsDoLocal.length === 1 ? 'proposição' : 'proposições'} em {ano}</h4>
                  {autoresDoLocal.size > 0 && (
                    <p class="mt-1 text-sm text-ink-soft">Vereadores: {[...autoresDoLocal.entries()].sort((a, b) => b[1] - a[1]).map(([sl, n]) => `${nomeVer(sl)} (${n})`).join(', ')}.</p>
                  )}
                  <ul class="mt-2 divide-y divide-pedra rounded-[4px] border border-pedra text-sm">
                    {propsDoLocal.map((p) => (
                      <li class="p-2.5">
                        <p class="font-semibold text-ink">{p.titulo}</p>
                        {p.descricao && <p class="text-xs leading-relaxed text-ink-soft">{p.descricao.length >= 300 ? `${p.descricao.slice(0, 280).trim()}…` : p.descricao}</p>}
                        <p class="mt-0.5 text-xs text-ink-soft">{[...p.vereadores.map(nomeVer), ...p.outrosAutores].join(', ') || 'Autor não informado'} · {ROTULO_CATEGORIA[p.categoria]} · {p.situacao || 'situação não informada'} · <a class="underline" href={p.fonteUrl} target="_blank" rel="noopener noreferrer">fonte oficial</a></p>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <p class="mt-3 text-xs text-ink-soft">{comTexto} de {totalProp} proposições têm ementa ou notícia oficial que permite identificar o local; as demais não entram na busca por lugar. Pareceres de comissão não são contados.</p>
            </>
          )}
        </section>

        <div class={`${cartao} mt-4 hidden md:block`}>
          <h3 class={`${tituloCartao} mb-1`}>Mapa de calor: quem recebeu e quando</h3>
          <p class="mb-3 text-xs text-ink-soft">Quanto mais escuro o quadrado, maior o valor de diárias do vereador naquele mês (em reais, "k" = mil).</p>
          <ChartCalor ultimoMes={ultimoMes} brl={brl} linhas={porVereador.map((v) => ({ slug: v.slug, nome: v.info.nome, foto: v.info.foto, valores: v.porMes }))} />
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <div class={cartao}>
            <h3 class={`${tituloCartao} mb-3`}>Para onde viajam</h3>
            {destinosTop.length === 0 ? (
              <p class="text-sm text-ink-soft">O portal não informa o destino nos empenhos deste ano.</p>
            ) : (
              <ol class="space-y-3">
                {destinosTop.map((d) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3 text-sm">
                      <span class="min-w-0 truncate font-semibold">{d.nome}</span>
                      <span class="shrink-0 tabular-nums">{d.quantidade} {d.quantidade === 1 ? 'viagem' : 'viagens'} · {brlCurto(d.valor)}</span>
                    </div>
                    <div class="mt-1 h-2 rounded-[2px] bg-editorial"><div class="h-2 rounded-[2px] bg-nioaque-red" style={`width:${(d.valor / maxDestino) * 100}%`}></div></div>
                  </li>
                ))}
              </ol>
            )}
            <p class="mt-3 text-xs text-ink-soft">Destino conforme o histórico do empenho no portal.{destinosSemInfo > 0 ? ` Em ${destinosSemInfo} ${destinosSemInfo === 1 ? 'pagamento' : 'pagamentos'} o histórico não informa o destino e ele não entra no ranking.` : ''}</p>
          </div>
          <div class={cartao}>
            <h3 class={`${tituloCartao} mb-3`}>Assessores e equipe que mais receberam</h3>
            {resumo.diariasEquipe.pessoas.length === 0 ? (
              <p class="text-sm text-ink-soft">Nenhuma diária paga a assessores ou equipe em {ano}.</p>
            ) : (
              <ol class="space-y-2">
                {resumo.diariasEquipe.pessoas.slice(0, 6).map((p, i) => (
                  <li class="flex items-baseline justify-between gap-3 text-sm">
                    <span class="min-w-0 truncate"><span class="tabular-nums text-ink-soft">{i + 1}.</span> {bonito(p.nome)}</span>
                    <span class="shrink-0 font-semibold tabular-nums">{brl(p.pago)} <span class="text-xs font-normal text-ink-soft">({p.empenhos})</span></span>
                  </li>
                ))}
              </ol>
            )}
            <p class="mt-3 text-xs text-ink-soft">Inclui motoristas e servidores que acompanham os vereadores, como aparece nos empenhos.</p>
          </div>
        </div>
      </section>

      <!-- ============================ ABA 2: RESUMO GERAL ============================ -->
      <section role="tabpanel" id="painel-resumo" data-painel="resumo" aria-labelledby="aba-resumo" hidden={aba !== 'resumo'}>
        <div class="grid gap-4 lg:grid-cols-2">
          <div class={cartao}>
            <h2 class={`${tituloCartao} mb-3`}>Em que o dinheiro foi gasto</h2>
            <ChartDonut
              brl={brl}
              centro={brlCurto(resumo.totalPago)}
              legendaCentro={`pago em ${ano}`}
              items={(Object.keys(CATEGORIAS) as Categoria[]).map((c) => ({ label: CATEGORIAS[c].label, value: cat(c), color: CATEGORIAS[c].cor }))}
            />
          </div>
          <div class={cartao}>
            <h2 class={`${tituloCartao} mb-3`}>Pago mês a mês</h2>
            <ChartMeses series={[{ label: 'Pago', cor: '#166A34', valores: resumo.porMes }]} ultimoMes={ultimoMes} mesAndamento={mesAndamento} altura={220} brl={brl} descricao="Valor pago por mês" />
          </div>
        </div>
        <p class="mt-3 text-xs text-ink-soft">
          Fonte: API de Dados Abertos da Câmara (Quality Sistemas). Empenhos repetidos pela fonte são contados uma só vez. Diárias identificadas pela natureza da despesa (3.3.90.14) no detalhe do empenho; o nome do vereador é associado ao nome do favorecido.
          {resumo.semDetalhe > 0 && ` Atenção: ainda estamos lendo o detalhe de ${resumo.semDetalhe} despesas de pessoas físicas; por enquanto elas aparecem em "Fornecedores e serviços".`}
        </p>

        {loa && (
          <div class={`${cartao} mt-4`}>
            <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-ink-soft">LOA 2027 em tramitação</p>
            <h2 class={tituloCartao}>{loa.titulo}</h2>
            <p class="mt-1 text-sm text-ink-soft">{loa.descricao || 'Estima a receita e fixa a despesa do município para 2027.'} Situação no portal da Câmara: <strong class="text-ink">{loa.situacao || 'não informada'}</strong>.</p>
            <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
              <a class="font-semibold text-nioaque-green-dark underline" href="/transparencia?entidade=prefeitura&aba=receitas">Ver as receitas da Prefeitura</a>
              <a class="text-ink-soft underline" href={loa.fonteUrl} target="_blank" rel="noopener noreferrer">Fonte oficial</a>
            </p>
          </div>
        )}

        <section class={`${cartao} mt-4`} aria-labelledby="h-raiox">
          <h2 id="h-raiox" class={tituloCartao}>Raio-X do portal oficial da Câmara</h2>
          <p class="mb-3 text-xs text-ink-soft">O que o portal da Câmara (cmnioaque.ms.gov.br) publica, comparado ao que o Portal da Transparência registra. Números lidos das fontes, sem interpretação.</p>
          {!instar ? (
            <p class="text-sm text-ink-soft">Dados ainda não sincronizados com o portal da Câmara.</p>
          ) : (
            <ul class="divide-y divide-pedra text-sm">
              <li class="py-2.5">
                <p class="font-semibold text-ink">Diárias e relatórios de viagem</p>
                <p class="text-ink-soft">Pagas no Portal da Transparência: <strong class="tabular-nums text-ink">{brl(resumo.diariasTotal)}</strong> ({resumo.diarias.length} pagamentos em {ano}). Relatórios de viagem publicados no portal da Câmara: <strong class="tabular-nums text-ink">{temaDe('relatorio-viagens')?.total ?? 0}</strong>{temaDe('relatorio-viagens') ? ` (${periodoTema(temaDe('relatorio-viagens')!)})` : ''}.</p>
              </li>
              <li class="py-2.5">
                <p class="font-semibold text-ink">Atas das sessões</p>
                <p class="text-ink-soft"><strong class="tabular-nums text-ink">{sessoesAno.length}</strong> {sessoesAno.length === 1 ? 'sessão' : 'sessões'} de {ano} no portal, <strong class="tabular-nums text-ink">{ataPdfAno}</strong> com ata em PDF. As atas são publicadas como imagem de texto manuscrito: sem texto pesquisável e sem acessibilidade para leitores de tela.</p>
              </li>
              <li class="py-2.5">
                <p class="font-semibold text-ink">Seções sem nenhum registro</p>
                <ul class="mt-1 grid gap-x-6 gap-y-0.5 text-ink-soft sm:grid-cols-2">
                  {['diario-oficial', 'obras', 'audiencias-publicas', 'compra-direta', 'chamamento-publico', 'concursos', 'carta-servicos'].map((c) => temaDe(c)).filter(Boolean).map((t) => (
                    <li>{t!.rotulo}: <strong class="tabular-nums text-ink">{t!.total}</strong> {t!.total === 1 ? 'registro' : 'registros'} <span class="text-xs">({periodoTema(t!)})</span></li>
                  ))}
                  <li>SIC (pedidos de informação, {instar.ano}): <strong class="tabular-nums text-ink">{instar.sicPedidos ?? 'não informado'}</strong></li>
                  <li>Ouvidoria (manifestações, {instar.ano}): <strong class="tabular-nums text-ink">{instar.ouvidoriaPedidos ?? 'não informado'}</strong></li>
                </ul>
              </li>
              <li class="py-2.5">
                <p class="font-semibold text-ink">Contratos e licitações</p>
                <p class="text-ink-soft">Último contrato com data de assinatura: <strong class="tabular-nums text-ink">{ult?.contratos ? formatDate(ult.contratos) : 'nenhum'}</strong>. Última licitação publicada: <strong class="tabular-nums text-ink">{ult?.licitacoes ? formatDate(ult.licitacoes) : 'nenhuma'}</strong>. Dados lidos do portal em {formatDate(instar.atualizadoEm.slice(0, 10))}.</p>
              </li>
              {proposicoes && (
                <li class="py-2.5">
                  <p class="font-semibold text-ink">Qualidade dos dados das proposições</p>
                  <p class="text-ink-soft">{proposicoes.numerosCorrigidos} {proposicoes.numerosCorrigidos === 1 ? 'número vem corrompido' : 'números vêm corrompidos'} na fonte e {proposicoes.numerosCorrigidos === 1 ? 'foi corrigido' : 'foram corrigidos'} aqui pelo título; {proposicoes.duplicatasRemovidas} {proposicoes.duplicatasRemovidas === 1 ? 'registro repetido foi contado' : 'registros repetidos foram contados'} uma só vez; {proposicoes.divergencias.length} {proposicoes.divergencias.length === 1 ? 'proposição tem' : 'proposições têm'} autor diferente entre o título e o campo Autor do portal; nesses casos o site adota o campo Autor, que confere com o PDF da proposição (conferido em 5 documentos).</p>
                </li>
              )}
            </ul>
          )}
        </section>
      </section>

      <!-- ============================ ABA 3: CONTRATOS E FORNECEDORES ============================ -->
      <section role="tabpanel" id="painel-contratos" data-painel="contratos" aria-labelledby="aba-contratos" hidden={aba !== 'contratos'}>
        <div class="grid gap-4">
          <div class={cartao}>
            <h2 class={tituloCartao}>Contratos publicados no portal da Câmara</h2>
            <p class="mb-3 text-xs text-ink-soft">Lista oficial do portal (Instar). Os selos apontam lacunas na própria fonte.</p>
            {!instar || instar.contratos.length === 0 ? (
              <p class="text-sm text-ink-soft">Nenhum contrato publicado, ou dados ainda não sincronizados com o portal da Câmara.</p>
            ) : (
              <ul class="divide-y divide-pedra text-sm">
                {[...instar.contratos].sort((a, b) => (b.assinatura ?? '').localeCompare(a.assinatura ?? '')).map((c) => {
                  const selos = selosDoContrato(c, hojeIso);
                  return (
                    <li class="py-2.5">
                      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                        <p class="min-w-0 font-semibold text-ink">{c.nome ? bonito(c.nome) : 'Contratado não informado'}</p>
                        <p class="shrink-0 font-semibold tabular-nums text-ink">{c.valor ? brl(c.valor) : '–'}</p>
                      </div>
                      <p class="text-xs text-ink-soft">
                        {c.tipo ?? 'Contrato'}{c.numero ? ` nº ${c.numero}` : ''}{c.assinatura ? ` · assinado em ${formatDate(c.assinatura)}` : ''}{c.fim ? ` · vigência até ${formatDate(c.fim)}` : ''}{c.situacao ? ` · ${c.situacao}` : ''}
                      </p>
                      {selos.length > 0 && (
                        <ul class="mt-1 flex flex-wrap gap-1.5">
                          {selos.map((x) => <li class="rounded-[2px] border border-ocre bg-editorial px-1.5 py-0.5 text-[11px] font-bold text-ink">[{x.texto}]</li>)}
                        </ul>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}
            {instar && instar.licitacoes.length > 0 && (
              <>
                <h3 class="mt-5 font-editorial text-base font-extrabold text-ink">Licitações publicadas</h3>
                <ul class="mt-2 divide-y divide-pedra text-sm">
                  {instar.licitacoes.map((l) => {
                    const selo = seloDaLicitacao(l, hojeIso);
                    return (
                      <li class="py-2.5">
                        <p class="font-semibold text-ink">{l.titulo}</p>
                        <p class="text-xs text-ink-soft">{l.modalidade ?? 'Modalidade não informada'}{l.postagem ? ` · publicada em ${formatDate(l.postagem)}` : ''}{l.realizacao ? ` · sessão em ${formatDate(l.realizacao)}` : ''}{l.situacao ? ` · ${l.situacao}` : ''}{l.valorHomologado ? ` · homologado: ${l.valorHomologado}` : ' · sem valor homologado'}</p>
                        {selo && <p class="mt-1"><span class="rounded-[2px] border border-ocre bg-editorial px-1.5 py-0.5 text-[11px] font-bold text-ink">[{selo.texto}]</span></p>}
                      </li>
                    );
                  })}
                </ul>
              </>
            )}
          </div>

          <div class={cartao}>
            <h2 class={tituloCartao}>Maiores fornecedores</h2>
            <p class="mb-3 text-xs text-ink-soft">Empresas que mais receberam da Câmara em {ano}, sem folha, encargos e diárias.</p>
            {fornecedores.length === 0 ? (
              <p class="text-sm text-ink-soft">Nenhuma empresa recebeu da Câmara em {ano}, ou os dados ainda não foram sincronizados com a fonte oficial.</p>
            ) : (
              <ol class="space-y-4">
                {fornecedores.slice(0, 10).map((f, i) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3 text-sm">
                      <a href={`?entidade=camara&ano=${ano}&aba=contratos&q=${encodeURIComponent(f.cnpj)}#busca`} class="min-w-0 font-semibold text-ink hover:text-nioaque-green-dark"><span class="tabular-nums text-ink-soft">{i + 1}.</span> {bonito(f.nome)}</a>
                      <strong class="shrink-0 tabular-nums">{brl(f.pago)}</strong>
                    </div>
                    <div class="mt-1 h-2 rounded-[2px] bg-line"><div class="h-full rounded-[2px] bg-nioaque-green" style={`width:${(f.pago / maxForn) * 100}%`}></div></div>
                    <p class="mt-0.5 text-xs text-ink-soft">{fmtCnpj(f.cnpj)}{f.oque ? ` · ${f.oque}` : ''} · {f.empenhos} {f.empenhos === 1 ? 'despesa' : 'despesas'}</p>
                    {f.refs.length > 0 && <p class="text-xs text-ink-soft">Licitação/contrato informado: {f.refs.join('; ')}</p>}
                  </li>
                ))}
              </ol>
            )}
          </div>

          <div class={cartao}>
            <h2 class={tituloCartao}>Dispensas: pagamentos a empresas sem licitação informada</h2>
            <p class="mb-3 text-xs text-ink-soft">Considera só empresas (CNPJ); a licitação ou o contrato vem do detalhe de cada empenho no portal.</p>
            {lic && licBase > 0 ? (
              <>
                <div class="flex h-7 overflow-hidden rounded-[4px] bg-line" role="img" aria-label={`Com licitação ou contrato: ${((lic.com / licBase) * 100).toFixed(0)}%`}>
                  <span class="block h-full bg-nioaque-green" style={`width:${(lic.com / licBase) * 100}%`}></span>
                  <span class="block h-full bg-ocre" style={`width:${(lic.sem / licBase) * 100}%`}></span>
                </div>
                <ul class="mt-3 space-y-1 text-sm">
                  <li class="flex items-center justify-between gap-3"><span class="flex items-center gap-2"><span class="h-3 w-3 rounded-[2px] bg-nioaque-green"></span>Com licitação ou contrato · {((lic.com / licBase) * 100).toFixed(0)}%</span><strong class="tabular-nums">{brl(lic.com)}</strong></li>
                  <li class="flex items-center justify-between gap-3"><span class="flex items-center gap-2"><span class="h-3 w-3 rounded-[2px] bg-ocre"></span>Sem licitação informada · {((lic.sem / licBase) * 100).toFixed(0)}%</span><strong class="tabular-nums">{brl(lic.sem)}</strong></li>
                </ul>
                <p class="mt-2 text-xs text-ink-soft">"Sem licitação informada" inclui compras de pequeno valor e dispensas previstas em lei. Não é, por si só, irregularidade.</p>
                {lic.semDetalhe > 0 && <p class="mt-1 text-xs text-ink-soft">Fora da conta: {brl(lic.semDetalhe)} em despesas cujo detalhe o portal ainda não entregou.</p>}
                {semLic.length > 0 && (
                  <details class="mt-3 rounded-[4px] border border-pedra">
                    <summary class="flex min-h-[44px] cursor-pointer items-center px-3 text-sm font-bold text-nioaque-green-dark">Ver quem recebeu sem licitação informada ({semLic.length})<span class="ml-2 text-xs font-normal text-ink-soft">(clique para ver mais)</span></summary>
                    <ol class="divide-y divide-pedra border-t border-pedra text-sm">
                      {semLic.map((f) => (
                        <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 px-3 py-2">
                          <span class="min-w-0"><span class="font-semibold text-ink">{bonito(f.nome)}</span><span class="block text-xs text-ink-soft">{fmtCnpj(f.cnpj)}{f.oque ? ` · ${f.oque}` : ''}</span></span>
                          <strong class="shrink-0 tabular-nums">{brl(f.sem)}</strong>
                        </li>
                      ))}
                    </ol>
                  </details>
                )}
              </>
            ) : (
              <p class="text-sm text-ink-soft">Dados ainda não sincronizados com a fonte oficial.</p>
            )}
          </div>

          <p class={`${cartao} text-sm text-ink-soft`}>
            Contratos vigentes e editais de licitação não são entregues pela API de dados abertos; consulte a lista oficial em
            <a class="underline hover:text-nioaque-green-dark" href={`${BASE}/contratos/${ID}`} target="_blank" rel="noopener noreferrer">Contratos</a> e
            <a class="underline hover:text-nioaque-green-dark" href={`${BASE}/licitacoes/${ID}`} target="_blank" rel="noopener noreferrer">Licitações</a> no portal oficial.
          </p>
        </div>
      </section>

      <!-- ============================ ABA 4: SERVIDORES E FOLHA ============================ -->
      <section role="tabpanel" id="painel-servidores" data-painel="servidores" aria-labelledby="aba-servidores" hidden={aba !== 'servidores'}>
        <div class="grid gap-4 lg:grid-cols-3">
          <div class={cartao}>
            <h2 class={tituloCartao}>Folha paga em {ano}</h2>
            <dl class="mt-3 space-y-2 text-sm">
              <div class="flex items-baseline justify-between gap-3"><dt>Folha de pagamento</dt><dd class="font-bold tabular-nums">{brl(cat('folha'))}</dd></div>
              <div class="flex items-baseline justify-between gap-3"><dt>Encargos (INSS)</dt><dd class="font-bold tabular-nums">{brl(cat('encargos'))}</dd></div>
              <div class="flex items-baseline justify-between gap-3 border-t border-pedra pt-2"><dt class="font-semibold">Total</dt><dd class="font-bold tabular-nums">{brl(cat('folha') + cat('encargos'))}</dd></div>
              <div class="flex items-baseline justify-between gap-3 text-ink-soft"><dt>Do total pago</dt><dd class="tabular-nums">{pct1(cat('folha') + cat('encargos'))}%</dd></div>
            </dl>
          </div>
          <div class={`${cartao} lg:col-span-2`}>
            <h2 class={tituloCartao}>Quadro de servidores</h2>
            {servidores.length === 0 ? (
              <p class="mt-2 text-sm text-ink-soft">Dados ainda não sincronizados com a fonte oficial (folha de pagamento da Câmara).</p>
            ) : (
              <>
                <p class="mt-1 text-sm text-ink-soft">
                  <strong class="text-ink">{servidores.length}</strong> servidores na folha de {refFolha}; salário base somado de <strong class="tabular-nums text-ink">{brl(totalBase)}</strong> por mês.
                </p>
                <ul class="mt-2 flex flex-wrap gap-2 text-xs text-ink-soft">
                  {tipos.map((t) => <li class="rounded-[2px] bg-editorial px-2 py-1"><strong class="text-ink">{servidores.filter((s) => (s.tipo || 'Outros') === t).length}</strong> {t.toLowerCase()}</li>)}
                </ul>
              </>
            )}
          </div>
        </div>

        {servidores.length > 0 && (
          <div class="mt-4 space-y-3">
            {tipos.map((t) => {
              const lista = servidores.filter((s) => (s.tipo || 'Outros') === t).sort((a, b) => b.base - a.base);
              return (
                <details class="rounded-[4px] border border-pedra bg-branco" open={t === 'Cargo Eletivo'}>
                  <summary class="flex min-h-[44px] cursor-pointer items-center justify-between gap-3 px-4 py-2 font-editorial text-base font-extrabold text-ink">
                    <span>{t}<span class="ml-2 text-xs font-normal text-ink-soft">(clique para ver mais)</span></span><span class="text-sm font-normal text-ink-soft">{lista.length} {lista.length === 1 ? 'servidor' : 'servidores'}</span>
                  </summary>
                  <ul class="divide-y divide-pedra border-t border-pedra text-sm">
                    {lista.map((s) => (
                      <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 px-4 py-2">
                        <span class="min-w-0"><a href={`${BASE}/folha-de-pagamento/${ID}`} target="_blank" rel="noopener noreferrer" title="Abrir a folha de pagamento no portal oficial (busque pelo nome)" class="font-semibold text-ink underline decoration-pedra-escura underline-offset-2 hover:text-nioaque-green-dark">{s.nome}</a><span class="block text-xs text-ink-soft">{s.cargo} · {s.situacao}{s.admissao ? ` · admissão ${s.admissao}` : ''}</span></span>
                        <span class="shrink-0 text-right"><strong class="tabular-nums text-ink">{s.base > 0 ? brl(s.base) : 'sem salário base'}</strong><span class="block text-xs text-ink-soft">salário base</span></span>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })}
            <p class="text-xs text-ink-soft">
              Fonte: <a class="underline" href={`${BASE}/folha-de-pagamento/${ID}`} target="_blank" rel="noopener noreferrer">Folha de pagamento</a> do Portal da Transparência da Câmara, mês de {refFolha}. Salário base é o valor de tabela do cargo; o que cai na conta varia com férias, gratificações e descontos, por isso não o mostramos aqui. Não guardamos CPF.
            </p>
          </div>
        )}
      </section>
    </>
  )}
</div>

{exportData && <script type="application/json" id="export-data" set:html={JSON.stringify(exportData).replace(/</g, '\\u003c')} />}
<script>
  import '../../scripts/transparencia-export';
</script>
