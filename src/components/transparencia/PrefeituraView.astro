---
/**
 * Transparência da Prefeitura: topo fixo (busca e resumo) + 4 abas.
 * Todos os números vêm da tabela transparencia_cache (portal oficial, SICONFI, IBGE etc.).
 */
import ChartMeses from './ChartMeses.astro';
import FotoAutoridade from './FotoAutoridade.astro';
import Abas from './Abas.astro';
import ExternasView from './ExternasView.astro';
import { anoAtual, brl, brlCurto, MESES_LONGOS, parts, semAcento } from '../../lib/transparencia';
import { CATEGORIAS_PREF, slugDe, type CategoriaPref, type PrefEmpenho, type ResumoPref } from '../../lib/prefeitura';
import type { ResumoReceitas } from '../../lib/receitas';
import type { ResumoFolha } from '../../lib/folha';
import type { ResumoEstado, ResumoFederal, ResumoIbge } from '../../lib/externas';

interface Props {
  resumo: ResumoPref | null;
  receitas: ResumoReceitas | null;
  folha: ResumoFolha | null;
  estado: ResumoEstado | null;
  federal: ResumoFederal | null;
  ibge: ResumoIbge | null;
  ano: number;
  anos: number[];
  aba: string;
  q: string;
  orgaoSel: string;
  areaSel: string;
  catSel: string;
  escSel: string;
  autSel: string;
  pag: number;
  listaPref: PrefEmpenho[] | null;
  atualizadoEm: string | null;
  ID: string;
  BASE: string;
}
const { resumo, receitas, folha, estado, federal, ibge, ano, anos, aba, q, orgaoSel, areaSel, catSel, escSel, autSel, pag, listaPref, atualizadoEm, ID, BASE } = Astro.props;

const cartao = 'rounded-[4px] border border-pedra bg-branco p-4';
const tituloSecao = 'font-editorial text-2xl font-extrabold text-ink';
const tituloCartao = 'font-editorial text-lg font-extrabold text-ink';
const pill =
  'inline-flex min-h-[44px] items-center rounded-[4px] border border-pedra bg-branco px-4 text-sm font-semibold text-ink hover:border-nioaque-green hover:text-nioaque-green-dark';
const botao =
  'inline-flex min-h-[44px] items-center gap-2 rounded-[4px] bg-nioaque-green px-4 text-sm font-semibold text-white hover:bg-nioaque-green-dark disabled:opacity-60';
const url = (extra: Record<string, string | number>, ancora = '') => {
  const p = new URLSearchParams({ entidade: 'prefeitura', ano: String(ano), aba, ...Object.fromEntries(Object.entries(extra).map(([k, v]) => [k, String(v)])) });
  return `?${p.toString()}${ancora}`;
};
const dataBr = (iso: string) => iso.split('-').reverse().join('/');
const fmtCnpj = (c: string) =>
  c.length === 14 ? c.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5') : c.length === 11 ? `CPF ***.${c.slice(3, 6)}.${c.slice(6, 9)}-**` : c;

let ultimoMes = 0;
if (resumo) resumo.porMes.forEach((v, i) => v > 0 && (ultimoMes = i));
const periodo = resumo ? (ultimoMes === 0 ? `janeiro de ${ano}` : `janeiro a ${MESES_LONGOS[ultimoMes]} de ${ano}`) : String(ano);
// o ano exibido é o corrente: o último mês com valor ainda está em andamento
const mesAndamento = resumo && ano === anoAtual() && ultimoMes === Number(parts().month) - 1 ? ultimoMes : undefined;

// custo por habitante: estimativa de população do IBGE mais recente até o ano exibido
const pop = ibge ? ([...ibge.estimativas].filter((e) => e.ano <= ano).sort((a, b) => b.ano - a.ano)[0] ?? null) : null;

const maxSec = resumo?.porSecretaria[0]?.valor || 1;
const maxFun = resumo?.porFuncao[0]?.valor || 1;
const pct = (v: number) => (resumo && resumo.totalPago ? (v / resumo.totalPago) * 100 : 0);
const pct1 = (v: number) => pct(v).toFixed(1).replace('.', ',');

// "Para onde vai o dinheiro": os três blocos pedidos mais "demais", para a soma fechar com o total pago
const gFolha = resumo ? resumo.porCategoria.pessoal + resumo.porCategoria.encargos : 0;
const gServicos = resumo ? resumo.porCategoria.servicos : 0;
const gObras = resumo ? resumo.porCategoria.obras : 0;
const gOutros = resumo ? resumo.porCategoria.diarias + resumo.porCategoria.repasses + resumo.porCategoria.outras : 0;
const destinos = [
  { nome: 'Folha e encargos', detalhe: 'Salários e INSS', valor: gFolha, cor: '#0D4722', cat: 'pessoal' },
  { nome: 'Serviços e materiais', detalhe: 'Empresas, manutenção, combustível, medicamentos', valor: gServicos, cor: '#6FCB8B', cat: 'servicos' },
  { nome: 'Obras e equipamentos', detalhe: 'Investimentos', valor: gObras, cor: '#2B6CB0', cat: 'obras' },
  { nome: 'Diárias, repasses e demais', detalhe: 'Viagens a serviço, subvenções e outras despesas (inclui pagamento de dívida)', valor: gOutros, cor: '#8A8F8A', cat: '' },
];

const escalao = resumo?.escalao ?? [];
const escFiltrado = escalao.filter((a) => (escSel === 'prefeito' ? a.grupo !== 'secretario' : escSel === 'secretarios' ? a.grupo === 'secretario' : true));
const selecionada = escalao.find((a) => a.slug === autSel) ?? null;
const totalEscalao = escalao.reduce((s, a) => s + a.total, 0);

const norm = (t: string) => semAcento(t);
const digitos = q.replace(/\D/g, '');
const filtrando = Boolean(q || orgaoSel || areaSel || catSel);
const todos = listaPref
  ? listaPref.filter(
      (e) =>
        (!q || norm(e.c).includes(norm(q)) || (digitos.length >= 4 && e.j.includes(digitos))) &&
        (!orgaoSel || slugDe(e.s) === orgaoSel) &&
        (!areaSel || slugDe(e.f) === areaSel) &&
        (!catSel || e.t === catSel),
    )
  : null;
const POR_PAGINA = 25;
const resultados = todos ? todos.slice((pag - 1) * POR_PAGINA, pag * POR_PAGINA) : [];
const totalResultados = todos ? todos.reduce((s, e) => s + e.p, 0) : 0;
const paginas = todos ? Math.max(1, Math.ceil(todos.length / POR_PAGINA)) : 1;
const filtroParams = { ...(q ? { q } : {}), ...(orgaoSel ? { orgao: orgaoSel } : {}), ...(areaSel ? { area: areaSel } : {}), ...(catSel ? { cat: catSel } : {}) };
const nomeOrgao = resumo?.porSecretaria.find((s) => s.slug === orgaoSel)?.nome;
const nomeArea = resumo?.porFuncao.find((s) => s.slug === areaSel)?.nome;
const atual = atualizadoEm ? new Date(atualizadoEm).toLocaleDateString('pt-BR', { timeZone: 'America/Campo_Grande' }) : null;

const ICONE_PNG = 'M4 5h16v14H4z M4 15l4-4 4 4 3-3 5 5 M15.5 9.5h.01';
const botaoPng = 'inline-flex min-h-[44px] items-center gap-2 rounded-[4px] border border-nioaque-green bg-branco px-4 text-sm font-semibold text-nioaque-green-dark hover:bg-nioaque-green-50 disabled:opacity-60 print:hidden';
const ICONE_PDF = 'M7 3h7l5 5v13H7z M14 3v5h5 M9.5 13h5 M9.5 17h5';
const folhaDe = (slug: string) => {
  const f = folha?.itens[slug];
  return f && f.nome ? f : null;
};
const refFolhaTxt = folha ? folha.ref.slice(5) + '/' + folha.ref.slice(0, 4) : '';
const folhaEscalao = escalao.map((a) => folhaDe(a.slug)).filter((f): f is NonNullable<ReturnType<typeof folhaDe>> => f !== null);
const cargoCurto = (c: string) => c.replace(/^Secret[áa]ri[oa] Municipal d[aeo]s? /i, 'Secretaria de ');
const exportData = resumo
  ? {
      ano,
      periodo,
      atualizadoEm: atualizadoEm ?? resumo.atualizadoEm,
      totais: { empenhado: resumo.totalEmpenhado, liquidado: resumo.totalLiquidado, pago: resumo.totalPago, qtd: resumo.qtd },
      porMes: resumo.porMes,
      ultimoMes,
      categorias: (Object.keys(CATEGORIAS_PREF) as CategoriaPref[]).map((c) => ({ label: CATEGORIAS_PREF[c].label, cor: CATEGORIAS_PREF[c].cor, valor: resumo.porCategoria[c] })),
      licitacao: { com: resumo.comLicitacao, sem: resumo.semLicitacao },
      escalao: escalao.map((a) => ({
        slug: a.slug,
        nome: a.nome,
        cargo: a.cargo,
        cargoCurto: cargoCurto(a.cargo),
        foto: a.foto,
        total: a.total,
        qtd: a.qtd,
        diarias: a.diarias,
        folha: folhaDe(a.slug),
        lista: a.lista.slice(0, 12).map((l) => ({ d: l.d, valor: l.valor, tipo: l.tipo, secretaria: l.secretaria })),
      })),
      secretarias: resumo.porSecretaria.slice(0, 12).map((x) => ({ nome: x.nome, valor: x.valor, qtd: x.qtd })),
      areas: resumo.porFuncao.slice(0, 12).map((x) => ({ nome: x.nome, valor: x.valor, qtd: x.qtd })),
      fornecedores: resumo.credores.slice(0, 12).map((c) => ({ nome: c.nome, valor: c.pago, qtd: c.empenhos })),
      receitas,
      refFolha: refFolhaTxt,
    }
  : null;
const NOMES_MES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
const periodoReceitas = receitas ? `janeiro a ${NOMES_MES[Math.min(11, receitas.bimestre * 2 - 1)]} de ${receitas.ano}` : '';
const maxGrupo = receitas ? Math.max(...receitas.grupos.map((g) => g.arrecadado), 1) : 1;
const maxBim = receitas ? Math.max(...receitas.porBimestre, 1) : 1;

const fornecedores = resumo?.fornecedores ?? [];
const semLicCredores = resumo?.semLicCredores ?? [];
const diariasRanking = resumo?.diariasRanking ?? [];
const maxForn = fornecedores[0]?.pago || 1;
const baseLic = resumo ? resumo.comLicitacao + resumo.semLicitacao : 0;
const ABAS = [
  { id: 'geral', label: 'Visão geral' },
  { id: 'fornecedores', label: 'Fornecedores e licitações' },
  { id: 'escalao', label: 'Primeiro escalão, folha e diárias' },
  { id: 'receitas', label: 'Receitas' },
];
---

<div id="p-conteudo" data-titulo={`Transparência da Prefeitura de Nioaque ${ano}`}>
  {!resumo && (
    <p class={`${cartao} mb-10 text-sm text-ink-soft`}>
      Dados ainda não sincronizados com a fonte oficial para {ano}. Enquanto isso, consulte direto no
      <a class="underline" href={`${BASE}/${ID}`} target="_blank" rel="noopener noreferrer">Portal da Transparência oficial</a>.
    </p>
  )}

  {resumo && (
    <>
      <!-- ============================ TOPO FIXO ============================ -->
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3 print:hidden">
        <nav aria-label="Ano" class="flex gap-1">
          {anos.map((a) => (
            <a
              href={`?entidade=prefeitura&ano=${a}&aba=${aba}`}
              aria-current={a === ano ? 'true' : undefined}
              class:list={['inline-flex min-h-[44px] min-w-[56px] items-center justify-center rounded-[4px] border px-3 text-sm font-semibold tabular-nums', a === ano ? 'border-nioaque-green bg-nioaque-green text-white' : 'border-pedra bg-branco text-ink hover:border-nioaque-green']}
            >
              {a}
            </a>
          ))}
        </nav>
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-pdf="#p-conteudo" class={botao}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_PDF}></path></svg>
            <span data-rotulo>Exportar PDF</span>
          </button>
        </div>
      </div>

      <section aria-label="Resumo do ano" class="mb-5">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-nioaque-green">Total geral da Prefeitura · pago em {ano}</p>
          <button type="button" data-png-pref="resumo" class={botaoPng}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_PNG}></path></svg>
            <span data-rotulo>Salvar resumo (PNG)</span>
          </button>
        </div>
        <div class="mt-1 flex flex-wrap items-baseline gap-x-6 gap-y-1">
          <p class="font-editorial text-[clamp(2rem,9vw,3.25rem)] font-extrabold leading-none tabular-nums text-nioaque-green-dark">{brl(resumo.totalPago)}</p>
          {pop && (
            <p class="text-base text-ink">
              <strong class="tabular-nums">{brl(resumo.totalPago / pop.valor)}</strong> por habitante
              <span class="block text-xs text-ink-soft">População estimada de {pop.valor.toLocaleString('pt-BR')} (IBGE, {pop.ano}).</span>
            </p>
          )}
        </div>
        <p class="mt-2 text-sm text-ink-soft">
          {periodo}. Dinheiro que já saiu do cofre.
          Liquidado: <abbr title="Produto ou serviço já recebido e conferido" class="no-underline"><span class="tabular-nums">{brl(resumo.totalLiquidado)}</span></abbr>
          · Reservado (empenhado): <abbr title="Valor separado no orçamento para a despesa" class="no-underline"><span class="tabular-nums">{brl(resumo.totalEmpenhado)}</span></abbr>
          · {resumo.qtd.toLocaleString('pt-BR')} despesas.
          {atual ? ` Atualizado semanalmente (última vez em ${atual}).` : ''}
        </p>
      </section>

      <form id="busca" method="get" action="#busca" class="mb-5 scroll-mt-24 print:hidden">
        <input type="hidden" name="entidade" value="prefeitura" />
        <input type="hidden" name="ano" value={ano} />
        <input type="hidden" name="aba" value={aba} />
        {areaSel && <input type="hidden" name="area" value={areaSel} />}
        <label class="sr-only" for="q-pref">Pesquisar fornecedor, CNPJ, servidor ou despesa</label>
        <div class="flex gap-2">
          <input id="q-pref" name="q" value={q} type="search" placeholder="Pesquisar fornecedor, CNPJ, servidor ou despesa..." class="min-h-[48px] min-w-0 flex-1 rounded-[4px] border-2 border-pedra bg-branco px-4 text-base text-ink focus:border-nioaque-green" />
          <button type="submit" class={`${botao} min-h-[48px] px-5`}>Buscar</button>
        </div>
        <details class="mt-2" open={Boolean(orgaoSel || catSel)}>
          <summary class="inline-flex min-h-[44px] cursor-pointer items-center text-sm font-semibold text-nioaque-green-dark">Filtrar por secretaria ou tipo de gasto<span class="ml-2 text-xs font-normal text-ink-soft">(clique para ver mais)</span></summary>
          <div class="mt-2 grid gap-3 sm:grid-cols-2">
            <label class="text-sm font-semibold text-ink">
              Secretaria ou órgão
              <select name="orgao" class="mt-1 min-h-[44px] w-full rounded-[4px] border border-pedra bg-branco px-2 text-sm font-normal text-ink">
                <option value="">Todas</option>
                {resumo.porSecretaria.map((s) => <option value={s.slug} selected={s.slug === orgaoSel}>{s.nome}</option>)}
              </select>
            </label>
            <label class="text-sm font-semibold text-ink">
              Tipo de gasto
              <select name="cat" class="mt-1 min-h-[44px] w-full rounded-[4px] border border-pedra bg-branco px-2 text-sm font-normal text-ink">
                <option value="">Todos</option>
                {(Object.keys(CATEGORIAS_PREF) as CategoriaPref[]).map((c) => <option value={c} selected={c === catSel}>{CATEGORIAS_PREF[c].label}</option>)}
              </select>
            </label>
          </div>
        </details>
      </form>

      {filtrando && (
        <section id="p-resultados" data-titulo={`Despesas da Prefeitura de Nioaque ${ano}`} class={`${cartao} mb-8`} aria-label="Resultados da busca">
          <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            {todos && (
              <p class="text-sm text-ink">
                <span class="block text-xs font-bold uppercase tracking-[0.1em] text-nioaque-green">Resultado da busca (não é o total geral)</span>
                <strong>{todos.length.toLocaleString('pt-BR')}</strong> {todos.length === 1 ? 'despesa encontrada' : 'despesas encontradas'}, somando <strong>{brl(totalResultados)}</strong> pagos em {ano}
                {nomeOrgao ? ` · ${nomeOrgao}` : ''}{nomeArea ? ` · área ${nomeArea}` : ''}{catSel && CATEGORIAS_PREF[catSel as CategoriaPref] ? ` · ${CATEGORIAS_PREF[catSel as CategoriaPref].label}` : ''}{q ? ` · "${q}"` : ''}.
              </p>
            )}
            <div class="flex gap-2 print:hidden">
              <button type="button" data-pdf="#p-resultados" class={botao}>
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_PDF}></path></svg>
                <span data-rotulo>PDF</span>
              </button>
              <a href={`?entidade=prefeitura&ano=${ano}&aba=${aba}`} class={pill}>Limpar busca</a>
            </div>
          </div>
          {todos && todos.length === 0 && <p class="text-sm text-ink-soft">Nada encontrado com esses filtros.</p>}
          {resultados.length > 0 && (
            <ul class="divide-y divide-pedra rounded-[4px] border border-pedra">
              {resultados.map((e) => (
                <li class="p-3 text-sm">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <strong class="min-w-0 text-ink">{e.c}</strong>
                    <strong class="shrink-0 tabular-nums text-ink">{brl(e.p)}</strong>
                  </div>
                  <div class="mt-0.5 text-xs text-ink-soft">
                    {dataBr(e.d)} · empenho {e.n} · {e.s} · {CATEGORIAS_PREF[e.t].label}
                    {e.lic ? ` · ${e.lic}` : ''}
                  </div>
                </li>
              ))}
            </ul>
          )}
          {todos && paginas > 1 && (
            <nav aria-label="Páginas de resultados" class="mt-3 flex flex-wrap items-center gap-2 print:hidden">
              {pag > 1 && <a href={url({ ...filtroParams, pag: pag - 1 }, '#busca')} class={pill}>Anterior</a>}
              <span class="text-sm text-ink-soft">Página {pag} de {paginas}</span>
              {pag < paginas && <a href={url({ ...filtroParams, pag: pag + 1 }, '#busca')} class={pill}>Próxima</a>}
            </nav>
          )}
          <p class="mt-2 text-xs text-ink-soft">
            Fonte: API de Dados Abertos da Prefeitura (Quality Sistemas). Empenhos repetidos pela fonte são contados uma só vez.
            {resumo.semDetalhe > 0 && ` Em ${resumo.semDetalhe} despesas o portal não informou a natureza; elas entram em "Serviços e materiais" e em "Não identificada".`}
          </p>
        </section>
      )}

      <Abas abas={ABAS} ativa={aba} params={{ entidade: 'prefeitura', ano, ...filtroParams }} />

      <!-- ============================ ABA 1: VISÃO GERAL ============================ -->
      <section role="tabpanel" id="painel-geral" data-painel="geral" aria-labelledby="aba-geral" hidden={aba !== 'geral'}>
        <div class="grid gap-4 lg:grid-cols-2 lg:items-start">
          <div class={cartao}>
            <h2 class={tituloCartao}>Para onde vai o dinheiro</h2>
            <p class="mb-3 text-xs text-ink-soft">Cada real pago em {ano}, por tipo de gasto.</p>
            <div class="flex h-6 overflow-hidden rounded-[4px] bg-line" role="img" aria-label={destinos.map((d) => `${d.nome}: ${pct1(d.valor)}%`).join('; ')}>
              {destinos.map((d) => <span class="block h-full" style={`width:${pct(d.valor)}%;background:${d.cor}`}></span>)}
            </div>
            <ul class="mt-3 space-y-3">
              {destinos.map((d) => (
                <li>
                  <div class="flex items-baseline justify-between gap-3 text-sm">
                    <span class="flex min-w-0 items-center gap-2 text-ink"><span class="h-3 w-3 shrink-0 rounded-[2px]" style={`background:${d.cor}`}></span>{d.cat ? <a class="hover:text-nioaque-green-dark" href={url({ cat: d.cat }, '#busca')}>{d.nome}</a> : d.nome}</span>
                    <strong class="shrink-0 tabular-nums">{brl(d.valor)}</strong>
                  </div>
                  <p class="ml-5 text-xs text-ink-soft">{pct1(d.valor)}% · {d.detalhe}</p>
                </li>
              ))}
            </ul>
          </div>

          <div class={cartao} data-alterna>
            <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
              <h2 class={tituloCartao}>Gastos por área ou secretaria</h2>
              <div class="flex gap-1" role="group" aria-label="Agrupar por">
                <button type="button" data-alvo="area" aria-pressed="true" class="min-h-[44px] rounded-[4px] border border-nioaque-green bg-nioaque-green px-3 text-sm font-semibold text-white">Por área</button>
                <button type="button" data-alvo="secretaria" aria-pressed="false" class="min-h-[44px] rounded-[4px] border border-pedra bg-branco px-3 text-sm font-semibold text-ink hover:border-nioaque-green">Por secretaria</button>
              </div>
            </div>
            <div data-visao="secretaria" hidden>
              <ul class="space-y-3">
                {resumo.porSecretaria.slice(0, 10).map((s) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3 text-sm"><a href={url({ orgao: s.slug }, '#busca')} class="min-w-0 text-ink hover:text-nioaque-green-dark">{s.nome}</a><strong class="shrink-0 tabular-nums">{brl(s.valor)}</strong></div>
                    <div class="mt-1 h-2 rounded-[2px] bg-line"><div class="h-full rounded-[2px] bg-nioaque-green" style={`width:${(s.valor / maxSec) * 100}%`}></div></div>
                    <p class="mt-0.5 text-xs text-ink-soft">{pct1(s.valor)}% do total · {s.qtd.toLocaleString('pt-BR')} despesas</p>
                  </li>
                ))}
              </ul>
              <button type="button" data-png-pref="secretarias" class={`${botaoPng} mt-3`}>
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_PNG}></path></svg>
                <span data-rotulo>Salvar imagem (PNG)</span>
              </button>
            </div>
            <div data-visao="area">
              <p class="mb-2 text-xs text-ink-soft">Saúde, educação, assistência social e outras áreas, somando todos os órgãos.</p>
              <ul class="space-y-3">
                {resumo.porFuncao.slice(0, 10).map((s) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3 text-sm"><a href={url({ area: s.slug }, '#busca')} class="min-w-0 text-ink hover:text-nioaque-green-dark">{s.nome}</a><strong class="shrink-0 tabular-nums">{brl(s.valor)}</strong></div>
                    <div class="mt-1 h-2 rounded-[2px] bg-line"><div class="h-full rounded-[2px] bg-nioaque-red" style={`width:${(s.valor / maxFun) * 100}%`}></div></div>
                    <p class="mt-0.5 text-xs text-ink-soft">{pct1(s.valor)}% do total</p>
                  </li>
                ))}
              </ul>
              <button type="button" data-png-pref="areas" class={`${botaoPng} mt-3`}>
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_PNG}></path></svg>
                <span data-rotulo>Salvar imagem (PNG)</span>
              </button>
            </div>
          </div>

          <div class={`${cartao} lg:col-span-2`}>
            <h2 class={`${tituloCartao} mb-3`}>Pago por mês</h2>
            <ChartMeses series={[{ label: 'Pago', cor: '#166A34', valores: resumo.porMes }]} ultimoMes={ultimoMes} mesAndamento={mesAndamento} altura={220} brl={brl} descricao="Valor pago por mês" />
          </div>
        </div>
      </section>

      <!-- ============================ ABA 2: FORNECEDORES ============================ -->
      <section role="tabpanel" id="painel-fornecedores" data-painel="fornecedores" aria-labelledby="aba-fornecedores" hidden={aba !== 'fornecedores'}>
        <div class="grid gap-4">
          <div class={cartao}>
            <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
              <div>
                <h2 class={tituloCartao}>Maiores fornecedores</h2>
                <p class="text-xs text-ink-soft">Quem mais recebeu da Prefeitura em {ano}, sem folha, encargos e diárias.</p>
              </div>
              <button type="button" data-png-pref="fornecedores" class={botaoPng}>
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_PNG}></path></svg>
                <span data-rotulo>Salvar imagem (PNG)</span>
              </button>
            </div>
            {fornecedores.length === 0 ? (
              <p class="text-sm text-ink-soft">Dados ainda não sincronizados com a fonte oficial. Eles aparecem após a próxima atualização semanal.</p>
            ) : (
              <ol class="space-y-4">
                {fornecedores.slice(0, 10).map((f, i) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3 text-sm">
                      <a href={url({ q: f.cnpj.length >= 11 ? f.cnpj : f.nome }, '#busca')} class="min-w-0 font-semibold text-ink hover:text-nioaque-green-dark"><span class="tabular-nums text-ink-soft">{i + 1}.</span> {f.nome}</a>
                      <strong class="shrink-0 tabular-nums">{brl(f.pago)}</strong>
                    </div>
                    <div class="mt-1 h-2 rounded-[2px] bg-line"><div class="h-full rounded-[2px] bg-nioaque-green" style={`width:${(f.pago / maxForn) * 100}%`}></div></div>
                    <p class="mt-0.5 text-xs text-ink-soft">{fmtCnpj(f.cnpj)}{f.oque ? ` · ${f.oque}` : ''} · {f.empenhos} {f.empenhos === 1 ? 'despesa' : 'despesas'}</p>
                  </li>
                ))}
              </ol>
            )}
            <p class="mt-3 text-xs text-ink-soft">"O que fornece" é a natureza da despesa mais frequente nos empenhos da empresa, como o portal informa.</p>
          </div>

          <div class={cartao}>
            <h2 class={tituloCartao}>Compras com licitação ou sem licitação informada</h2>
            <p class="mb-3 text-xs text-ink-soft">Considera serviços, materiais, obras, diárias e repasses (não inclui folha nem encargos).</p>
            {baseLic > 0 ? (
              <>
                <div class="flex h-7 overflow-hidden rounded-[4px] bg-line" role="img" aria-label={`Com licitação ou contrato: ${((resumo.comLicitacao / baseLic) * 100).toFixed(0)}%`}>
                  <span class="block h-full bg-nioaque-green" style={`width:${(resumo.comLicitacao / baseLic) * 100}%`}></span>
                  <span class="block h-full bg-ocre" style={`width:${(resumo.semLicitacao / baseLic) * 100}%`}></span>
                </div>
                <ul class="mt-3 space-y-1 text-sm">
                  <li class="flex items-center justify-between gap-3"><span class="flex items-center gap-2"><span class="h-3 w-3 rounded-[2px] bg-nioaque-green"></span>Com licitação ou contrato · {((resumo.comLicitacao / baseLic) * 100).toFixed(0)}%</span><strong class="tabular-nums">{brl(resumo.comLicitacao)}</strong></li>
                  <li class="flex items-center justify-between gap-3"><span class="flex items-center gap-2"><span class="h-3 w-3 rounded-[2px] bg-ocre"></span>Sem licitação informada · {((resumo.semLicitacao / baseLic) * 100).toFixed(0)}%</span><strong class="tabular-nums">{brl(resumo.semLicitacao)}</strong></li>
                </ul>
                <p class="mt-2 text-xs text-ink-soft">"Sem licitação informada" inclui compras de pequeno valor, dispensas previstas em lei e despesas em que o portal não registra o número da licitação. Não é, por si só, irregularidade.</p>
                {(resumo.licSemDetalhe ?? 0) > 0 && <p class="mt-1 text-xs text-ink-soft">Fora da conta: {brl(resumo.licSemDetalhe ?? 0)} pagos em despesas cujo detalhe o portal ainda não entregou.</p>}
                {semLicCredores.length > 0 && (
                  <details class="mt-3 rounded-[4px] border border-pedra">
                    <summary class="flex min-h-[44px] cursor-pointer items-center px-3 text-sm font-bold text-nioaque-green-dark">Ver quem recebeu sem licitação informada ({semLicCredores.length} maiores)<span class="ml-2 text-xs font-normal text-ink-soft">(clique para ver mais)</span></summary>
                    <ol class="divide-y divide-pedra border-t border-pedra text-sm">
                      {semLicCredores.map((f) => (
                        <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 px-3 py-2">
                          <span class="min-w-0"><a href={url({ q: f.cnpj.length >= 11 ? f.cnpj : f.nome }, '#busca')} class="font-semibold text-ink hover:text-nioaque-green-dark">{f.nome}</a><span class="block text-xs text-ink-soft">{fmtCnpj(f.cnpj)}{f.oque ? ` · ${f.oque}` : ''}</span></span>
                          <strong class="shrink-0 tabular-nums">{brl(f.pago)}</strong>
                        </li>
                      ))}
                    </ol>
                  </details>
                )}
              </>
            ) : (
              <p class="text-sm text-ink-soft">Dados ainda não sincronizados com a fonte oficial.</p>
            )}
          </div>
        </div>
      </section>

      <!-- ============================ ABA 3: PRIMEIRO ESCALÃO ============================ -->
      <section role="tabpanel" id="painel-escalao" data-painel="escalao" aria-labelledby="aba-escalao" hidden={aba !== 'escalao'}>
      <!-- ============================ PRIMEIRO ESCALÃO ============================ -->
      <div id="p-escalao" class="scroll-mt-24">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
          <div class="border-l-4 border-nioaque-red pl-3">
            <h2 class={tituloSecao}>Primeiro escalão</h2>
            <p class="text-sm text-ink-soft">Prefeito, vice e secretários: o que foi pago a cada um em {ano}, separado dos demais servidores.</p>
          </div>
          <div class="flex flex-wrap items-center gap-2 print:hidden">
          <button type="button" data-png-pref="escalao" class={botaoPng}>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_PNG}></path></svg>
            <span data-rotulo>Salvar imagem (PNG)</span>
          </button>
          <nav aria-label="Filtrar primeiro escalão" class="flex flex-wrap gap-1">
            {[
              ['', 'Todos'],
              ['prefeito', 'Prefeito e vice'],
              ['secretarios', 'Secretários'],
            ].map(([v, r]) => (
              <a
                href={url({ aba: 'escalao', ...(v ? { escalao: v } : {}) }, '#abas')}
                aria-current={escSel === v ? 'true' : undefined}
                class:list={['inline-flex min-h-[44px] items-center rounded-[4px] border px-3 text-sm font-semibold', escSel === v ? 'border-nioaque-green bg-nioaque-green text-white' : 'border-pedra bg-branco text-ink hover:border-nioaque-green']}
              >
                {r}
              </a>
            ))}
          </nav>
          </div>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {escFiltrado.map((a) => (
            <li class={`flex h-full flex-col rounded-[4px] border bg-branco transition-colors hover:border-nioaque-green ${selecionada?.slug === a.slug ? 'border-2 border-nioaque-green' : 'border-pedra'}`}>
              <a
                href={url({ aba: 'escalao', ...(escSel ? { escalao: escSel } : {}), autoridade: a.slug }, '#p-autoridade')}
                aria-current={selecionada?.slug === a.slug ? 'true' : undefined}
                class="flex min-h-[44px] flex-1 gap-3 p-3"
              >
                <FotoAutoridade foto={a.foto} nome={a.nome} tam={72} />
                <span class="min-w-0">
                  <span class="block font-editorial text-lg font-extrabold leading-tight text-ink">{a.nome}</span>
                  <span class="block text-xs text-ink-soft">{a.cargo}</span>
                  {folhaDe(a.slug) && (
                    <>
                      <span class="mt-1 block text-base font-bold tabular-nums text-ink">Salário líquido {brl(folhaDe(a.slug)!.liquido)}</span>
                      <span class="block text-xs text-ink-soft">bruto {brl(folhaDe(a.slug)!.bruto)} · folha de {refFolhaTxt}</span>
                    </>
                  )}
                  <span class="mt-1 block text-sm text-ink-soft">Diárias e reembolsos: <strong class="tabular-nums text-nioaque-red-dark">{brl(a.total)}</strong></span>
                  <span class="block text-xs text-ink-soft">{a.qtd === 0 ? 'nenhum pagamento individual' : `${a.qtd} ${a.qtd === 1 ? 'pagamento' : 'pagamentos'}${a.diarias > 0 ? ` · diárias ${brl(a.diarias)}` : ''}`}</span>
                </span>
              </a>
              <button type="button" data-png-pref={`autoridade:${a.slug}`} class="mx-3 mb-3 inline-flex min-h-[44px] items-center justify-center gap-2 rounded-[4px] border border-pedra px-3 text-xs font-semibold text-nioaque-green-dark hover:border-nioaque-green print:hidden">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_PNG}></path></svg>
                <span data-rotulo>Salvar imagem (PNG)</span>
              </button>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-ink-soft">
          {folha
            ? 'Salário: folha de pagamento de ' + refFolhaTxt + ' (bruto = antes dos descontos; líquido = o que cai na conta). '
            : 'O salário vem da folha de pagamento, que ainda não foi carregada. '}
          Diárias e reembolsos: pagamentos feitos em nome de cada autoridade em {ano}, {brl(totalEscalao)} no total. Fonte: Portal da Transparência da Prefeitura (
          <a class="underline" href={BASE + '/folha-de-pagamento/' + ID} target="_blank" rel="noopener noreferrer">Folha de pagamento</a>).
        </p>

        {selecionada && (
          <div id="p-autoridade" class={`${cartao} mt-4 scroll-mt-24`}>
            <h3 class="font-editorial text-xl font-extrabold text-ink">{selecionada.nome} <span class="text-sm font-semibold text-ink-soft">· {selecionada.cargo}</span></h3>
            {folhaDe(selecionada.slug) && (
              <p class="mt-2 text-sm text-ink">
                Folha de {refFolhaTxt}: salário base <strong class="tabular-nums">{brl(folhaDe(selecionada.slug)!.base)}</strong> · bruto <strong class="tabular-nums">{brl(folhaDe(selecionada.slug)!.bruto)}</strong> · descontos <strong class="tabular-nums">{brl(folhaDe(selecionada.slug)!.descontos)}</strong> · líquido <strong class="tabular-nums">{brl(folhaDe(selecionada.slug)!.liquido)}</strong>
              </p>
            )}
            {selecionada.lista.length === 0 ? (
              <p class="mt-2 text-sm text-ink-soft">Nenhum pagamento individual registrado em {ano}.</p>
            ) : (
              <ul class="mt-3 divide-y divide-pedra text-sm">
                {selecionada.lista.map((p) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2">
                    <span class="min-w-0"><span class="tabular-nums text-ink-soft">{dataBr(p.d)}</span> · {p.tipo} <span class="text-ink-soft">({p.secretaria})</span></span>
                    <strong class="tabular-nums">{brl(p.valor)}</strong>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}
      </div>

        <div class="mt-8 grid gap-4 lg:grid-cols-2">
          <div class={cartao}>
            <h2 class={tituloCartao}>Resumo da folha</h2>
            <p class="mb-3 text-xs text-ink-soft">Pagamentos de pessoal em {ano}, segundo as despesas do portal.</p>
            <dl class="space-y-2 text-sm">
              <div class="flex items-baseline justify-between gap-3"><dt class="text-ink">Folha de pagamento (salários)</dt><dd class="font-bold tabular-nums">{brl(resumo.porCategoria.pessoal)}</dd></div>
              <div class="flex items-baseline justify-between gap-3"><dt class="text-ink">Encargos (INSS e outros)</dt><dd class="font-bold tabular-nums">{brl(resumo.porCategoria.encargos)}</dd></div>
              <div class="flex items-baseline justify-between gap-3 border-t border-pedra pt-2"><dt class="font-semibold text-ink">Folha e encargos</dt><dd class="font-bold tabular-nums">{brl(gFolha)}</dd></div>
              <div class="flex items-baseline justify-between gap-3"><dt class="text-ink-soft">Do total pago no ano</dt><dd class="font-semibold tabular-nums">{pct1(gFolha)}%</dd></div>
            </dl>
            {folhaEscalao.length > 0 && (
              <p class="mt-3 text-xs text-ink-soft">
                Primeiro escalão ({folhaEscalao.length} {folhaEscalao.length === 1 ? 'autoridade' : 'autoridades'}, folha de {refFolhaTxt}): bruto somado de <strong class="tabular-nums">{brl(folhaEscalao.reduce((s, f) => s + f.bruto, 0))}</strong> no mês.
              </p>
            )}
          </div>
          <div class={cartao}>
            <h2 class={tituloCartao}>Diárias do Executivo</h2>
            <p class="mb-3 text-xs text-ink-soft">{resumo.diariasQtd} {resumo.diariasQtd === 1 ? 'pagamento' : 'pagamentos'} em {ano}, somando <strong class="tabular-nums text-ink">{brl(resumo.diariasTotal)}</strong> ({pct1(resumo.diariasTotal)}% do pago).</p>
            {diariasRanking.length === 0 ? (
              <p class="text-sm text-ink-soft">{resumo.diariasQtd === 0 ? `Nenhuma diária registrada em ${ano}.` : 'Dados ainda não sincronizados com a fonte oficial.'}</p>
            ) : (
              <ol class="divide-y divide-pedra text-sm">
                {diariasRanking.slice(0, 10).map((r, i) => (
                  <li class="flex items-baseline justify-between gap-3 py-2">
                    <a href={url({ q: r.nome }, '#busca')} class="min-w-0 text-ink hover:text-nioaque-green-dark"><span class="tabular-nums text-ink-soft">{i + 1}.</span> {r.nome}<span class="block text-xs text-ink-soft">{r.qtd} {r.qtd === 1 ? 'pagamento' : 'pagamentos'}</span></a>
                    <strong class="shrink-0 tabular-nums">{brl(r.pago)}</strong>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </div>
      </section>

      <!-- ============================ ABA 4: RECEITAS ============================ -->
      <section role="tabpanel" id="painel-receitas" data-painel="receitas" aria-labelledby="aba-receitas" hidden={aba !== 'receitas'}>
        {!receitas && <p class={`${cartao} mb-8 text-sm text-ink-soft`}>Receitas: dados ainda não sincronizados com a fonte oficial (Tesouro Nacional).</p>}
      {receitas && (
        <section id="p-receitas" class="mb-10 scroll-mt-24">
          <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
            <div class="border-l-4 border-nioaque-red pl-3">
              <h2 class={tituloSecao}>Receitas: de onde vem o dinheiro</h2>
              <p class="text-sm text-ink-soft">{periodoReceitas}. Dados que a Prefeitura informa ao Tesouro Nacional (a cada dois meses).</p>
            </div>
            <button type="button" data-png-pref="receitas" class={botaoPng}>
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ICONE_PNG}></path></svg>
              <span data-rotulo>Salvar imagem (PNG)</span>
            </button>
          </div>

          <dl class="grid gap-3 sm:grid-cols-3">
            <div class={`${cartao} @container`}>
              <dt class="text-xs font-bold uppercase tracking-[0.12em] text-ink-soft">Arrecadado</dt>
              <dd class="mt-1 whitespace-nowrap font-editorial text-[clamp(1rem,7.4cqw,1.6rem)] font-extrabold tabular-nums text-ink">{brl(receitas.arrecadado)}</dd>
            </div>
            <div class={`${cartao} @container`}>
              <dt class="text-xs font-bold uppercase tracking-[0.12em] text-ink-soft">Previsto para o ano</dt>
              <dd class="mt-1 whitespace-nowrap font-editorial text-[clamp(1rem,7.4cqw,1.6rem)] font-extrabold tabular-nums text-ink">{brl(receitas.previsao)}</dd>
            </div>
            <div class={`${cartao} @container`}>
              <dt class="text-xs font-bold uppercase tracking-[0.12em] text-ink-soft">Do previsto já arrecadado</dt>
              <dd class="mt-1 whitespace-nowrap font-editorial text-[clamp(1rem,7.4cqw,1.6rem)] font-extrabold tabular-nums text-ink">{receitas.previsao ? ((receitas.arrecadado / receitas.previsao) * 100).toFixed(1).replace('.', ',') : '0'}%</dd>
            </div>
          </dl>

          <div class="mt-4 grid gap-4 lg:grid-cols-2">
            <div class={cartao}>
              <h3 class="mb-3 font-editorial text-lg font-extrabold text-ink">De onde veio o dinheiro</h3>
              <ul class="space-y-3">
                {receitas.grupos.filter((g) => g.arrecadado > 0).map((g) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3 text-sm"><span class="min-w-0 text-ink">{g.nome}</span><strong class="shrink-0 tabular-nums">{brl(g.arrecadado)}</strong></div>
                    <div class="mt-1 h-2 rounded-[2px] bg-line"><div class="h-full rounded-[2px]" style={`width:${(g.arrecadado / maxGrupo) * 100}%;background:${g.cor}`}></div></div>
                    <p class="mt-0.5 text-xs text-ink-soft">{((g.arrecadado / receitas.arrecadado) * 100).toFixed(1).replace('.', ',')}% do arrecadado</p>
                  </li>
                ))}
              </ul>
            </div>
            <div class="space-y-4">
              <div class={cartao}>
                <h3 class="mb-3 font-editorial text-lg font-extrabold text-ink">Arrecadação a cada dois meses</h3>
                <ul class="space-y-3">
                  {receitas.porBimestre.map((v, i) => (
                    <li>
                      <div class="flex items-baseline justify-between gap-3 text-sm"><span class="text-ink">{['Jan–Fev', 'Mar–Abr', 'Mai–Jun', 'Jul–Ago', 'Set–Out', 'Nov–Dez'][i]}</span><strong class="shrink-0 tabular-nums">{brl(v)}</strong></div>
                      <div class="mt-1 h-2 rounded-[2px] bg-line"><div class="h-full rounded-[2px] bg-nioaque-green" style={`width:${(v / maxBim) * 100}%`}></div></div>
                    </li>
                  ))}
                </ul>
              </div>
              {receitas.anoFontes && receitas.fontes.length > 0 && (
                <div class={cartao}>
                  <h3 class="mb-1 font-editorial text-lg font-extrabold text-ink">Principais fontes em {receitas.anoFontes}</h3>
                  <p class="mb-3 text-xs text-ink-soft">Ano fechado: {brl(receitas.totalFontes)} no total (bruto).</p>
                  <ul class="divide-y divide-pedra text-sm">
                    {receitas.fontes.slice(0, 8).map((f) => (
                      <li class="flex items-baseline justify-between gap-3 py-2"><span class="min-w-0 text-ink">{f.nome}</span><strong class="shrink-0 tabular-nums">{brl(f.valor)}</strong></li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
          <p class="mt-2 text-xs text-ink-soft">
            Fonte: SICONFI, do Tesouro Nacional (relatório bimestral e balanço anual que a própria Prefeitura envia). O relatório bimestral já desconta a parte que vai para o FUNDEB
            {receitas.deducoesFontes > 0 && <>{' '}(em {receitas.anoFontes}, {brl(receitas.deducoesFontes)})</>}; por isso a receita "bruta" do balanço anual é maior. Receita é o que entra no cofre; não se compara direto com as despesas do período, que são de datas diferentes.
          </p>
        </section>
      )}


        <ExternasView ano={ano} estado={estado} federal={federal} ibge={ibge} />
      </section>
    </>
  )}
</div>

{exportData && <script type="application/json" id="pref-export-data" set:html={JSON.stringify(exportData).replace(/</g, '\\u003c')} />}
<script>
  import '../../scripts/prefeitura-export';
</script>

<script>
  /** Exporta um trecho da página em PDF: abre uma janela de impressão (escolha "Salvar como PDF"). */
  document.querySelectorAll<HTMLButtonElement>('[data-pdf]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const alvo = document.querySelector<HTMLElement>(btn.dataset.pdf ?? '');
      if (!alvo) return;
      const titulo = alvo.dataset.titulo ?? document.title;
      const clone = alvo.cloneNode(true) as HTMLElement;
      clone.querySelectorAll('[hidden]').forEach((n) => n.removeAttribute('hidden'));
      clone.querySelectorAll('[data-pdf], form, nav, details > summary, .print\\:hidden').forEach((n) => n.remove());
      const estilos = [...document.querySelectorAll('link[rel="stylesheet"], style')].map((n) => n.outerHTML).join('');
      const w = window.open('', '_blank');
      if (!w) return;
      w.document.write(
        `<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title>${titulo}</title>${estilos}<style>@page{size:A4;margin:14mm}body{background:#fff!important;padding:0;-webkit-print-color-adjust:exact;print-color-adjust:exact}.pdf-topo{border-bottom:3px solid #166A34;margin-bottom:16px;padding-bottom:8px}.pdf-rodape{margin-top:20px;font-size:11px;color:#4A4F4A}section,li{break-inside:avoid}</style></head><body><div class="pdf-topo"><strong style="font-size:12px;letter-spacing:.12em;color:#166A34">O NIOAQUENSE</strong><h1 style="font-size:22px;font-weight:800;margin:4px 0 0">${titulo}</h1></div>${clone.outerHTML}<p class="pdf-rodape">Fonte: Portal da Transparência (Quality Sistemas), dados atualizados semanalmente. onioaquense.com/transparencia</p></body></html>`,
      );
      w.document.close();
      w.focus();
      setTimeout(() => w.print(), 700);
    });
  });
</script>

