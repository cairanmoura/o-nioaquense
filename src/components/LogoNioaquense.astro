---
/**
 * LogoNioaquense.astro
 * -----------------------------------------------------------------------------
 * Marca do portal "O Nioaquense", inspirada na bandeira do municipio de Nioaque (MS).
 *
 * Usa o lockup oficial em SVG externo (public/icons/01-logo-horizontal-bandeira.svg):
 *  - faixa superior VERDE  #008026
 *  - faixa central BRANCA #FFFFFF
 *  - faixa inferior VERMELHA #E60000
 *  - cruz latina VERMELHA na faixa central
 *  - wordmark "O NIOAQUENSE" em vermelho e preto, com "PORTAL" acima
 *
 * O componente mantém a mesma interface de antes (variant, textColor, invertBand,
 * class, title) para nao quebrar usos existentes. O SVG externo ja contem as cores
 * da marca embutidas, entao textColor e invertBand sao mantidos por compatibilidade
 * mas nao alteram o desenho externo.
 */
interface Props {
  /** Classes CSS adicionais (ex.: "h-10 w-auto" ou "w-40"). */
  class?: string;
  /** Rotulo acessivel do logo. */
  title?: string;
  /**
   * - `full`     : lockup completo (SVG externo com grafico + texto)
   * - `mark`     : apenas o simbolo (mesmo SVG externo, escalado pequeno pelo pai)
   * - `wordmark` : apenas o texto (o SVG externo ja traz o texto junto)
   */
  variant?: 'full' | 'mark' | 'wordmark';
  /** Versao da marca: '01' (horizontal, default) ou '02' (empilhada editorial). */
  version?: '01' | '02';
  /** Cor do wordmark (mantida por compatibilidade; o SVG externo ja tem cores fixas). */
  textColor?: string;
  /** Desenha a moldura da faixa central em branco puro (mantido por compatibilidade). */
  invertBand?: boolean;
}

const {
  class: className = '',
  title = 'O Nioaquense',
  variant = 'full',
  version = '01',
} = Astro.props;

const LOGO_SRC = version === '02' ? '/icons/02-logo-empilhada-editorial.svg' : '/icons/01-logo-horizontal-bandeira.svg';

const LOGO_DIM = version === '02' ? { width: 400, height: 520 } : { width: 470, height: 100 };

---
<img
  src={LOGO_SRC}
  alt={variant === 'mark' ? 'Marca O Nioaquense' : title}
  class={className}
  loading="eager"
  decoding="async"
  width={LOGO_DIM.width}
  height={LOGO_DIM.height}
  style="display:block;height:auto;width:100%;max-width:100%;"
  aria-hidden={variant === 'mark' ? 'true' : undefined}
  role={variant === 'mark' ? undefined : 'img'}
  aria-label={variant === 'mark' ? undefined : title}
/>
