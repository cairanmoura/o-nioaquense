---
/**
 * LogoNioaquense.astro
 * -----------------------------------------------------------------------------
 * Logo oficial "O NIOAQUENSE" com o cavaleiro (sistema de design, public/brand/).
 * Nunca redesenhe nem redigite a logo com uma fonte: use sempre a imagem.
 *
 * Escolha a tinta pela cor do fundo:
 *  - `branca`   : sobre verde-mata (header)
 *  - `verde`    : sobre papel e branco (padrao)
 *  - `preta`    : impressos / um so tom
 *  - `vermelha` : so usos de destaque sobre fundo claro
 */
interface Props {
  class?: string;
  title?: string;
  tone?: 'branca' | 'verde' | 'preta' | 'vermelha';
  /** Compatibilidade com usos antigos (ignorados). */
  variant?: 'full' | 'mark' | 'wordmark';
  version?: '01' | '02';
  textColor?: string;
  invertBand?: boolean;
}

const { class: className = '', title = 'O Nioaquense', tone = 'verde' } = Astro.props;
const SRC = { branca: 'logo-branca', verde: 'logo-verde', preta: 'logo-preta', vermelha: 'logo-vermelha' }[tone];
---

<img
  src={`/brand/${SRC}.svg`}
  alt={title}
  class:list={['block', className]}
  loading="eager"
  decoding="async"
  width="608"
  height="150"
/>
