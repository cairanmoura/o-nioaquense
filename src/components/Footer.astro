---
import LogoNioaquense from './LogoNioaquense.astro';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Editorias',
    links: [
      { label: 'Nioaque', href: '/materias?local=nioaque' },
      { label: 'Radar Oficial', href: '/radar-oficial' },
      { label: 'Colunistas', href: '/colunistas' },
      { label: 'Mato Grosso do Sul', href: '/materias?local=ms' },
      { label: 'Brasil', href: '/materias?local=brasil' },
      { label: 'Todas as matérias', href: '/materias' },
    ],
  },
  {
    title: 'Servicos',
    links: [
      { label: 'Guia de utilidade', href: '/utilidade' },
      { label: 'Transparência da Câmara', href: '/transparencia' },
      { label: 'Sessões da Câmara', href: '/camara/sessoes' },
      { label: 'Autoridades publicas', href: '/autoridades' },
      { label: 'Destaque do comercio', href: '/#comercio' },
      { label: 'Anuncie no portal', href: '/anuncie' },
    ],
  },
  {
    title: 'O Nioaquense',
    links: [
      { label: 'Sobre o portal', href: '/expediente' },
      { label: 'Politica editorial', href: '/politica-editorial' },
      { label: 'Mande sua noticia', href: '/mande-sua-noticia' },
      { label: 'Boca no Trombone', href: '/mande-sua-noticia' },
      { label: 'Privacidade', href: '/privacidade' },
      { label: 'Termos de uso', href: '/termos' },
    ],
  },
];
---

<footer class="mt-0 bg-branco">
  <div class="filete-duplo" aria-hidden="true"><i></i><i></i></div>
  <div class="container-editorial py-12">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_repeat(3,minmax(0,auto))]">
      <div id="sobre" class="max-w-sm scroll-mt-32">
        <LogoNioaquense tone="verde" class="h-14 w-auto" />
        <p class="mt-5 text-sm leading-relaxed text-ink-soft">
          Jornalismo hiperlocal de Nioaque (MS). Publicamos o que acontece na cidade, no Sul de Mato
          Grosso do Sul e no Brasil, com transparencia sobre como cada noticia foi apurada.
        </p>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="text-xs font-semibold text-nioaque-green">
              {column.title}
            </h2>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="link-underline text-sm text-ink-soft transition-colors hover:text-nioaque-red-dark"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-col gap-3 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} O Nioaquense. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
