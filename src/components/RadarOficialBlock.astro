---
import { formatDate } from '../lib/format';
import type { Article } from '../lib/types';

/**
 * RadarOficialBlock.astro
 * -----------------------------------------------------------------------------
 * Bloco "Radar Oficial": Prefeitura, Camara, Concursos e Diario Oficial
 * explicados em linguagem simples.
 *
 * As materias sao agrupadas pela `category_label` e cada grupo recebe um
 * subtitulo que explica, em uma linha, o que aquela secao significa.
 */

interface Props {
  articles: Article[];
  class?: string;
}

const { articles, class: className = '' } = Astro.props;

const GROUPS = [
  {
    key: 'Prefeitura',
    hint: 'O que o Executivo esta fazendo na cidade',
    accent: 'text-nioaque-green',
    icon: 'M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6',
  },
  {
    key: 'Câmara',
    hint: 'Decisoes e projetos da Casa',
    accent: 'text-nioaque-red-dark',
    icon: 'M3 9h18M5 9v11M9 9v11M15 9v11M19 9v11M2 20h20M12 3l9 5H3Z',
  },
  {
    key: 'Concursos',
    hint: 'Vagas, seletivas e nomeacoes',
    accent: 'text-nioaque-green',
    icon: 'M4 5h16v14H4zM8 9h8M8 13h5',
  },
  {
    key: 'Diário Oficial',
    hint: 'Publicacoes e avisos do dia',
    accent: 'text-nioaque-red-dark',
    icon: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h6M9 17h6',
  },
];

const byCategory = new Map<string, Article[]>();
for (const article of articles) {
  const key = article.category_label ?? 'Prefeitura';
  const list = byCategory.get(key) ?? [];
  list.push(article);
  byCategory.set(key, list);
}
---

<section
  class:list={['relative overflow-hidden rounded-[4px] border border-pedra bg-branco', className]}
  aria-labelledby="radar-oficial"
>
  <img
    src="/brand/cavaleiro-verde.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-4 top-3 h-[120px] w-auto opacity-[0.09]"
  />
  <header class="relative flex flex-wrap items-center justify-between gap-3 px-5 py-5 sm:px-7">
    <div class="flex items-start gap-3">
      <svg class="mt-1 h-9 w-9 shrink-0" viewBox="0 0 36 36" fill="none" stroke="#0D4722" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
        <path d="M4 14 18 5l14 9H4ZM7 14v13M13 14v13M18 14v13M23 14v13M29 14v13M4 30h28" />
      </svg>
      <div>
        <h2 id="radar-oficial" class="font-serif text-2xl font-bold sm:text-[30px] sm:leading-[34px]">
          Radar Oficial
        </h2>
        <p class="mt-1.5 max-w-xl text-base text-ink-soft">
          O que a Prefeitura, a Câmara, os concursos e o Diário Oficial resolveram,
          traduzido para o cidadão.
        </p>
      </div>
    </div>
    <a
      href="/radar-oficial"
      class="inline-flex min-h-11 items-center rounded-[4px] border border-pedra px-4 text-sm font-semibold text-ink transition-colors hover:border-nioaque-green hover:text-nioaque-green"
    >
      Ver tudo
    </a>
  </header>

  <div class="relative grid gap-x-6 gap-y-8 px-5 pb-7 sm:grid-cols-2 sm:px-7 xl:grid-cols-4">
    {
      GROUPS.map((group, i) => {
        const items = (byCategory.get(group.key) ?? []).slice(0, 2);

        return (
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-pedra-escura px-3 py-1.5 text-[11px] font-semibold uppercase leading-none tracking-[0.08em] text-ink">
              <span class:list={['h-1.5 w-1.5 rounded-full', i % 2 === 0 ? 'bg-nioaque-green' : 'bg-nioaque-red']} aria-hidden="true" />
              {group.key}
            </span>
            <p class="mt-2 text-xs leading-snug text-ink-muted">{group.hint}</p>

            {items.length > 0 ? (
              <ul class="mt-3">
                {items.map((item) => (
                  <li class="border-t border-pedra py-3">
                    <a href={`/noticia/${item.slug}`} class="group flex flex-col gap-1">
                      <span class="font-serif text-base font-extrabold leading-snug text-ink group-hover:text-nioaque-green">
                        {item.title}
                      </span>
                      <span class="text-xs tabular-nums text-ink-muted">{formatDate(item.published_at)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 text-xs text-ink-muted">Nada publicado por enquanto.</p>
            )}
          </div>
        );
      })
    }
  </div>
</section>
