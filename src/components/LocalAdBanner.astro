---
import { AD_MIN_HEIGHT, adContactPath } from '../lib/ads';
import type { LocalAd } from '../lib/types';

/**
 * LocalAdBanner.astro
 * -----------------------------------------------------------------------------
 * Banner horizontal de anunciante local (negocios de Nioaque).
 *
 * Regra do projeto (AGENTS.md #1): **zero CLS** - a altura minima do slot e'
 * reservada mesmo quando nao ha anuncio.
 *
 * Todos os cliques (imagem, titulo e botao) passam pela rota
 * `/api/ads/click/[id]`, que contabiliza o clique antes de redirecionar.
 */

interface Props {
  ad?: LocalAd | null;
  class?: string;
  label?: string;
}

const { ad, class: className = '', label = 'Publicidade local' } = Astro.props;
const reservedHeight = AD_MIN_HEIGHT[ad?.slot_position ?? 'home_middle'];
---

<div
  class:list={[
    'relative overflow-hidden rounded-2xl border border-line bg-nioaque-white',
    className,
  ]}
  style={`min-height:${reservedHeight}`}
>
  <span
    class="pointer-events-none absolute left-3 top-3 z-10 rounded-full bg-ink/60 px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.14em] text-white"
  >
    {label}
  </span>

  {
    ad ? (
      <div class="flex h-full min-h-[inherit] flex-col sm:flex-row">
        {ad.image_url && (
          <a
            href={adContactPath(ad)}
            class="relative block shrink-0 overflow-hidden bg-nioaque-green-50 sm:w-44"
            aria-label={ad.title}
          >
            <img
              src={ad.image_url}
              alt=""
              width="480"
              height="420"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </a>
        )}

        <div class="flex min-w-0 flex-1 flex-col justify-center gap-3 p-5 sm:flex-row sm:items-center">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-nioaque-green">
                {ad.client_name}
              </p>
              {ad.price_label && (
                <span class="rounded-full bg-nioaque-red-50 px-2.5 py-0.5 font-editorial text-sm font-semibold text-nioaque-red-dark">
                  {ad.price_label}
                </span>
              )}
            </div>
            <p class="mt-1 font-editorial text-lg font-semibold leading-snug text-ink">
              {ad.title}
            </p>
          </div>

          <a
            href={adContactPath(ad)}
            class="inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-full bg-[#25D366] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.1em] text-white transition-opacity hover:opacity-90 sm:self-auto"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.83 9.83 0 0 0 4.68 1.2h.01c5.43 0 9.84-4.4 9.84-9.84C21.89 6.4 17.48 2 12.04 2Zm5.76 14.02c-.24.68-1.4 1.3-1.94 1.36-.54.06-1.04.08-1.68-.12-.4-.12-.9-.3-1.56-.58-2.74-1.18-4.52-3.94-4.66-4.12-.14-.18-1.12-1.5-1.12-2.86 0-1.36.7-2.02.96-2.3.26-.28.56-.34.74-.34.18 0 .38 0 .54.02.18.02.42-.06.66.5.24.56.82 1.94.9 2.08.06.14.1.3.02.48-.08.18-.12.3-.24.46-.12.16-.26.36-.36.48-.12.12-.26.26-.1.5.14.24.64 1.06 1.38 1.72.94.84 1.74 1.1 1.98 1.22.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.6-.18 1.2Z" />
            </svg>
            Chamar no WhatsApp
          </a>
        </div>
      </div>
    ) : (
      /* Placeholder: mesma altura reservada, sem "pulo" de layout. */
      <div class="flex h-full min-h-[inherit] items-center justify-center p-6 text-center">
        <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-ink-muted/60">
          Espaco publicitario reservado
        </p>
      </div>
    )
  }
</div>
