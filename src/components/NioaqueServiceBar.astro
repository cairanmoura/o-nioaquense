---
import { getHomeFeed } from '../lib/content';
import { getNioaqueWeather } from '../lib/weather';
import type { WeatherIcon } from '../lib/weather';
import { ALERT_STYLE } from '../lib/types';

/**
 * NioaqueServiceBar.astro
 * -----------------------------------------------------------------------------
 * Barra fixa de utilidade publica, imediatamente abaixo do cabecalho.
 *
 *   - Alerta da cidade (vermelho / amarelo) no topo, quando ativo
 *   - Clima em tempo real de Nioaque (Open-Meteo, cache na borda) — minimizado
 *     no canto esquerdo (icone + temperatura apenas).
 *
 *   A farmacia de plantao foi retirada desta barra.
 */

const feed = await getHomeFeed(Astro.locals);
const utility = feed.utility;
const weather = await getNioaqueWeather(Astro.locals);

const alertStyle = utility?.alert_active ? ALERT_STYLE[utility.alert_level] : null;

const WEATHER_ICONS: Record<WeatherIcon, string> = {
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.5 6.5 4.9 4.9M19.1 19.1l-1.6-1.6M17.5 6.5l1.6-1.6M4.9 19.1l1.6-1.6"/>',
  cloud: '<path d="M7 18a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 18Z"/>',
  rain: '<path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z"/><path d="M9 18v2M13 18v2M17 18v2"/>',
  storm: '<path d="M7 14a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 14Z"/><path d="m13 13-3 5h4l-2 4"/>',
  fog: '<path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z"/><path d="M4 18h16M6 21h12"/>',
  snow: '<path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z"/><path d="M9 19h.01M13 21h.01M17 19h.01"/>',
};
---

<div class="sticky top-0 z-40">
  {/* Alerta da cidade */}
  {
    utility?.alert_active && utility.alert_message && alertStyle && (
      <div class:list={['text-white', alertStyle.className]}>
        <div class="container-editorial">
          <div class="flex items-center gap-2.5 overflow-x-auto py-2 whitespace-nowrap">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              class="shrink-0"
            >
              <path
                d="M12 9v4m0 4h.01M10.3 3.9 2.4 17.5A2 2 0 0 0 4.1 20.5h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="shrink-0 text-xs font-bold">
              {alertStyle.label}
            </span>
            <span class="truncate text-xs font-medium">{utility.alert_message}</span>
          </div>
        </div>
      </div>
    )
  }

  {/* Barra de utilidade: so o clima, minimizado no canto esquerdo */}
  <div class="border-b border-line bg-nioaque-white">
    <div class="container-editorial w-full box-border">
      <div class="flex items-center justify-between gap-2 py-1 text-xs md:py-0">
        {/* Clima minimizado (canto esquerdo) */}
        <a
          href="/clima"
          class="flex min-w-0 items-center gap-1 transition-colors hover:bg-nioaque-green-50"
        >
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-[4px] bg-nioaque-green-50 text-nioaque-green">
            <svg
              width="11"
              height="11"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0"
              set:html={WEATHER_ICONS[weather.icon]}
            />
          </span>
          <span class="truncate text-[10px] font-semibold text-ink">
            {weather.temperature}°C
          </span>
        </a>

        {/* Identificacao local (desktop) */}
        <span class="hidden shrink-0 items-center pl-4 text-xs font-medium text-ink-muted md:flex">
          Nioaque · MS
        </span>
      </div>
    </div>
  </div>
</div>
