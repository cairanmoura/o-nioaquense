---
import { getHomeFeed } from '../lib/content';
import { getNioaqueWeather } from '../lib/weather';
import type { WeatherIcon } from '../lib/weather';
import { ALERT_STYLE } from '../lib/types';

/**
 * NioaqueServiceBar.astro
 * -----------------------------------------------------------------------------
 * Barra fixa de utilidade publica, imediatamente abaixo do cabecalho.
 *
 * No celular os itens deslizam na horizontal; no desktop ficam lado a lado.
 *
 *   - Alerta da cidade (vermelho / amarelo) no topo, quando ativo
 *   - Farmacia de plantao do dia (ligar / WhatsApp)
 *   - Clima em tempo real de Nioaque (Open-Meteo, cache na borda)
 *   - Alertas da cidade
 */

const feed = await getHomeFeed(Astro.locals);
const utility = feed.utility;
const weather = await getNioaqueWeather(Astro.locals);

const alertStyle = utility?.alert_active ? ALERT_STYLE[utility.alert_level] : null;

const pharmacyDigits = (utility?.pharmacy_phone ?? '').replace(/\D/g, '');
const pharmacyTel = pharmacyDigits ? `tel:${pharmacyDigits}` : '#';
const pharmacyWhatsapp = pharmacyDigits ? `https://wa.me/${pharmacyDigits}` : '#';

const WEATHER_ICONS: Record<WeatherIcon, string> = {
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.5 6.5 4.9 4.9M19.1 19.1l-1.6-1.6M17.5 6.5l1.6-1.6M4.9 19.1l1.6-1.6"/>',
  cloud: '<path d="M7 18a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 18Z"/>',
  rain: '<path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z"/><path d="M9 18v2M13 18v2M17 18v2"/>',
  storm: '<path d="M7 14a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 14Z"/><path d="m13 13-3 5h4l-2 4"/>',
  fog: '<path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z"/><path d="M4 18h16M6 21h12"/>',
  snow: '<path d="M7 15a4.5 4.5 0 0 1 .5-9 6 6 0 0 1 11.2 1.6A3.7 3.7 0 0 1 18 15Z"/><path d="M9 19h.01M13 21h.01M17 19h.01"/>',
};
---

<div class="sticky top-0 z-40">
  {/* Alerta da cidade */}
  {
    utility?.alert_active && utility.alert_message && alertStyle && (
      <div class:list={['text-white', alertStyle.className]}>
        <div class="container-editorial">
          <div class="flex items-center gap-2.5 overflow-x-auto py-2 whitespace-nowrap">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              class="shrink-0"
            >
              <path
                d="M12 9v4m0 4h.01M10.3 3.9 2.4 17.5A2 2 0 0 0 4.1 20.5h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="shrink-0 text-xs font-bold">
              {alertStyle.label}
            </span>
            <span class="truncate text-xs font-medium">{utility.alert_message}</span>
          </div>
        </div>
      </div>
    )
  }

  {/* Itens de servico */}
  <div class="bg-nioaque-white">
    <div class="container-editorial">
      <div class="grid grid-cols-2 gap-x-4 py-1.5 md:flex md:items-stretch md:gap-0 md:py-0">
        {/* Farmacia de plantao */}
        <div class="col-span-2 flex items-center gap-2.5 py-1.5 md:shrink-0 md:py-2.5 md:pr-6">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-nioaque-red-50 text-nioaque-red">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="7" width="18" height="13" rx="2" />
              <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M12 12v3M10.5 13.5h3" stroke-linecap="round" />
            </svg>
          </span>

          <div class="min-w-0 leading-tight">
            <p class="text-xs font-semibold text-ink-muted">Farmácia de plantão</p>
            <p class="truncate text-sm font-semibold text-ink">
              {utility?.pharmacy_name ?? 'Consulte a farmácia'}
            </p>
          </div>

          <div class="ml-auto flex shrink-0 items-center gap-1.5 md:ml-2">
            <a
              href={pharmacyTel}
              aria-label={`Ligar para ${utility?.pharmacy_name ?? 'farmácia de plantão'}`}
              class="flex h-9 w-9 items-center justify-center rounded-full bg-nioaque-green text-white transition-colors hover:bg-nioaque-green-dark"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path
                  d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
            <a
              href={pharmacyWhatsapp}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Chamar ${utility?.pharmacy_name ?? 'farmácia de plantão'} no WhatsApp`}
              class="flex h-9 w-9 items-center justify-center rounded-full bg-[#075E54] text-white transition-colors hover:bg-[#054d45]"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.74.46 3.44 1.32 4.94L2 22l5.36-1.4a9.83 9.83 0 0 0 4.68 1.2h.01c5.43 0 9.84-4.4 9.84-9.84C21.89 6.4 17.48 2 12.04 2Zm5.76 14.02c-.24.68-1.4 1.3-1.94 1.36-.54.06-1.04.08-1.68-.12-.4-.12-.9-.3-1.56-.58-2.74-1.18-4.52-3.94-4.66-4.12-.14-.18-1.12-1.5-1.12-2.86 0-1.36.7-2.02.96-2.3.26-.28.56-.34.74-.34.18 0 .38 0 .54.02.18.02.42-.06.66.5.24.56.82 1.94.9 2.08.06.14.1.3.02.48-.08.18-.12.3-.24.46-.12.16-.26.36-.36.48-.12.12-.26.26-.1.5.14.24.64 1.06 1.38 1.72.94.84 1.74 1.1 1.98 1.22.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.6-.18 1.2Z" />
              </svg>
            </a>
          </div>
        </div>

        {/* Clima */}
        <a
          href="/#clima"
          class="flex min-w-0 items-center gap-2.5 py-1.5 transition-colors hover:text-nioaque-green md:shrink-0 md:py-2.5 md:pr-6"
        >
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-nioaque-green-50 text-nioaque-green">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={WEATHER_ICONS[weather.icon]}
            />
          </span>
          <div class="min-w-0 leading-tight">
            <p class="text-xs font-semibold text-ink-muted">Clima agora</p>
            <p class="truncate text-sm font-semibold text-ink">
              {weather.temperature}°C<span class="hidden lg:inline"> · {weather.label}</span>
            </p>
          </div>
        </a>


        {/* Data (desktop) */}
        <span class="ml-auto hidden shrink-0 items-center pl-4 text-xs font-medium text-ink-muted lg:flex">
          Nioaque · MS
        </span>
      </div>
    </div>
  </div>
</div>
