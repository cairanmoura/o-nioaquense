---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LocalAdBanner from '../components/LocalAdBanner.astro';
import { getHeaderBillboard } from '../lib/content';

/**
 * MainLayout.astro
 * -----------------------------------------------------------------------------
 * Layout principal do portal:
 *
 *   [ Header ]             logo + busca + "Mande sua Notícia" + editorias
 *   [ Billboard ]          anúncio do comércio no topo do portal
 *   [ NioaqueServiceBar ]  alerta da cidade + identificação local
 *   [ <slot /> ]           conteúdo da página
 *   [ Footer ]
 */

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Bloqueia a indexação (páginas internas, ex.: /admin). */
  noindex?: boolean;
  /** Tipo Open Graph (`article` nas matérias). */
  ogType?: 'website' | 'article';
  /** Remove a barra de serviços (ex.: páginas de campanha). */
  hideServiceBar?: boolean;
}

const {
  title = 'O Nioaquense',
  description = 'Portal de noticias hiperlocal de Nioaque (MS). O que acontece na cidade, no Sul de Mato Grosso do Sul e no Brasil.',
  image,
  noindex = false,
  hideServiceBar = false,
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const origin = new URL(Astro.site ?? Astro.url.origin).origin;
const ogImage = image ?? `${origin}/icons/icon-512.png`;
const isHome = Astro.url.pathname === '/';

// Identidade do portal para o Google (Organization + WebSite com busca interna): so na Home
const siteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsMediaOrganization',
      '@id': `${origin}/#organization`,
      name: 'O Nioaquense',
      url: origin,
      logo: { '@type': 'ImageObject', url: `${origin}/icons/icon-512.png`, width: 512, height: 512 },
      description: 'Portal de notícias hiperlocal de Nioaque (MS), com cobertura de Mato Grosso do Sul e do Brasil.',
      areaServed: { '@type': 'AdministrativeArea', name: 'Nioaque, Mato Grosso do Sul, Brasil' },
      email: 'contato@onioaquense.com',
      telephone: '+55-67-99820-4667',
      founder: { '@type': 'Person', name: 'Cairan de Oliveira Moura', jobTitle: 'Jornalista responsável' },
      publishingPrinciples: `${origin}/politica-editorial`,
      ethicsPolicy: `${origin}/politica-editorial`,
      masthead: `${origin}/expediente`,
      sameAs: ['https://instagram.com/onioaquense'],
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      url: origin,
      name: 'O Nioaquense',
      inLanguage: 'pt-BR',
      publisher: { '@id': `${origin}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${origin}/busca?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
});

/**
 * Anuncio do topo do portal (slot "Topo do portal" do painel).
 *
 * So e' renderizado quando existe anuncio no ar: sem anunciante nao sobra
 * caixa vazia. Quando existe, o `LocalAdBanner` ja reserva a altura
 * (zero CLS).
 */
const billboard = await getHeaderBillboard(Astro.locals);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title === 'O Nioaquense' ? title : `${title} | O Nioaquense`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="O Nioaquense" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {isHome && <script type="application/ld+json" set:html={siteJsonLd} />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#0D4722" />
    <meta name="color-scheme" content="light dark" />

    {/* PWA: instalacao como aplicativo no celular */}
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="O Nioaquense" />

    {/* Tema (claro/escuro): aplica a escolha salva ou a preferencia do sistema antes da pintura */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('tema');
          if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://ejlnffliojbtgpfeestj.supabase.co" />

    {/* Consentimento: se o leitor recusou, o AdSense serve anuncios nao personalizados */}
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('cookies') === 'essenciais') {
            window.adsbygoogle = window.adsbygoogle || [];
            window.adsbygoogle.requestNonPersonalizedAds = 1;
          }
        } catch (e) {}
      })();
    </script>
    {/* Google AdSense (conta do portal): codigo em todas as paginas publicas */}
    <meta name="google-adsense-account" content="ca-pub-1935033245502339" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1935033245502339" crossorigin="anonymous"></script>

    {/* Slot para meta tags e JSON-LD especificos da pagina */}
    <slot name="head" />
  </head>

  <body class="min-h-screen w-full max-w-[100vw] overflow-x-clip bg-editorial text-ink antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-[4px] focus:bg-nioaque-green focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Pular para o conteúdo
    </a>

    <Header />

    {
      billboard && (
        <div class="container-editorial w-full box-border pt-3">
          <LocalAdBanner ad={billboard} label="Publicidade local" />
        </div>
      )
    }

    <main id="conteudo" class="w-full max-w-full box-border overflow-x-clip">
      <slot />
    </main>

    <Footer />

    {/* Aviso de cookies (LGPD): fixo no rodape da tela, nao empurra o conteudo (zero CLS) */}
    <div
      id="aviso-cookies"
      hidden
      role="region"
      aria-label="Aviso de cookies"
      class="fixed inset-x-0 bottom-0 z-[70] border-t border-pedra bg-branco p-4 text-ink"
    >
      <div class="mx-auto flex max-w-4xl flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
        <p class="flex-1 text-sm leading-relaxed text-ink-soft">
          Usamos cookies para o portal funcionar e para exibir anúncios do Google. Você pode aceitar os anúncios
          personalizados ou ficar só com os essenciais.
          <a href="/privacidade#publicidade" class="font-semibold text-nioaque-green underline">Saiba mais</a>.
        </p>
        <div class="flex shrink-0 gap-2">
          <button type="button" data-cookies="essenciais" class="min-h-11 flex-1 rounded-[4px] border border-pedra px-4 text-sm font-semibold text-ink hover:border-nioaque-green sm:flex-none">Só os essenciais</button>
          <button type="button" data-cookies="todos" class="min-h-11 flex-1 rounded-[4px] bg-nioaque-green px-4 text-sm font-semibold text-white hover:bg-verde-mata sm:flex-none">Aceitar</button>
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  // Aviso de cookies: guarda a escolha; "essenciais" = anuncios nao personalizados.
  const aviso = document.getElementById('aviso-cookies');
  try {
    if (aviso && !localStorage.getItem('cookies')) aviso.hidden = false;
  } catch {
    /* sem armazenamento: nao mostra o aviso */
  }
  aviso?.querySelectorAll<HTMLButtonElement>('[data-cookies]').forEach((b) =>
    b.addEventListener('click', () => {
      try { localStorage.setItem('cookies', b.dataset.cookies!); } catch {}
      aviso.hidden = true;
    }),
  );

  // Service worker (PWA) — registra depois que a página carrega.
  if ('serviceWorker' in navigator && window.isSecureContext) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch(() => {
        /* sem service worker: o portal continua funcionando */
      });
    });
  }
</script>
