# =============================================================================
#  O Nioaquense - variaveis de ambiente
# -----------------------------------------------------------------------------
#  Copie este arquivo para `.env` (dev) ou `.dev.vars` (Cloudflare Workers local).
#
#  No deploy, use `npx wrangler secret put <NOME>` para as chaves secretas
#  e `wrangler.toml` -> [vars] para as variaveis publicas.
# =============================================================================

# -----------------------------------------------------------------------------
#  Site
# -----------------------------------------------------------------------------
# URL publica do portal (canonical, sitemaps e Open Graph)
PUBLIC_SITE_URL="https://onioaquense.com"

# -----------------------------------------------------------------------------
#  Supabase (backend, auth e banco)
# -----------------------------------------------------------------------------
# URL publica do projeto Supabase (ex.: https://abcdefghijklm.supabase.co)
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"

# Chave anon / publishable (somente publicavel no client-side)
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...."

# Chave service_role - SOMENTE uso no servidor / Workers. NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...."

# -----------------------------------------------------------------------------
#  Google AdSense (monetizacao)
# -----------------------------------------------------------------------------
# ID do cliente (ca-pub-XXXXXXXXXXXXXXXX)
PUBLIC_GOOGLE_ADSENSE_CLIENT=""

# Slot padrao usado quando o <GoogleAdSlot /> nao recebe um slot especifico
PUBLIC_ADSENSE_SLOT_DEFAULT=""

# -----------------------------------------------------------------------------
#  Canal do leitor
# -----------------------------------------------------------------------------
# WhatsApp da redação (botão "Chamar a redação" no /mande-sua-noticia)
PUBLIC_REDACAO_WHATSAPP="5567999990000"

# -----------------------------------------------------------------------------
#  Bindings do Cloudflare (opcionais)
# -----------------------------------------------------------------------------
# Nome do bucket R2 para as imagens convertidas em WebP
# R2_BUCKET="o-nioaquense-capas"

# Nome do binding KV de sessao (Astro sessions)
# KV_NAMESPACE="SESSION"

# -----------------------------------------------------------------------------
#  Cache da borda
# -----------------------------------------------------------------------------
# Segundos que o edge/CDN guarda a resposta antes de revalidar.
# Definidos em src/lib/cache.ts (CACHE_POLICIES) - altere la, nao aqui.
# CACHE_HOME_SMAXAGE=60
# CACHE_ARTICLE_SMAXAGE=300
