  "libraries": [],
  "components": [
    {
      "name": "BocaNoTrombone",
      "group": "Seções especiais",
      "summary": "Card de denúncias do leitor (Elemento C1, \"Megafone\"): fundo verde-mata, botão vermelho e marca d'água de megafone em gravura."
    },
    {
      "name": "Cabecalho",
      "group": "Estrutura",
      "summary": "Header verde-mata do portal, com a barra de leitura no topo extremo, em duas versões: desktop e mobile."
    },
    {
      "name": "CardNoticia",
      "group": "Conteúdo",
      "summary": "Manchete principal e cards de notícia da Home, em três formas: manchete, card vertical e card compacto com miniatura à direita."
    },
    {
      "name": "CotacaoAgro",
      "group": "Seções especiais",
      "summary": "Faixa de largura total com as cotações do campo (Elemento D1, \"Filete cheio\"), em fundo verde muito escuro."
    },
    {
      "name": "Editorias",
      "group": "Navegação",
      "summary": "Pílulas de editoria seguidas do filete A1 \"Degraus\", logo abaixo do header verde-mata."
    },
    {
      "name": "Logo",
      "group": "Marca",
      "summary": "A marca \"O NIOAQUENSE\" com o cavaleiro, em quatro tintas, sempre como imagem."
    },
    {
      "name": "Loterias",
      "group": "Conteúdo",
      "summary": "Widget lateral com os últimos sorteios (Mega-Sena, Quina, Lotofácil), com barra verde e dezenas em chips."
    },
    {
      "name": "Plantao",
      "group": "Conteúdo",
      "summary": "Bloco lateral de notícias de última hora, com barra verde e itens com chapéu de horário e miniatura."
    },
    {
      "name": "RadarOficial",
      "group": "Seções especiais",
      "summary": "Card do Radar Oficial (Elemento B2, \"Colunata\"): o que a Prefeitura publica no Diário Oficial, com ícone de colunata, tags em cápsula e o cavaleiro como marca…"
    },
    {
      "name": "SeloApuracao",
      "group": "Marca",
      "summary": "Selo circular \"Apurado pela redação\", com o cavaleiro verde, que marca conteúdo conferido pela equipe do portal."
    }
  ],
